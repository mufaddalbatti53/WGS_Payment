{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/mongodb/**,node_modules/mongoose/**,node_modules/bson/**,views/**,public/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 2 * * *"
    }
  ]
}
