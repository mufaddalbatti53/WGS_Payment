<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Payment Manager</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2c3e50">
    <style>
        :root {
            --primary: #27ae60;
            --primary-dark: #219653;
            --primary-light: #eafff0;
            --secondary: #3498db;
            --secondary-dark: #2980b9;
            --bg-color: #f4f6f9;
            --sidebar-bg: #1e293b;
            --text-dark: #2c3e50;
            --text-muted: #64748b;
            --card-bg: #ffffff;
            --shadow-soft: 0 10px 30px rgba(44, 62, 80, 0.06);
            --shadow-hover: 0 20px 40px rgba(44, 62, 80, 0.12);
            --shadow-btn: 0 6px 15px rgba(39, 174, 96, 0.25);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-color);
            color: var(--text-dark);
            margin: 0;
            overflow-x: hidden;
        }

        /* --- DESKTOP SIDEBAR LAYOUT --- */
        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar-bg);
            color: white;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            z-index: 100;
            box-shadow: 4px 0 15px rgba(0, 0, 0, 0.1);
        }

        .sidebar-header {
            padding: 25px 20px;
            background: rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-logo {
            font-size: 20px;
            font-weight: 800;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-user {
            margin-top: 15px;
            font-size: 13px;
            color: #94a3b8;
        }

        .sidebar-nav {
            padding: 20px 15px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 18px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }

        .main-content {
            flex: 1;
            margin-left: 260px;
            padding: 30px;
            padding-bottom: 80px;
            max-width: 100%;
        }

        /* Hide Desktop Elements on Mobile */
        @media (max-width: 850px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
                padding: 15px;
            }

            .desktop-only {
                display: none !important;
            }
        }

        @media (min-width: 851px) {
            .mobile-only {
                display: none !important;
            }

            /* On desktop, hide home launcher completely */
            .home-launcher {
                display: none !important;
            }

            .back-to-launcher {
                display: none !important;
            }

            .section-view {
                display: none;
            }

            .section-view.active {
                display: block;
            }
        }

        /* --- SHARED UI COMPONENTS --- */
        .floating-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 25px;
            box-shadow: var(--shadow-soft);
            margin-bottom: 25px;
            border: 1px solid rgba(44, 62, 80, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: var(--shadow-btn);
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4);
        }

        .btn-secondary {
            background: #f0f7ff;
            color: var(--secondary-dark);
            border: 1px solid #bae6fd;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-block;
        }

        .btn-secondary:hover {
            background: #e0f2fe;
        }

        /* --- DASHBOARD STATS & AGING --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
            text-align: center;
            border: 1px solid rgba(44, 62, 80, 0.05);
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--secondary), var(--primary));
        }

        .stat-card.alert::before {
            background: #ef4444;
        }

        .stat-card.warning::before {
            background: var(--secondary-dark);
        }

        .stat-title {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .aging-row {
            margin-bottom: 16px;
        }

        .aging-labels {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .progress-bg {
            background: #f1f5f9;
            height: 10px;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            background: linear-gradient(90deg, #2ecc71, var(--primary));
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease;
        }

        .fill-warning {
            background: linear-gradient(90deg, #f39c12, #d68910);
        }

        .fill-danger {
            background: linear-gradient(90deg, #ef4444, #c0392b);
        }

        .aging-clickable {
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.2s ease;
            padding: 6px 8px;
            margin: 0 -8px;
        }

        .aging-clickable:hover {
            background: #f0f7ff;
            transform: translateX(3px);
        }

        .aging-clickable.active-bucket {
            background: #dbeafe;
            border-left: 3px solid #3b82f6;
            padding-left: 12px;
        }

        .bucket-count {
            display: inline-block;
            background: #e0f2fe;
            color: #0369a1;
            font-size: 11px;
            font-weight: 700;
            border-radius: 20px;
            padding: 2px 8px;
            margin-left: 6px;
        }

        /* --- TABLE STYLES --- */
        .table-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            width: 100%;
            margin-bottom: 20px;
        }

        .search-micro {
            padding: 10px 20px;
            font-size: 15px;
            border: 1px solid #cbd5e1;
            border-radius: 25px;
            outline: none;
            flex: 1;
            min-width: 200px;
        }

        .search-micro:focus {
            border-color: var(--secondary);
            box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.15);
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 14px;
        }

        th {
            background: #f8fafc;
            padding: 15px 10px;
            text-align: left;
            text-transform: uppercase;
            font-size: 12px;
            font-weight: bold;
        }

        th:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        th:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        td {
            padding: 15px 10px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr.customer-row.d-none {
            display: none !important;
        }

        /* --- MODALS & EXTRAS --- */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: white;
            margin: 10vh auto;
            padding: 30px;
            border-radius: 24px;
            width: 90%;
            max-width: 450px;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .close {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 28px;
            cursor: pointer;
            color: #94a3b8;
        }

        .input-style {
            padding: 12px 15px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            width: 100%;
            margin-bottom: 15px;
            background: #f8fafc;
            outline: none;
        }

        .input-style:focus {
            border-color: var(--secondary);
            background: white;
        }

        .trans-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            display: block;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .bulk-action-bar {
            position: fixed;
            bottom: -100px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--text-dark);
            color: white;
            padding: 15px 25px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 15px;
            z-index: 1000;
            transition: bottom 0.4s;
        }

        .bulk-action-bar.visible {
            bottom: 30px;
        }

        .checkbox-custom {
            width: 20px;
            height: 20px;
            accent-color: var(--primary);
            cursor: pointer;
        }

        /* --- MOBILE SPECIFIC STYLES --- */
        @media screen and (max-width: 850px) {
            .section-view {
                display: none;
            }

            /* Hide sections by default on mobile */

            .home-header-card {
                background: linear-gradient(135deg, #2c3e50, #3498db);
                border-radius: 24px;
                padding: 25px;
                margin-bottom: 25px;
                color: white;
                display: flex;
                align-items: center;
                gap: 20px;
            }

            .home-avatar {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                font-weight: 800;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

            .launcher-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
                margin-bottom: 25px;
            }

            .launcher-tile {
                background: var(--card-bg);
                border-radius: 20px;
                padding: 20px;
                display: flex;
                flex-direction: column;
                gap: 12px;
                text-decoration: none;
                color: var(--text-dark);
                border: 1px solid rgba(44, 62, 80, 0.07);
                box-shadow: var(--shadow-soft);
                cursor: pointer;
            }

            .launcher-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
            }

            .back-to-launcher {
                display: none;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                padding: 10px 16px;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                margin-bottom: 20px;
                color: var(--secondary-dark);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
                width: 100%;
                text-align: left;
            }

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block !important;
                width: 100% !important;
            }

            thead {
                display: none !important;
            }

            tr.customer-row {
                background: #ffffff !important;
                border-radius: 20px !important;
                margin-bottom: 20px !important;
                padding: 20px !important;
                border: 1px solid rgba(44, 62, 80, 0.1) !important;
                box-shadow: 0 12px 35px rgba(44, 62, 80, 0.08) !important;
            }

            td {
                border: none !important;
                padding: 0 !important;
            }

            .m-top {
                display: flex;
                justify-content: space-between;
                border-bottom: 1px solid #f1f5f9;
                padding-bottom: 15px;
                margin-bottom: 15px;
            }

            .m-name {
                width: 60%;
            }

            .m-name strong {
                font-size: 18px;
            }

            .m-fin {
                width: 40%;
                text-align: right;
            }

            .m-fin-due {
                color: #b91c1c;
                font-weight: 900;
                font-size: 16px;
            }

            .m-tools {
                display: flex;
                gap: 10px;
            }

            .m-tool-btn {
                flex: 1;
                padding: 10px;
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                text-align: center;
            }

            .m-circles {
                display: flex;
                justify-content: flex-end;
                gap: 15px;
                margin-bottom: 15px;
            }

            .m-circle {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #f8fafc;
                border: 1px solid #cbd5e1;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                text-decoration: none;
            }
        }

        .btn-table {
            background: white;
            border: 1px solid #e2e8f0;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-bottom: 5px;
            text-align: center;
        }

        .btn-table:hover {
            border-color: var(--secondary);
            color: var(--secondary);
        }
    </style>
</head>

<body>

    <div class="app-layout">

        <aside class="sidebar desktop-only">
            <div class="sidebar-header">
                <div class="sidebar-logo">💳 WGS Payment</div>
                <div class="sidebar-user">
                    Welcome, <strong style="color:white;">
                        <%= role.toUpperCase() %>
                    </strong><br>
                    <%= adminUser.companyName || 'Setup Your Profile' %>
                </div>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-item active" id="nav-aging" onclick="switchTab('aging')">📊 Aging Buckets</a>
                <a class="nav-item" id="nav-parties" onclick="switchTab('parties')">🏢 Parties</a>
                <% if (role==='admin' ) { %>
                    <a class="nav-item" id="nav-data" onclick="switchTab('data')">🗄️ Data Management</a>
                    <a class="nav-item" href="/staff">👤 Manage Staff</a>
                    <% } %>
                        <a class="nav-item" href="/activity">📜 Activity Log</a>
                        <% if (role==='admin' ) { %>
                            <a class="nav-item"
                                onclick="document.getElementById('settingsModal').style.display='block'">⚙️ Profile
                                Settings</a>
                            <% } %>
                                <div style="flex:1;"></div>
                                <a class="nav-item" href="/logout"
                                    style="color: #fca5a5; background: rgba(239, 68, 68, 0.1);">🚪 Logout</a>
            </nav>
        </aside>

        <main class="main-content">

            <% if (role !=='customer' ) { %>
                <div class="home-launcher" id="homeLauncher">
                    <div class="home-header-card">
                        <div class="home-avatar">
                            <%= (adminUser.companyName || role).charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h2 style="margin:0; font-size:22px; font-weight:800;">Hello, <%=
                                    role.charAt(0).toUpperCase() + role.slice(1) %>
                            </h2>
                            <p style="margin: 4px 0 0; opacity: 0.85; font-size: 14px;">
                                <%= adminUser.companyName || 'WGS Payment Manager' %>
                            </p>
                        </div>
                    </div>
                    <div class="launcher-grid">
                        <a class="launcher-tile" onclick="openMobileSection('aging'); return false;">
                            <div class="launcher-icon" style="background: #e0f2fe;">📊</div>
                            <strong style="font-size:16px;">Aging Buckets</strong>
                            <span style="font-size:12px; color:var(--text-muted);">View KPIs & Dues</span>
                        </a>
                        <a class="launcher-tile" onclick="openMobileSection('parties'); return false;">
                            <div class="launcher-icon" style="background: #dcfce7;">🏢</div>
                            <strong style="font-size:16px;">Parties</strong>
                            <span style="font-size:12px; color:var(--text-muted);">Search & Manage</span>
                        </a>
                        <% if (role==='admin' ) { %>
                            <a class="launcher-tile" onclick="openMobileSection('data'); return false;">
                                <div class="launcher-icon" style="background: #f3e8ff;">🗄️</div>
                                <strong style="font-size:16px;">Data Mgmt</strong>
                                <span style="font-size:12px; color:var(--text-muted);">Backups & Imports</span>
                            </a>
                            <a class="launcher-tile" href="/staff">
                                <div class="launcher-icon" style="background: #fce7f3;">👤</div>
                                <strong style="font-size:16px;">Staff</strong>
                                <span style="font-size:12px; color:var(--text-muted);">Manage Team</span>
                            </a>
                            <% } %>
                                <a class="launcher-tile" href="/activity">
                                    <div class="launcher-icon" style="background: #fef3c7;">📜</div>
                                    <strong style="font-size:16px;">Activity Log</strong>
                                    <span style="font-size:12px; color:var(--text-muted);">Audit Trail</span>
                                </a>
                                <% if (role==='admin' ) { %>
                                    <a class="launcher-tile"
                                        onclick="document.getElementById('settingsModal').style.display='block'; return false;">
                                        <div class="launcher-icon" style="background: #e2e8f0;">⚙️</div>
                                        <strong style="font-size:16px;">Profile</strong>
                                        <span style="font-size:12px; color:var(--text-muted);">Company Details</span>
                                    </a>
                                    <a class="launcher-tile" href="/logout"
                                        style="grid-column: span 2; align-items:center; flex-direction:row; background: #fee2e2; border-color: #fca5a5;">
                                        <div class="launcher-icon"
                                            style="background: white; width:40px; height:40px; font-size:18px;">🚪</div>
                                        <strong style="font-size:16px; color:#b91c1c;">Logout</strong>
                                    </a>
                                    <% } %>
                    </div>
                </div>

                <button class="back-to-launcher" id="backBtn" onclick="handleMobileBack()">← Home</button>
                <% } %>

                    <div id="viewAging" class="section-view active">
                        <h1 class="desktop-only" style="margin-top:0;">📊 Aging Buckets</h1>

                        <div class="stats-grid">
                            <div class="stat-card">
                                <div class="stat-title">Total Parties</div>
                                <div class="stat-value">
                                    <%= stats.totalParties %>
                                </div>
                            </div>
                            <div class="stat-card alert">
                                <div class="stat-title">Total Pending Bills</div>
                                <div class="stat-value" style="color:#b91c1c;">
                                    <%= stats.totalPendingFmt %>
                                </div>
                            </div>
                            <div class="stat-card warning" style="cursor:pointer;" onclick="filterActionRequired()">
                                <div class="stat-title" style="color:var(--secondary-dark);">Action Required</div>
                                <div class="stat-value" style="color:var(--secondary-dark);">
                                    <%= stats.actionRequiredCount %>
                                </div>
                                <div
                                    style="font-size:11px;color:#2980b9;margin-top:8px;font-weight:bold;background:#f0f7ff;padding:4px;border-radius:10px;">
                                    Click to filter &rarr;</div>
                            </div>
                        </div>

                        <div class="floating-card aging-card">
                            <h2
                                style="margin-top:0;font-size:20px;font-weight:800;border-bottom:1px solid #f1f5f9;padding-bottom:15px;margin-bottom:20px;">
                                📅 Aging Breakdown
                                <span
                                    style="font-size:12px;color:var(--text-muted);font-weight:500;margin-left:8px;">Click
                                    any row to view parties</span>
                            </h2>

                            <div class="aging-row aging-clickable"
                                onclick="clickBucket('u30','&lt; 30 Days',<%= stats.buckets.u30.cnt %>,'<%= stats.buckets.u30.fmt %>')">
                                <div class="aging-labels"><span>&lt; 30 DAYS <span class="bucket-count">
                                            <%= stats.buckets.u30.cnt %>
                                        </span></span><span>
                                        <%= stats.buckets.u30.fmt %>
                                    </span></div>
                                <div class="progress-bg">
                                    <div class="progress-fill" style="width:<%= stats.buckets.u30.pct %>%;"></div>
                                </div>
                            </div>
                            <div class="aging-row aging-clickable"
                                onclick="clickBucket('d30_60','30-60 Days',<%= stats.buckets.d30_60.cnt %>,'<%= stats.buckets.d30_60.fmt %>')">
                                <div class="aging-labels"><span>30-60 DAYS <span class="bucket-count">
                                            <%= stats.buckets.d30_60.cnt %>
                                        </span></span><span>
                                        <%= stats.buckets.d30_60.fmt %>
                                    </span></div>
                                <div class="progress-bg">
                                    <div class="progress-fill" style="width:<%= stats.buckets.d30_60.pct %>%;"></div>
                                </div>
                            </div>
                            <div class="aging-row aging-clickable"
                                onclick="clickBucket('d60_90','60-90 Days',<%= stats.buckets.d60_90.cnt %>,'<%= stats.buckets.d60_90.fmt %>')">
                                <div class="aging-labels"><span>60-90 DAYS <span class="bucket-count">
                                            <%= stats.buckets.d60_90.cnt %>
                                        </span></span><span>
                                        <%= stats.buckets.d60_90.fmt %>
                                    </span></div>
                                <div class="progress-bg">
                                    <div class="progress-fill" style="width:<%= stats.buckets.d60_90.pct %>%;"></div>
                                </div>
                            </div>
                            <div class="aging-row aging-clickable"
