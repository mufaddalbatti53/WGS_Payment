                                                                                onsubmit="return confirm('Delete party?');">
                                                                                <button type="submit" class="m-tool-btn"
                                                                                    style="color:#ef4444; width:100%;">🗑️</button>
                                                                            </form>
                                                                            <% } %>
                                                                    </div>
                                                                </td>
