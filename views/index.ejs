<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Payment Manager Dashboard</title>
    
    <style>
        /* =========================================
           💻 DESKTOP STYLES (Base Design)
           ========================================= */
        body { font-family: Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        
        /* Header & Navigation */
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        .header h1 { margin: 0; color: #333; }
        .nav-links a { text-decoration: none; padding: 10px 15px; border-radius: 5px; color: white; margin-left: 10px; font-weight: bold; }
        .btn-staff { background: #007bff; }
        .btn-activity { background: #17a2b8; }
        .btn-logout { background: #dc3545; }

        /* Forms & Inputs */
        .add-form-container { background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #ddd; }
        input, select, button { padding: 10px; margin: 5px 5px 5px 0; border: 1px solid #ccc; border-radius: 4px; }
        button { background: #28a745; color: white; border: none; cursor: pointer; font-weight: bold; }
        button:hover { background: #218838; }
        .btn-danger { background: #dc3545; }
        .btn-danger:hover { background: #c82333; }

        /* Tables */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #e9ecef; font-weight: bold; color: #333; }
        .actions-form { display: flex; gap: 5px; align-items: center; margin: 0; }
        .actions-form input { width: 90px; margin: 0; }

        /* =========================================
           📱 MOBILE STYLES (Triggers under 768px)
           ========================================= */
        @media screen and (max-width: 768px) {
            body { padding: 10px; }
            .header { flex-direction: column; text-align: center; gap: 15px; }
            .nav-links { display: flex; flex-direction: column; width: 100%; }
            .nav-links a { margin: 0 0 10px 0; text-align: center; }
            
            input, select, button, .btn { width: 100%; box-sizing: border-box; font-size: 16px; margin-right: 0; }
            .actions-form { flex-direction: column; width: 100%; }
            .actions-form input { width: 100%; }

            /* Turn Table into Cards */
            table, thead, tbody, th, td, tr { display: block; }
            thead tr { display: none; } /* Hide column headers */
            
            tr { background: #fff; border: 2px solid #eee; border-radius: 10px; margin-bottom: 20px; padding: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
            td { border: none; border-bottom: 1px solid #f0f0f0; position: relative; padding-left: 45%; text-align: right; min-height: 30px; display: flex; justify-content: flex-end; align-items: center; }
            td:last-child { border-bottom: none; display: block; padding-left: 0; margin-top: 10px; text-align: center; }
            
            /* Add Mobile Labels */
            td::before { content: attr(data-label); position: absolute; left: 0; width: 40%; text-align: left; font-weight: bold; color: #555; }
        }
    </style>
</head>
<body>

<div class="container">
    
    <div class="header">
        <h1>Dashboard</h1>
        <div class="nav-links">
            <% if (role === 'admin') { %>
                <a href="/staff" class="btn-staff">Manage Staff</a>
                <a href="/activity" class="btn-activity">Activity Logs</a>
            <% } %>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </div>

    <% if (role === 'admin' || role === 'staff') { %>
        <div class="add-form-container">
            <h2 style="margin-top: 0;">Add New Customer</h2>
            <form action="/customers" method="POST">
                <input type="text" name="companyName" placeholder="Company Name" required>
                <input type="text" name="contactPerson" placeholder="Contact Person">
                <input type="text" name="countryCode" placeholder="+91" value="+91" style="width: 60px;">
                <input type="text" name="localPhone" placeholder="Phone Number" required>
                <input type="number" name="totalAmount" placeholder="Opening Balance (₹)" value="0">
                <button type="submit">Add Customer</button>
            </form>
        </div>
    <% } %>

    <h2>Customer List</h2>
    <table>
        <thead>
            <tr>
                <th>Company</th>
                <th>Contact</th>
                <th>Phone</th>
                <th>Total Due (₹)</th>
                <th>Paid (₹)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td data-label="Company"><%= customer.companyName %></td>
                    <td data-label="Contact"><%= customer.contactPerson || 'N/A' %></td>
                    <td data-label="Phone"><%= customer.phone %></td>
                    <td data-label="Total Due">₹<%= customer.totalAmount || 0 %></td>
                    <td data-label="Paid">₹<%= customer.paidAmount || 0 %></td>
                    
                    <td data-label="">
                        <% if (role === 'admin' || role === 'staff') { %>
                            
                            <form class="actions-form" action="/customers/<%= customer._id %>/transaction?_method=PUT" method="POST" style="margin-bottom: 10px;">
                                <input type="number" name="newPurchase" placeholder="+ Bill">
                                <input type="number" name="payment" placeholder="- Paid">
                                <button type="submit">Save</button>
                            </form>
                            
                            <% if (role === 'admin') { %>
                                <form class="actions-form" action="/customers/<%= customer._id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="btn-danger">Delete Customer</button>
                                </form>
                            <% } %>
                            
                        <% } else { %>
                            <span style="color: #666;">View Only</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
