            <script>
                let actionFilterActive = false;
                function toggleActionRequiredFilter() {
                    actionFilterActive = !actionFilterActive;
                    const rows = document.querySelectorAll('.customer-row');
                    const card = document.getElementById('actionStatCard');
                    const searchInput = document.getElementById('searchInput');

                    if (actionFilterActive) {
                        card.style.background = '#ffedd5';
                        card.style.transform = 'scale(0.98)';
                        card.style.boxShadow = 'inset 0 4px 10px rgba(0,0,0,0.05)';
                        if (searchInput) searchInput.value = '';

                        rows.forEach(row => {
                            if (row.getAttribute('data-action-req') === 'true') row.style.display = '';
                            else row.style.display = 'none';
                        });
                    } else {
                        card.style.background = 'white';
                        card.style.transform = 'none';
                        card.style.boxShadow = 'var(--shadow-soft)';
                        rows.forEach(row => row.style.display = '');
                    }
                }

                document.querySelectorAll('.transaction-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        window.history.pushState({ modal: true }, '', '#pay');
                        document.getElementById('transactionModal').style.display = "block";
                        document.getElementById('transCompanyName').innerText = this.getAttribute('data-company');
                        document.getElementById('transactionForm').action = `/customers/${this.getAttribute('data-id')}/transaction?_method=PUT`;
                    });
                });

                document.querySelectorAll('.reminder-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        window.history.pushState({ modal: true }, '', '#date');
                        document.getElementById('actionModal').style.display = "block";
                        document.getElementById('modalCompanyName').innerText = this.getAttribute('data-company');
                        document.getElementById('updateDateForm').action = `/customers/${this.getAttribute('data-id')}/update-reminder?_method=PUT`;
                    });
                });

                document.querySelectorAll('.edit-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        document.getElementById('editCompany').value = this.getAttribute('data-company');
                        document.getElementById('editContact').value = this.getAttribute('data-contact');
                        document.getElementById('editEmail').value = this.getAttribute('data-email');
                        document.getElementById('editPhone').value = this.getAttribute('data-phone');
                        document.getElementById('editWhatsapp').value = this.getAttribute('data-whatsapp');
                        document.getElementById('editOther').value = this.getAttribute('data-other');
                        window.history.pushState({ modal: true }, '', '#edit');
                        document.getElementById('editModal').style.display = "block";
                        document.getElementById('editForm').action = `/customers/${this.getAttribute('data-id')}/edit?_method=PUT`;
                    });
                });

                function openAddModal() {
                    window.history.pushState({ modal: true }, '', '#add');
                    document.getElementById('addModal').style.display = "block";
                }

                function closeAllModals() {
                    document.querySelectorAll('.modal').forEach(m => m.style.display = "none");
                }

                function closeTransactionModal() { window.history.back(); }
                function closeActionModal() { window.history.back(); }
                function closeEditModal() { window.history.back(); }
                function closeAddModal() { window.history.back(); }

                window.addEventListener('popstate', function (event) { closeAllModals(); });

                window.onclick = function (event) {
                    if (event.target.classList.contains('modal')) {
                        if (window.location.hash) window.history.back(); else closeAllModals();
                    }
                }

                const searchInput = document.getElementById('searchInput');
                if (searchInput) {
                    searchInput.addEventListener('keyup', function () {
                        if (actionFilterActive) toggleActionRequiredFilter();
                        let filter = this.value.toLowerCase();
                        document.querySelectorAll('.customer-row').forEach(row => {
                            let text = row.innerText.toLowerCase();
                            row.style.display = text.includes(filter) ? '' : 'none';
                        });
                    });
                }

                function downloadPDF() {
                    const elementToPrint = document.createElement('div');
                    elementToPrint.innerHTML = `
                <h1 style="text-align: center; font-family: sans-serif; color: #1e293b;">Customer Financial Report</h1>
                <h3 style="text-align: center; color: #64748b; font-family: sans-serif;">Generated: ${new Date().toLocaleDateString('en-IN')}</h3>
                ${document.querySelector('.aging-card').outerHTML}
                ${document.querySelector('table').outerHTML}
            `;
                    elementToPrint.querySelectorAll('.btn-table, .m-tools, form, .m-circles, .action-buttons, th:first-child, td:first-child, input[type="checkbox"]').forEach(el => el.style.display = 'none');
                    html2pdf().set({ margin: 0.5, filename: 'Financial_Report.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'in', format: 'letter', orientation: 'landscape' } }).from(elementToPrint).save();
                }

                // Bulk Delete Logic
                const selectAllBtn = document.getElementById('selectAll');
                const checkboxes = document.querySelectorAll('.customer-checkbox');
                const bulkBar = document.getElementById('bulkActionBar');
                const countText = document.getElementById('selectedCount');
                const hiddenInputs = document.getElementById('hiddenInputs');

                function updateBulkBar() {
                    const selected = Array.from(checkboxes).filter(cb => cb.checked);
                    if (selected.length > 0) {
                        if (bulkBar) bulkBar.classList.add('visible');
                        if (countText) countText.innerText = selected.length + ' Selected';
                    } else {
                        if (bulkBar) bulkBar.classList.remove('visible');
                    }
                }

                if (selectAllBtn) {
                    selectAllBtn.addEventListener('change', function () {
                        document.querySelectorAll('tbody tr:not([style*="display: none"]) .customer-checkbox').forEach(cb => cb.checked = this.checked);
                        updateBulkBar();
                    });
                }

                checkboxes.forEach(cb => { cb.addEventListener('change', updateBulkBar); });

                function confirmBulkDelete() {
                    const selected = Array.from(checkboxes).filter(cb => cb.checked);
                    if (confirm(`⚠️ WARNING: You are about to permanently delete ${selected.length} parties. Proceed?`)) {
                        hiddenInputs.innerHTML = '';
                        selected.forEach(cb => {
                            const input = document.createElement('input');
                            input.type = 'hidden'; input.name = 'customerIds'; input.value = cb.value;
                            hiddenInputs.appendChild(input);
                        });
                        document.getElementById('bulkForm').submit();
                    }
                }
            </script>
</body>

</html>