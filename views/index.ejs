            </div>
        </div>

        <div id="bulkActionBar" class="bulk-action-bar">
            <span id="selectedCount" style="font-weight: 700;">0 Selected</span>
            <form id="bulkForm" action="/customers/bulk" method="POST" style="margin: 0;">
                <input type="hidden" name="action" value="delete">
                <div id="hiddenInputs"></div>
                <button type="button" onclick="confirmBulkDelete()" class="btn-primary" style="background:#ef4444;">🗑️
                    Delete All</button>
            </form>
        </div>
        <% } %>

            <script>
                var isMobile = window.innerWidth <= 850;
                var activeFilter = { bucket: 'all', actionOnly: false };
                var mobileHistory = []; // Tracks navigation history for the smart back button

                // === DESKTOP TAB SWITCHING ===
                function switchTab(tabId) {
                    // Update sidebar active state
                    document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
                    var activeNav = document.getElementById('nav-' + tabId);
                    if (activeNav) activeNav.classList.add('active');

                    // Hide all views, show selected
                    document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active'));
                    var activeView = document.getElementById('view' + tabId.charAt(0).toUpperCase() + tabId.slice(1));
                    if (activeView) activeView.classList.add('active');
                }

                // === MOBILE NAVIGATION & LAUNCHER ===
                function openMobileSection(sectionId, fromSection) {
                    if (!isMobile) return;

                    // Push to history
                    if (fromSection) mobileHistory.push(fromSection);
                    else mobileHistory = ['home']; // reset history if clicking from launcher

                    // Hide launcher, show section
                    document.getElementById('homeLauncher').style.display = 'none';
                    document.querySelectorAll('.section-view').forEach(el => el.style.display = 'none');

                    var targetView = document.getElementById('view' + sectionId.charAt(0).toUpperCase() + sectionId.slice(1));
                    if (targetView) targetView.style.display = 'block';

                    // Configure Smart Back Button
                    var backBtn = document.getElementById('backBtn');
                    backBtn.style.display = 'block';

                    if (sectionId === 'aging') backBtn.innerHTML = '← Home  |  📊 Aging Buckets';
                    else if (sectionId === 'parties' && fromSection === 'aging') backBtn.innerHTML = '← Back to Aging Buckets';
                    else if (sectionId === 'parties') backBtn.innerHTML = '← Home  |  🏢 Parties';
                    else if (sectionId === 'data') backBtn.innerHTML = '← Home  |  🗄️ Data Management';
                }

                function handleMobileBack() {
                    var lastStop = mobileHistory.pop();
                    if (lastStop === 'aging') {
                        openMobileSection('aging'); // Go back to aging buckets
                        mobileHistory = ['home']; // reset so next back goes home
                    } else {
                        // Go Home (Launcher)
                        document.getElementById('homeLauncher').style.display = 'block';
                        document.querySelectorAll('.section-view').forEach(el => el.style.display = 'none');
                        document.getElementById('backBtn').style.display = 'none';
                        mobileHistory = [];
                        clearFilter(); // Clear filters when returning to home
                    }
                }

                // === AGING BUCKET FILTERING ===
                function clickBucket(bucketKey, label, count, amtStr) {
                    activeFilter.bucket = bucketKey;
                    activeFilter.actionOnly = false;

                    // Show header
                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) {
                        document.getElementById('filterActiveText').innerHTML = '📅 ' + label + ' &nbsp;|&nbsp; <strong>' + count + ' parties</strong> &nbsp;|&nbsp; ' + amtStr;
                        hdr.style.display = 'flex';
                    }

                    // On mobile, explicitly navigate to Parties and pass 'aging' as the history origin
                    if (isMobile) openMobileSection('parties', 'aging');
                    else switchTab('parties');

                    runFilters();
                }

                function filterActionRequired() {
                    activeFilter.actionOnly = true;
                    activeFilter.bucket = 'all';

                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) {
                        document.getElementById('filterActiveText').innerHTML = '⚠️ Action Required Parties';
                        hdr.style.display = 'flex';
                    }
                    if (isMobile) openMobileSection('parties', 'aging'); else switchTab('parties');
                    runFilters();
                }

                function clearFilter() {
                    activeFilter = { bucket: 'all', actionOnly: false };
                    document.getElementById('searchInput').value = '';
                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) hdr.style.display = 'none';
                    runFilters();
                }

                function runFilters() {
                    var searchTxt = document.getElementById('searchInput').value.toLowerCase();
                    var rows = document.querySelectorAll('.customer-row');

                    rows.forEach(function (row) {
                        var isVisible = true;

                        // 1. Check Search
                        if (searchTxt && row.textContent.toLowerCase().indexOf(searchTxt) === -1) isVisible = false;

                        // 2. Check Action Required
                        if (activeFilter.actionOnly && row.getAttribute('data-action') !== 'true') isVisible = false;

                        // 3. Check Buckets
                        if (activeFilter.bucket !== 'all') {
                            var bucketAmt = parseFloat(row.getAttribute('data-' + activeFilter.bucket)) || 0;
                            if (bucketAmt <= 0) isVisible = false;

                            // Update due text dynamically to show bucket amount
                            var dDesk = row.querySelector('.dynamic-due');
                            var dMob = row.querySelector('.dynamic-due-m');
                            if (dDesk) dDesk.innerText = 'Bucket Due: ₹' + bucketAmt;
                            if (dMob) dMob.innerText = 'Bucket Due: ₹' + bucketAmt;
                        } else {
                            // Reset to total due
                            var totalDue = row.getAttribute('data-due');
                            var dDesk = row.querySelector('.dynamic-due');
                            var dMob = row.querySelector('.dynamic-due-m');
                            if (dDesk) dDesk.innerText = 'Due: ₹' + totalDue;
                            if (dMob) dMob.innerText = 'Due: ₹' + totalDue;
                        }

                        if (isVisible) row.classList.remove('d-none'); else row.classList.add('d-none');
                    });
                }

                // === BULK ACTIONS & UTILS ===
                function toggleSelectAll() {
                    var cb = document.getElementById('selectAll');
                    var isChecked = !cb.checked;
                    cb.checked = isChecked;
                    document.querySelectorAll('.customer-checkbox').forEach(box => {
                        if (!box.closest('tr').classList.contains('d-none')) box.checked = isChecked;
                    });
                    updateBulk();
                }

                document.querySelectorAll('.customer-checkbox').forEach(box => box.addEventListener('change', updateBulk));

                function updateBulk() {
                    var count = document.querySelectorAll('.customer-checkbox:checked').length;
                    var bar = document.getElementById('bulkActionBar');
                    if (bar) {
                        if (count > 0) { bar.classList.add('visible'); document.getElementById('selectedCount').innerText = count + ' Selected'; }
                        else { bar.classList.remove('visible'); }
                    }
                }

                function confirmBulkDelete() {
                    var selected = document.querySelectorAll('.customer-checkbox:checked');
                    if (confirm("Delete " + selected.length + " parties?")) {
                        var inputs = document.getElementById('hiddenInputs');
                        inputs.innerHTML = '';
                        selected.forEach(box => {
                            var i = document.createElement('input'); i.type = 'hidden'; i.name = 'customerIds'; i.value = box.value; inputs.appendChild(i);
                        });
                        document.getElementById('bulkForm').submit();
                    }
                }

                function showLoadingBtn(form, btnId, loadingText) {
                    var btn = document.getElementById(btnId);
                    if (btn) { btn.innerHTML = loadingText; btn.style.opacity = '0.6'; btn.style.pointerEvents = 'none'; }
                    return true;
                }

                // Setup desktop active tab on load
                if (!isMobile) { switchTab('aging'); }
            </script>
</body>

</html>