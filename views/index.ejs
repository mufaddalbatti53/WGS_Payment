                    <div id="addDupAlert" class="dup-alert">⚠️ <span id="addDupMsg">A party with this name or phone already exists.</span></div>
                    <form action="/customers" method="POST" id="addPartyForm">
                        <label class="trans-label">Party Name</label>
                        <input type="text" name="companyName" id="addCompanyName" class="input-style" autocomplete="off">
                        <label class="trans-label">Company Name</label>
                        <input type="text" name="contactPerson" class="input-style">

                        <label class="trans-label">Email Address</label>
                        <input type="email" name="email" class="input-style">
                        <label class="trans-label">Total Due Amount (₹)</label>
                        <input type="number" name="totalAmount" required class="input-style">
                        <label class="trans-label">Primary Phone</label>
                        <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                            <select name="countryCode" class="input-style" style="width: 80px; margin-bottom: 0;">
                                <option value="91" selected>+91</option>
                                <option value="1">+1</option>
                                <option value="971">+971</option>
                            </select>
                            <input type="text" name="localPhone" id="addLocalPhone" required class="input-style"
                                style="margin-bottom: 0; width: 100%;" autocomplete="off">
                        </div>
                        <label class="trans-label">WhatsApp Number (with Code)</label>
                        <input type="text" name="whatsappNumber" required class="input-style">
                        <label class="trans-label">Other Numbers</label>
                        <input type="text" name="otherNumbers" placeholder="Comma separated" class="input-style">
                        <button type="submit" class="btn-primary" style="width:100%; margin-top: 10px;">Save
                            Party</button>
                    </form>
                </div>
            </div>

            <div id="transactionModal" class="modal">
                <div class="modal-content">
                    <span class="close" onclick="closeTransactionModal()">&times;</span>
                    <h3 style="margin-top: 0; color: var(--text-dark);">💳 Update Balance</h3>
                    <p id="transCompanyName" style="font-weight:bold; color:var(--secondary); margin-bottom: 20px;"></p>
                    <form id="transactionForm" method="POST">
                        <div class="trans-group"
                            style="background: #fdf2f8; border-color: #fbcfe8; padding: 10px; border-radius: 8px; margin-bottom: 10px; border: 1px solid;">
                            <label class="trans-label" style="color: #be185d;">➕ Add New Purchase (Increases
                                Debt)</label>
                            <input type="number" name="newPurchase" placeholder="Amount (₹)" class="input-style"
                                style="margin-bottom: 0;">
                        </div>
                        <div class="trans-group"
                            style="background: #f0fdf4; border-color: #bbf7d0; padding: 10px; border-radius: 8px; margin-bottom: 10px; border: 1px solid;">
                            <label class="trans-label" style="color: #15803d;">➖ Payment Received (Reduces Debt)</label>
                            <input type="number" name="payment" placeholder="Amount (₹)" class="input-style"
                                style="margin-bottom: 0;">
                        </div>
                        <button type="submit" class="btn-primary" style="width:100%;">Save Transaction</button>
                    </form>
                </div>
            </div>

            <div id="actionModal" class="modal">
                <div class="modal-content">
                    <span class="close" onclick="closeActionModal()">&times;</span>
                    <h3 style="margin-top: 0; color: var(--text-dark);">📅 Snooze / Set Date</h3>
                    <p id="modalCompanyName" style="font-weight:bold; color:var(--secondary);"></p>
                    <form id="updateDateForm" method="POST">
                        <label class="trans-label">Select Next Reminder Date:</label>
                        <input type="date" name="nextDate" required class="input-style">
                        <button type="submit" class="btn-primary" style="width:100%;">Save Date</button>
                    </form>
                </div>
            </div>

            <div id="editModal" class="modal">
                <div class="modal-content">
                    <span class="close" onclick="closeEditModal()">&times;</span>
                    <h3 style="margin-top: 0; color: var(--text-dark);">✏️ Edit Details</h3>
                    <form id="editForm" method="POST">
                        <label class="trans-label">Party Name</label>
                        <input type="text" name="companyName" id="editCompany" class="input-style">
                        <label class="trans-label">Company Name</label>
                        <input type="text" name="contactPerson" id="editContact" class="input-style">

                        <label class="trans-label">Email</label>
                        <input type="email" name="email" id="editEmail" class="input-style">
                        <div style="display: flex; gap: 10px;">
                            <div style="flex:1"><label class="trans-label">Phone</label><input type="text" name="phone"
                                    id="editPhone" required class="input-style"></div>
                            <div style="flex:1"><label class="trans-label">WhatsApp</label><input type="text"
                                    name="whatsappNumber" id="editWhatsapp" required class="input-style"></div>
                        </div>
                        <label class="trans-label">Other</label>
                        <input type="text" name="otherNumbers" id="editOther" class="input-style">

                        <div
                            style="display: flex; gap: 10px; border-top: 1px dashed #cbd5e1; padding-top: 15px; margin-top: 15px;">
                            <div style="flex:1"><label class="trans-label" style="color: #b91c1c;">Total Bill
                                    (₹)</label><input type="number" name="totalAmount" id="editTotal" required
                                    class="input-style" style="margin-bottom: 0;"></div>
                            <div style="flex:1"><label class="trans-label" style="color: #15803d;">Total Paid
                                    (₹)</label><input type="number" name="paidAmount" id="editPaid" required
                                    class="input-style" style="margin-bottom: 0;"></div>
                        </div>

                        <button type="submit" class="btn-primary" style="width:100%; margin-top: 15px;">Save
                            Changes</button>
                    </form>
                </div>
            </div>

            <div id="settingsModal" class="modal">
                <div class="modal-content">
                    <span class="close"
                        onclick="document.getElementById('settingsModal').style.display='none'">&times;</span>
                    <h3 style="margin-top: 0; color: var(--text-dark);">⚙️ Company Profile</h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin-top: -10px; margin-bottom: 20px;">Used
                        for PDF/Excel Headers and WhatsApp Messages.</p>
                    <form action="/settings?_method=PUT" method="POST">
                        <label class="trans-label">Company Name</label><input type="text" name="companyName"
                            value="<%= adminUser.companyName || '' %>" class="input-style">
                        <label class="trans-label">Address Line 1</label><input type="text" name="addressLine1"
                            value="<%= adminUser.addressLine1 || '' %>" class="input-style">
                        <label class="trans-label">Address Line 2</label><input type="text" name="addressLine2"
                            value="<%= adminUser.addressLine2 || '' %>" class="input-style">
                        <label class="trans-label">Address Line 3</label><input type="text" name="addressLine3"
                            value="<%= adminUser.addressLine3 || '' %>" class="input-style">
                        <div style="display: flex; gap: 10px;">
                            <div style="flex:1"><label class="trans-label">DL No.</label><input type="text" name="dlNo"
                                    value="<%= adminUser.dlNo || '' %>" class="input-style"></div>
                            <div style="flex:1"><label class="trans-label">MSME No.</label><input type="text"
                                    name="msmeNo" value="<%= adminUser.msmeNo || '' %>" class="input-style"></div>
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <div style="flex:1"><label class="trans-label">Contact No.</label><input type="text"
                                    name="contactNo" value="<%= adminUser.contactNo || '' %>" class="input-style"></div>
                            <div style="flex:1"><label class="trans-label">Email</label><input type="email"
                                    name="companyEmail" value="<%= adminUser.companyEmail || '' %>" class="input-style">
                            </div>
                        </div>

                        <div style="border-top: 1px dashed #cbd5e1; margin-top: 10px; padding-top: 15px;">
                            <h4
                                style="margin-top: 0; margin-bottom: 10px; font-size: 14px; color: var(--secondary-dark);">
                                🏦 Bank & UPI Details (Optional)</h4>
                            <label class="trans-label">Bank Name</label><input type="text" name="bankName"
                                value="<%= adminUser.bankName || '' %>" class="input-style">
                            <label class="trans-label">Account Name</label><input type="text" name="accountName"
                                value="<%= adminUser.accountName || '' %>" class="input-style">
                            <div style="display: flex; gap: 10px;">
                                <div style="flex:1"><label class="trans-label">Account No.</label><input type="text"
                                        name="accountNumber" value="<%= adminUser.accountNumber || '' %>"
                                        class="input-style"></div>
                                <div style="flex:1"><label class="trans-label">IFSC Code</label><input type="text"
                                        name="ifscCode" value="<%= adminUser.ifscCode || '' %>" class="input-style">
                                </div>
                            </div>
                            <label class="trans-label">UPI ID / Number</label><input type="text" name="upiDetails"
                                value="<%= adminUser.upiDetails || '' %>" class="input-style" style="margin-bottom: 0;">
                        </div>

                        <button type="submit" class="btn-primary"
                            style="width:100%; padding:12px; font-weight:bold; margin-top:20px;">💾 Save Profile & Bank
                            Info</button>
                    </form>
                </div>
            </div>

            <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
            <script>
                var actionFilterActive = false;

                function toggleFilterPanel() {
                    var panel = document.getElementById('filterPanel');
                    if (panel) {
                        panel.style.display = (panel.style.display === 'none' || panel.style.display === '') ? 'block' : 'none';
                    }
                }

                function clearFilters() {
                    document.getElementById('filterAging').value = 'all';
                    document.getElementById('filterAmtType').value = 'due';
                    document.getElementById('filterMin').value = '';
                    document.getElementById('filterMax').value = '';
                    document.getElementById('searchInput').value = '';
                    clearAgingFilter();
                }

                function toggleActionRequiredFilter() {
                    actionFilterActive = !actionFilterActive;
                    var card = document.getElementById('actionStatCard');
                    if (actionFilterActive) {
                        card.style.background = '#f0f9ff';
                        card.style.transform = 'scale(0.98)';
                        card.style.boxShadow = 'inset 0 4px 10px rgba(0,0,0,0.05)';
                        document.getElementById('searchInput').value = '';
                    } else {
                        card.style.background = 'white';
                        card.style.transform = 'none';
                        card.style.boxShadow = 'var(--shadow-soft)';
                    }
                    runAllFilters('action');
                }

                // ============================================================
                // AGING BUCKET CLICK-TO-FILTER
                // ============================================================
                var _activeBucketKey = null;

                function filterByBucket(bucketKey, label, count, amtStr) {
                    // Scroll to table
                    var tableSection = document.getElementById('filterActiveHeader');
                    if (tableSection) tableSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

                    // Deactivate previously active bucket row
                    var prevActive = document.querySelector('.aging-clickable.active-bucket');
                    if (prevActive) prevActive.classList.remove('active-bucket');

                    // Activate clicked bucket row
                    var rows = document.querySelectorAll('.aging-clickable');
                    var bucketMap = { 'u30': 0, 'd30_60': 1, 'd60_90': 2, 'd90_120': 3, 'd120_150': 4, 'd150_180': 5, 'a180': 6 };
                    var idx = bucketMap[bucketKey];
                    if (idx !== undefined && rows[idx]) rows[idx].classList.add('active-bucket');

                    _activeBucketKey = bucketKey;

                    // Set the hidden filter dropdown so runAllFilters works
                    var filterAging = document.getElementById('filterAging');
                    if (filterAging) filterAging.value = bucketKey;

                    // Show active filter header above the table
                    var hdr = document.getElementById('filterActiveHeader');
                    var hdrTxt = document.getElementById('filterActiveText');
                    if (hdr && hdrTxt) {
                        hdrTxt.innerHTML = '📅 ' + label + ' &nbsp;|&nbsp; <strong>' + count + ' parties</strong> &nbsp;|&nbsp; Total: ' + amtStr;
                        hdr.classList.add('show');
                    }

                    // Show the dashboard if we're on launcher
                    showDashboard();

                    runAllFilters('standard');
                }

                function clearAgingFilter() {
                    _activeBucketKey = null;

                    var prevActive = document.querySelector('.aging-clickable.active-bucket');
                    if (prevActive) prevActive.classList.remove('active-bucket');

                    var filterAging = document.getElementById('filterAging');
                    if (filterAging) filterAging.value = 'all';

                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) hdr.classList.remove('show');

                    var banner = document.getElementById('agingFilterBanner');
                    if (banner) banner.classList.remove('show');

                    runAllFilters('standard');
                }

                function runAllFilters(source) {
                    var searchInput = document.getElementById('searchInput');
                    var searchText = searchInput ? searchInput.value.toLowerCase().trim() : '';

                    var filterAging = document.getElementById('filterAging');
                    var agingVal = filterAging ? filterAging.value : 'all';

                    var filterAmtType = document.getElementById('filterAmtType');
                    var amtType = filterAmtType ? filterAmtType.value : 'due';

                    var filterMin = document.getElementById('filterMin');
                    var minAmt = filterMin && filterMin.value ? parseFloat(filterMin.value) : 0;

                    var filterMax = document.getElementById('filterMax');
                    var maxAmt = filterMax && filterMax.value ? parseFloat(filterMax.value) : Infinity;

                    if (source === 'search' && searchText.length > 0 && actionFilterActive) {
                        actionFilterActive = false;
                        var card = document.getElementById('actionStatCard');
                        if (card) {
                            card.style.background = 'white';
                            card.style.transform = 'none';
                            card.style.boxShadow = 'var(--shadow-soft)';
                        }
                    }

                    var rows = document.querySelectorAll('.customer-row');

                    for (var i = 0; i < rows.length; i++) {
                        var row = rows[i];
                        var isVisible = true;

                        if (searchText.length > 0) {
                            var text = row.textContent.toLowerCase();
                            if (text.indexOf(searchText) === -1) isVisible = false;
                        }

                        var rawDue = parseFloat(row.getAttribute('data-due')) || 0;
                        var rawTotal = parseFloat(row.getAttribute('data-total')) || 0;
                        var valToCheck = (amtType === 'due') ? rawDue : rawTotal;

                        if (valToCheck < minAmt || valToCheck > maxAmt) {
                            isVisible = false;
                        }

                        var dynamicDueD = row.querySelector('.dynamic-due');
                        var dynamicDueM = row.querySelector('.dynamic-due-m');

                        if (agingVal !== 'all') {
                            var bucketAmt = parseFloat(row.getAttribute('data-' + agingVal)) || 0;
                            if (bucketAmt <= 0) {
                                isVisible = false;
                            } else {
                                if (dynamicDueD) dynamicDueD.innerText = 'Bucket Due: ₹' + bucketAmt;
                                if (dynamicDueM) dynamicDueM.innerText = 'Bucket Due: ₹' + bucketAmt;
                            }
                        } else {
                            if (dynamicDueD) dynamicDueD.innerText = 'Due: ₹' + rawDue;
                            if (dynamicDueM) dynamicDueM.innerText = 'Due: ₹' + rawDue;
                        }

                        if (actionFilterActive && row.getAttribute('data-action-req') !== 'true') {
                            isVisible = false;
                        }

                        if (isVisible) {
                            row.classList.remove('d-none');
                        } else {
                            row.classList.add('d-none');
                        }
                    }
                }

                var searchBox = document.getElementById('searchInput');
                if (searchBox) {
                    searchBox.addEventListener('keyup', function () {
                        runAllFilters('search');
                    });
                }

                function sendMsg(element, type) {
                    var id = element.getAttribute('data-id');
                    var phone = element.getAttribute('data-phone');
                    var wa = element.getAttribute('data-wa');
                    var email = element.getAttribute('data-email');

                    var cname = decodeURIComponent(element.getAttribute('data-cname') || '');
                    var pname = decodeURIComponent(element.getAttribute('data-pname') || '');
                    var admin = decodeURIComponent(element.getAttribute('data-admin') || '');

                    var total = element.getAttribute('data-total');
                    var paidamount = element.getAttribute('data-paidamount');
                    var lastpaid = decodeURIComponent(element.getAttribute('data-lastpaid') || '');
                    var due = element.getAttribute('data-due');
                    var diff = parseInt(element.getAttribute('data-diff') || '0');

                    var bName = decodeURIComponent("<%= encodeURIComponent(adminUser.bankName || '') %>");
                    var aName = decodeURIComponent("<%= encodeURIComponent(adminUser.accountName || '') %>");
                    var aNo = decodeURIComponent("<%= encodeURIComponent(adminUser.accountNumber || '') %>");
                    var ifsc = decodeURIComponent("<%= encodeURIComponent(adminUser.ifscCode || '') %>");
                    var upi = decodeURIComponent("<%= encodeURIComponent(adminUser.upiDetails || '') %>");

                    var m = [];
                    var cStr = cname;
                    if (pname.length > 0) {
                        cStr += " (" + pname + ")";
                    }

                    m.push("Hello, this is " + admin + ".");
                    m.push("");
                    m.push("This is a gentle payment reminder for " + cStr + ".");
                    m.push("");
                    m.push("📊 *Account Summary:*");
                    m.push("- Total Bill Amount: Rs " + total);

                    var pStr = "Rs " + paidamount;
                    if (parseInt(paidamount) > 0 && lastpaid) {
                        pStr += " (Last paid: " + lastpaid + ")";
                    }

                    m.push("- Total Amount Paid: " + pStr);
                    m.push("- Current Outstanding Due: *Rs " + due + "*");
                    m.push("");

                    if (diff > 0) {
                        m.push("_It is " + diff + " days past the set action date._");
                        m.push("");
                    }

                    m.push("Please arrange the payment for the pending amount at your earliest convenience.");
                    m.push("");

                    if (bName || aNo || upi) {
                        m.push("🏦 *Payment Details:*");
                        if (bName) m.push("Bank: " + bName);
                        if (aName) m.push("Name: " + aName);
                        if (aNo) m.push("A/C No: " + aNo);
                        if (ifsc) m.push("IFSC: " + ifsc);
                        if (upi) m.push("UPI: " + upi);
                        m.push("");
                    }

                    m.push("Thank you,");
                    m.push(admin);

                    var finalMsg = m.join('\n');
                    var encoded = encodeURIComponent(finalMsg);

                    if (type === 'wa') window.open('https://wa.me/' + wa + '?text=' + encoded, '_blank');
                    if (type === 'sms') window.open('sms:+' + phone + '?body=' + encoded, '_self');
                    if (type === 'email') window.open('mailto:' + email + '?subject=Payment Reminder&body=' + encoded, '_self');

                    var container1 = element.closest('.action-buttons');
                    var container2 = element.closest('.m-circles');
                    if (container1) container1.style.display = 'none';
                    if (container2) container2.style.display = 'none';

                    var row = element.closest('tr');
                    if (row) {
                        var warnings = row.querySelectorAll('.req-badge');
                        for (var i = 0; i < warnings.length; i++) {
                            warnings[i].style.display = 'none';
                        }
                    }

                    fetch('/customers/' + id + '/auto-snooze', { method: 'POST' }).catch(function (e) { });
                }

                var transBtns = document.querySelectorAll('.transaction-btn');
                for (var i = 0; i < transBtns.length; i++) {
                    transBtns[i].addEventListener('click', function () {
                        window.history.pushState({ modal: true }, '', '#pay');
                        document.getElementById('transactionModal').style.display = "block";
                        document.getElementById('transCompanyName').innerText = this.getAttribute('data-company');
                        document.getElementById('transactionForm').action = '/customers/' + this.getAttribute('data-id') + '/transaction?_method=PUT';
                    });
                }

                var remBtns = document.querySelectorAll('.reminder-btn');
                for (var j = 0; j < remBtns.length; j++) {
                    remBtns[j].addEventListener('click', function () {
                        window.history.pushState({ modal: true }, '', '#date');
                        document.getElementById('actionModal').style.display = "block";
                        document.getElementById('modalCompanyName').innerText = this.getAttribute('data-company');
                        document.getElementById('updateDateForm').action = '/customers/' + this.getAttribute('data-id') + '/update-reminder?_method=PUT';
                    });
                }

                var editBtns = document.querySelectorAll('.edit-btn');
                for (var k = 0; k < editBtns.length; k++) {
                    editBtns[k].addEventListener('click', function () {
                        document.getElementById('editCompany').value = this.getAttribute('data-company');
                        document.getElementById('editContact').value = this.getAttribute('data-contact');
                        document.getElementById('editEmail').value = this.getAttribute('data-email');
                        document.getElementById('editPhone').value = this.getAttribute('data-phone');
                        document.getElementById('editWhatsapp').value = this.getAttribute('data-whatsapp');
                        document.getElementById('editOther').value = this.getAttribute('data-other');
                        document.getElementById('editTotal').value = this.getAttribute('data-total');
                        document.getElementById('editPaid').value = this.getAttribute('data-paid');

                        window.history.pushState({ modal: true }, '', '#edit');
                        document.getElementById('editModal').style.display = "block";
                        document.getElementById('editForm').action = '/customers/' + this.getAttribute('data-id') + '/edit?_method=PUT';
                    });
                }

                function openAddModal() {
                    window.history.pushState({ modal: true }, '', '#add');
                    document.getElementById('addModal').style.display = "block";
                }
                function closeAllModals() {
                    var modals = document.querySelectorAll('.modal');
                    for (var i = 0; i < modals.length; i++) { modals[i].style.display = "none"; }
                }
                function closeTransactionModal() { window.history.back(); }
                function closeActionModal() { window.history.back(); }
                function closeEditModal() { window.history.back(); }
                function closeAddModal() { window.history.back(); }
                window.addEventListener('popstate', function (event) { closeAllModals(); });
                window.onclick = function (event) {
                    if (event.target.classList.contains('modal')) {
                        if (window.location.hash) window.history.back(); else closeAllModals();
                    }
                }

                function downloadPDF() {
                    var el = document.createElement('div');
                    var d = new Date().toLocaleDateString('en-IN');
                    var html = '<h1 style="text-align:center;color:#1e293b;">Financial Report</h1>';
                    html += '<h3 style="text-align:center;color:#64748b;">Generated: ' + d + '</h3>';
                    html += document.querySelector('.aging-card').outerHTML;
                    html += document.querySelector('table').outerHTML;
                    el.innerHTML = html;

                    var hideNodes = el.querySelectorAll('.btn-table, .m-tools, form, .m-circles, .action-buttons, th:first-child, td:first-child, input[type="checkbox"]');
                    for (var i = 0; i < hideNodes.length; i++) {
                        hideNodes[i].style.display = 'none';
                    }

                    var opt = {
                        margin: 0.5,
                        filename: 'Financial_Report.pdf',
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2 },
                        jsPDF: { unit: 'in', format: 'letter', orientation: 'landscape' }
                    };
                    html2pdf().set(opt).from(el).save();
                }

                var selectAllBtn = document.getElementById('selectAll');
                var checkboxes = document.querySelectorAll('.customer-checkbox');
                var bulkBar = document.getElementById('bulkActionBar');
                var countText = document.getElementById('selectedCount');
                var hiddenInputs = document.getElementById('hiddenInputs');

                function updateBulkBar() {
                    var count = 0;
                    for (var i = 0; i < checkboxes.length; i++) {
                        if (checkboxes[i].checked) count++;
                    }
                    if (count > 0) {
                        bulkBar.classList.add('visible');
                        countText.innerText = count + ' Selected';
                    } else {
                        bulkBar.classList.remove('visible');
                    }
                }

                if (selectAllBtn) {
                    selectAllBtn.addEventListener('change', function () {
                        var checked = this.checked;
                        var visibleBoxes = document.querySelectorAll('tbody tr:not([style*="display: none"]) .customer-checkbox');
                        for (var i = 0; i < visibleBoxes.length; i++) {
                            visibleBoxes[i].checked = checked;
                        }
                        updateBulkBar();
                    });
                }

                for (var i = 0; i < checkboxes.length; i++) {
                    checkboxes[i].addEventListener('change', updateBulkBar);
                }

                function confirmBulkDelete() {
                    var selected = [];
                    for (var i = 0; i < checkboxes.length; i++) {
                        if (checkboxes[i].checked) selected.push(checkboxes[i]);
                    }
                    if (confirm("⚠️ WARNING: You are about to permanently delete " + selected.length + " parties. Proceed?")) {
                        hiddenInputs.innerHTML = '';
                        for (var j = 0; j < selected.length; j++) {
                            var input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = 'customerIds';
                            input.value = selected[j].value;
                            hiddenInputs.appendChild(input);
                        }
                        document.getElementById('bulkForm').submit();
                    }
                }

                // ============================================================
                // APP LAUNCHER: show/hide home vs dashboard
                // ============================================================
                var homeLauncher = document.getElementById('homeLauncher');
                var mainDashboard = document.getElementById('mainDashboard');
                var backBtn = document.getElementById('backToLauncher');

                var isMobile = window.innerWidth < 769;

                function showLauncher() {
                    if (!isMobile) return; // desktop always shows dashboard
                    if (homeLauncher) homeLauncher.style.display = 'block';
                    if (mainDashboard) mainDashboard.style.display = 'none';
                    if (backBtn) backBtn.style.display = 'none';
                }

                function showDashboard() {
                    if (homeLauncher) homeLauncher.style.display = 'none';
                    if (mainDashboard) mainDashboard.style.display = 'block';
                    if (backBtn && isMobile) backBtn.style.display = 'inline-block';
                }

                // On load
                (function() {
                    var params = new URLSearchParams(window.location.search);
                    var isDup = params.get('dup') === '1';
                    var dupName = params.get('dupname') || '';

                    <% if (role !== 'customer') { %>
                    if (isMobile && !isDup) {
                        showLauncher();
                    } else {
                        showDashboard();
                    }
                    <% } %>

                    if (isDup) {
                        var warn = document.getElementById('dupWarning');
                        var warnText = document.getElementById('dupWarningText');
                        if (warn) {
                            warnText.innerText = '⚠️ Duplicate Blocked: A party named "' + decodeURIComponent(dupName) + '" or with the same phone already exists. Please check before adding.';
                            warn.style.display = 'flex';
                        }
                        if (window.history.replaceState) {
                            window.history.replaceState({}, document.title, '/');
                        }
                    }
                })();

                // ============================================================
                // VISIBLE "SELECT ALL" BUTTON
                // ============================================================
                var _selectAllState = false;
                function toggleSelectAll() {
                    _selectAllState = !_selectAllState;
                    var visibleBoxes = document.querySelectorAll('tbody tr:not(.d-none) .customer-checkbox');
                    for (var i = 0; i < visibleBoxes.length; i++) {
                        visibleBoxes[i].checked = _selectAllState;
                    }
                    var btn = document.getElementById('selectAllBtn');
                    if (btn) btn.innerText = _selectAllState ? '☐ Deselect All' : '☑️ Select All';
                    // Also sync the header checkbox
                    var hdrCb = document.getElementById('selectAll');
                    if (hdrCb) hdrCb.checked = _selectAllState;
                    updateBulkBar();
                }

                // ============================================================
                // REAL-TIME DUPLICATE CHECK in Add Modal
                // ============================================================
                var _dupCheckTimer = null;
                function checkDuplicate() {
                    var nameVal = document.getElementById('addCompanyName') ? document.getElementById('addCompanyName').value.trim() : '';
                    var phoneVal = document.getElementById('addLocalPhone') ? document.getElementById('addLocalPhone').value.trim() : '';

                    if (!nameVal && !phoneVal) {
                        document.getElementById('addDupAlert').classList.remove('show');
                        return;
                    }

                    clearTimeout(_dupCheckTimer);
                    _dupCheckTimer = setTimeout(function() {
                        var url = '/customers/check-duplicate?name=' + encodeURIComponent(nameVal) + '&phone=' + encodeURIComponent(phoneVal);
                        fetch(url)
                            .then(function(r) { return r.json(); })
                            .then(function(data) {
                                var alert = document.getElementById('addDupAlert');
                                var msg = document.getElementById('addDupMsg');
                                if (data.isDuplicate) {
                                    var reason = data.matchReason === 'name' ? 'name' : 'phone number';
                                    msg.innerText = 'A party with this ' + reason + ' already exists: "' + data.matchedName + '". Please verify before saving.';
                                    alert.classList.add('show');
                                } else {
                                    alert.classList.remove('show');
                                }
                            })
                            .catch(function() {});
                    }, 500);
                }

                var addNameInput = document.getElementById('addCompanyName');
                var addPhoneInput = document.getElementById('addLocalPhone');
                if (addNameInput) addNameInput.addEventListener('input', checkDuplicate);
                if (addPhoneInput) addPhoneInput.addEventListener('input', checkDuplicate);

            </script>
</body>

</html>