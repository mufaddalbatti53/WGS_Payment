<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Payment Manager</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#27ae60">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 14px;
        }

        th,
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            vertical-align: middle;
        }

        th {
            background: #eee;
        }

        .badge-due {
            background: #ffdddd;
            color: #d00;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin-top: 5px;
        }

        .badge-paid {
            background: #ddffdd;
            color: #008000;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin-top: 5px;
        }

        .btn {
            padding: 5px 10px;
            cursor: pointer;
            border: 1px solid #ccc;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            font-size: 12px;
        }

        .btn-green {
            background: #25D366;
            color: white;
            border: none;
        }

        .btn-blue {
            background: #3498db;
            color: white;
            border: none;
        }

        .btn-orange {
            background: #e67e22;
            color: white;
            border: none;
        }

        .btn-red {
            background: #e74c3c;
            color: white;
            border: none;
        }

        .btn-yellow {
            background: #f1c40f;
            color: #333;
            border: none;
        }

        /* New Edit Button Style */

        .role-nav {
            margin-bottom: 20px;
            padding: 10px;
            background: #333;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 4px;
        }

        .role-nav a {
            color: white;
            text-decoration: none;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background: white;
            margin: 10% auto; /* Centers better on mobile */
            padding: 20px;
            border-radius: 8px;
            width: 90%; /* Forces it to fit inside the screen */
            max-width: 400px;
            max-height: 80vh; /* Prevents it from getting taller than the phone screen */
            overflow-y: auto; /* Adds an internal scrollbar if the screen is tiny */
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .close {
            float: right;
            font-size: 24px;
            cursor: pointer;
        }

        .admin-menu {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .menu-btn {
            padding: 10px 20px;
            text-decoration: none;
            color: white;
            border-radius: 4px;
            font-weight: bold;
        }

        .btn-menu-blue {
            background: #3498db;
        }

        .btn-menu-purple {
            background: #9b59b6;
        }

        .input-style {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: 100%;
            box-sizing: border-box;
            margin-bottom: 5px;
        }

        .form-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .trans-group {
            background: #f9f9f9;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 10px;
            border: 1px solid #eee;
        }

        .trans-label {
            font-size: 11px;
            font-weight: bold;
            color: #555;
            display: block;
            margin-bottom: 3px;
        }
       @media screen and (max-width: 768px) {
    /* Reset and Layout */
    table, thead, tbody, th, td, tr { display: block; width: 100%; box-sizing: border-box; }
    thead tr { display: none; }
    
    /* The App Card (Matches the sketch border) */
    tr {
        background: #fff;
        border: 2px solid #e67e22; 
        border-radius: 12px;
        margin-bottom: 15px;
        padding: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    
    td { border: none !important; padding: 0 !important; }
    td.desktop-only { display: none !important; }
    td.mobile-only { display: block !important; }
    
    /* Top Row: Name and Financials */
    .m-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; }
    
    /* Left: Name */
    .m-name { width: 35%; line-height: 1.3; }
    .m-name strong { font-size: 18px; text-decoration: underline; text-underline-offset: 4px; color: #000; display: block; }
    .m-name span { font-size: 14px; color: #555; }
    
    /* Right: Financials (Shrunk to fit one line) */
    /* Right: Financials (Stacked Vertically) */
    .m-fin { width: 65%; text-align: right; line-height: 1.5; }
    .m-fin-top { font-size: 13px; color: #000; display: block; }
    .m-fin-due { color: #d00; font-weight: bold; display: block; margin-top: 2px; }
    .m-fin-paid { font-size: 13px; color: #28a745; display: block; margin-top: 2px; }
    
    /* Middle: Action Circles */
    .m-circles { display: flex; justify-content: flex-end; gap: 12px; margin-bottom: 15px; }
    .m-circle { width: 38px; height: 38px; border-radius: 50%; border: 2px solid #e67e22; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px; }
    
    /* Bottom: Sleek Tool Bar */
    .m-tools { display: flex; justify-content: space-between; border-top: 1px solid #eee; padding-top: 10px; }
    .m-tool-btn { background: none; border: none; font-size: 20px; padding: 5px 15px; cursor: pointer; color: #555; display: flex; align-items: center; justify-content: center; }
}

/* Hide mobile elements on Desktop */
@media screen and (min-width: 769px) {
    .mobile-only { display: none !important; }
}
    </style>
</head>

<body>

    <div class="role-nav">
        <span>Logged in as: <strong>
                <%= role.toUpperCase() %>
            </strong></span>
        <a href="/logout" style="background: red; padding: 5px 10px; border-radius: 4px;">Logout</a>
    </div>

    <div class="container">
        <h1>Payment Dashboard</h1>

        <% if (role==='admin' ) { %>
            <div class="admin-menu">
                <a href="/staff" class="menu-btn btn-menu-blue">👤 Manage Staff</a>
                <a href="/activity" class="menu-btn btn-menu-purple">📜 Activity Log</a>
            </div>

            <div style="background: #e9ecef; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                <h3>Excel Data Management</h3>
            
                <a href="/export"
                    style="background: #28a745; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px; display: inline-block; margin-bottom: 10px;">
                    📥 Download All to Excel
                </a>
            
                <hr style="border-top: 1px solid #ccc;">
            
                <form action="/import" method="POST" enctype="multipart/form-data" style="margin-top: 10px;">
                    <label for="excelFile"><strong>Upload Excel File:</strong></label>
                    <input type="file" name="excelFile" accept=".xlsx, .xls" required style="margin-right: 10px;">
                    <button type="submit"
                        style="background: #007bff; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer;">
                        📤 Import Data
                    </button>
                    <br>
                    <small style="color: #666;">Note: Columns must match: "Company Name", "Contact Person", "Phone Number", "Total
                        Due", "Paid Amount"</small>
                </form>
            </div>

            <div style="background: #eee; padding: 15px; margin-bottom: 20px; border-radius: 4px;">
                <h3>Add New Party</h3>
                <form action="/customers" method="POST">
                    <div class="form-row">
                        <input type="text" name="companyName" placeholder="Company Name" required class="input-style">
                        <input type="text" name="contactPerson" placeholder="Contact Person" required
                            class="input-style">
                    </div>
                    <div class="form-row">
                        <input type="email" name="email" placeholder="Email Address" class="input-style">
                        <input type="number" name="totalAmount" placeholder="Total Amount (₹)" required
                            class="input-style">
                    </div>
                    <div class="form-row">
                        <select name="countryCode" id="countryCode" class="input-style" style="width: 80px;">
                            <option value="91" selected>+91</option>
                            <option value="1">+1</option>
                            <option value="971">+971</option>
                        </select>
                        <input type="text" name="localPhone" placeholder="Primary Calling Number" required
                            class="input-style">
                        <input type="text" name="whatsappNumber" placeholder="WhatsApp Number" required class="input-style">
                    </div>

                    <div class="form-row">
                        <input type="text" name="otherNumbers" placeholder="Other Numbers (Comma separated)"
                            class="input-style">
                    </div>

                    <button type="submit" class="btn" style="background:#333; color:white; padding: 10px 20px;">Add
                        Party</button>
                </form>
            </div>
            <% } %>

                <table>
                    <thead>
                        <tr>
                            <th>Company / Contact</th>
                            <th>Contact Info</th>
                            <th>Financials</th>
                            <th>Next Action Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                <tbody>
                    <% customers.forEach(customer=> { %>
                        <% const due=customer.totalAmount - customer.paidAmount; const now=new Date(); const
                            nextDate=customer.nextReminderDate ? new Date(customer.nextReminderDate) : new Date(); const today=new
                            Date(now.getFullYear(), now.getMonth(), now.getDate()); const target=new Date(nextDate.getFullYear(),
                            nextDate.getMonth(), nextDate.getDate()); const isDueForReminder=today>= target;
                
                            const diffTime = Math.abs(today - target);
                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                            const daysText = (isDueForReminder && diffDays > 0) ? ` It is ${diffDays} days past the set action date.` :
                            "";
                
                            const msg = `Hello ${customer.contactPerson || 'Sir/Madam'} from ${customer.companyName}. This is a gentle
                            reminder. You have previously paid ₹${customer.paidAmount} on this account. Your current outstanding due is
                            ₹${due}.${daysText} Please arrange the payment at your earliest convenience.`;
                            const encodedMsg = encodeURIComponent(msg);
                            %>
                            <tr>
                                <td class="desktop-only">
                                    <strong>
                                        <%= customer.companyName %>
                                    </strong><br>
                                    <span style="color:#555; font-size:12px;">
                                        <%= customer.contactPerson %>
                                    </span>
                                </td>
                
                                <td class="desktop-only">
                                    📞 Phone: <a href="tel:+<%= customer.phone %>" style="text-decoration:none; color:black;">+<%=
                                            customer.phone %></a><br>
                
                                    <% if (customer.whatsappNumber) { %>
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" width="14"
                                            height="14" style="vertical-align: middle;"> WhatsApp: <a
                                            href="https://wa.me/<%= customer.whatsappNumber %>" target="_blank"
                                            style="text-decoration:none; color:green;">+<%= customer.whatsappNumber %></a><br>
                                        <% } %>
                
                                            <% if (customer.otherNumbers) { %>
                                                <% customer.otherNumbers.split(',').forEach(num=> { %>
                                                    <% if(num.trim() !=="" ) { %>
                                                        📞 Other: <a href="tel:<%= num.trim() %>"
                                                            style="text-decoration:none; color:#555; font-size:12px;">
                                                            <%= num.trim() %>
                                                        </a><br>
                                                        <% } %>
                                                            <% }) %>
                                                                <% } %>
                
                                                                    <% if (customer.email) { %>
                                                                        📧 Email: <a href="mailto:<%= customer.email %>"
                                                                            style="color:blue; text-decoration:underline;">
                                                                            <%= customer.email %>
                                                                        </a>
                                                                        <% } %>
                                </td>
                
                                <td class="desktop-only">
                                    Total: ₹<%= customer.totalAmount %><br>
                                        Paid: ₹<%= customer.paidAmount %><br>
                                            <% if (due> 0) { %> <span class="badge-due">Due: ₹<%= due %></span>
                                                <% } else { %> <span class="badge-paid">Paid</span>
                                                    <% } %>
                                </td>
                
                                <td class="desktop-only">
                                    <%= nextDate.toDateString() %>
                                        <% if (due> 0 && isDueForReminder) { %> <br><span style="color:red; font-weight:bold;">(Action
                                                Required)</span>
                                            <% } %>
                                </td>
                
                                <td class="desktop-only">
                                    <% if (due> 0 && isDueForReminder) { %>
                                        <div style="display:flex; gap:10px; margin-bottom: 10px;">
                                            <a href="https://wa.me/<%= customer.whatsappNumber %>?text=<%= encodedMsg %>"
                                                target="_blank"
                                                style="width:34px; height:34px; border-radius:50%; border:2px solid #e67e22; display:flex; align-items:center; justify-content:center; text-decoration:none;">
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" width="18"
                                                    height="18">
                                            </a>
                                            <a href="sms:+<%= customer.phone %>?body=<%= encodedMsg %>"
                                                style="width:34px; height:34px; border-radius:50%; border:2px solid #e67e22; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:16px;">💬</a>
                                            <a href="mailto:<%= customer.email %>?subject=Payment Reminder: <%= encodeURIComponent(customer.companyName) %>&body=<%= encodedMsg %>"
                                                style="width:34px; height:34px; border-radius:50%; border:2px solid #e67e22; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:16px;">📧</a>
                                        </div>
                                        <% } %>
                
                                            <% if (role==='admin' || role==='staff' ) { %>
                                                <button class="btn btn-blue transaction-btn" data-id="<%= customer._id %>"
                                                    data-company="<%= customer.companyName %>"
                                                    style="margin-bottom: 5px; width: 100%;">Update Balance 💳</button>
                                                <button class="btn btn-orange reminder-btn" data-id="<%= customer._id %>"
                                                    data-company="<%= customer.companyName %>"
                                                    style="margin-bottom: 5px; width: 100%;">Set Action Date 📅</button>
                                                <% } %>
                                                    <% if (role==='admin' ) { %>
                                                        <div style="display:flex; gap: 5px;">
                                                            <button class="btn btn-yellow edit-btn" style="flex:1;"
                                                                data-id="<%= customer._id %>" data-company="<%= customer.companyName %>"
                                                                data-contact="<%= customer.contactPerson %>"
                                                                data-email="<%= customer.email %>" data-phone="<%= customer.phone %>"
                                                                data-whatsapp="<%= customer.whatsappNumber %>"
                                                                data-other="<%= customer.otherNumbers %>">Edit ✏️</button>
                                                            <form action="/customers/<%= customer._id %>?_method=DELETE" method="POST"
                                                                style="margin:0;"
                                                                onsubmit="return confirm('Are you sure you want to permanently delete this customer?');">
                                                                <button type="submit" class="btn btn-red"
                                                                    style="padding: 5px 12px;">🗑️</button>
                                                            </form>
                                                        </div>
                                                        <% } %>
                                </td>
                
                                <td class="mobile-only">
                                    <div class="m-top">
                                        <div class="m-name">
                                            <strong>
                                                <%= customer.companyName %>
                                            </strong>
                                            <span>
                                                <%= customer.contactPerson %>
                                            </span>
                                        </div>
                                        <div class="m-fin">
                                            <div class="m-fin-top">Total ₹<%= customer.totalAmount %>
                                            </div>
                                            <% if (due> 0) { %><div class="m-fin-due">Due ₹<%= due %>
                                                </div>
                                                <% } %>
                                                    <div class="m-fin-paid">Paid ₹<%= customer.paidAmount %>
                                                    </div>
                                        </div>
                                    </div>
                
                                    <% if (due> 0 && isDueForReminder) { %>
                                        <div class="m-circles">
                                            <a href="https://wa.me/<%= customer.whatsappNumber %>?text=<%= encodedMsg %>"
                                                target="_blank" class="m-circle">
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WA"
                                                    width="22" height="22">
                                            </a>
                                            <a href="sms:+<%= customer.phone %>?body=<%= encodedMsg %>" class="m-circle">💬</a>
                                            <a href="mailto:<%= customer.email %>?subject=Payment Reminder: <%= encodeURIComponent(customer.companyName) %>&body=<%= encodedMsg %>"
                                                class="m-circle">📧</a>
                                        </div>
                                        <% } %>
                
                                            <div class="m-tools">
                                                <% if (role==='admin' || role==='staff' ) { %>
                                                    <button class="m-tool-btn transaction-btn" data-id="<%= customer._id %>"
                                                        data-company="<%= customer.companyName %>" title="Update Payment">💳</button>
                                                    <button class="m-tool-btn reminder-btn" data-id="<%= customer._id %>"
                                                        data-company="<%= customer.companyName %>"
                                                        title="Set Next Action Date">📅</button>
                                                    <% } %>
                
                                                        <% if (role==='admin' ) { %>
                                                            <button class="m-tool-btn edit-btn" data-id="<%= customer._id %>"
                                                                data-company="<%= customer.companyName %>"
                                                                data-contact="<%= customer.contactPerson %>"
                                                                data-email="<%= customer.email %>" data-phone="<%= customer.phone %>"
                                                                data-whatsapp="<%= customer.whatsappNumber %>"
                                                                data-other="<%= customer.otherNumbers %>"
                                                                title="Edit Customer Details">✏️</button>
                                                            <form action="/customers/<%= customer._id %>?_method=DELETE" method="POST"
                                                                style="margin:0;"
                                                                onsubmit="return confirm('Are you sure you want to permanently delete this customer?');">
                                                                <button type="submit" class="m-tool-btn" style="color:red;"
                                                                    title="Delete Customer">🗑️</button>
                                                            </form>
                                                            <% } %>
                                            </div>
                                </td>
                            </tr>
                            <% }) %>
                </tbody>
                </table>
    </div>

    <div id="transactionModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeTransactionModal()">&times;</span>
            <h3>Update Balance</h3>
            <p id="transCompanyName" style="font-weight:bold; color:#3498db;"></p>
            <form id="transactionForm" method="POST">
                <div class="trans-group">
                    <label class="trans-label">➕ Add New Purchase (Increases Debt)</label>
                    <input type="number" name="newPurchase" placeholder="Amount (₹)" class="input-style">
                </div>
                <div class="trans-group">
                    <label class="trans-label" style="color: green;">➖ Add Payment Received (Reduces Debt)</label>
                    <input type="number" name="payment" placeholder="Amount (₹)" class="input-style">
                </div>
                <button type="submit" class="btn btn-blue" style="width:100%; padding:10px;">Update Account</button>
            </form>
        </div>
    </div>

    <div id="actionModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeActionModal()">&times;</span>
            <h3>Set Next Action Date</h3>
            <p id="modalCompanyName" style="font-weight:bold;"></p>
            <form id="updateDateForm" method="POST">
                <label class="trans-label">Select New Date:</label>
                <input type="date" name="nextDate" required class="input-style">
                <button type="submit" class="btn btn-blue" style="width:100%; margin-top:10px;">Save Next Date</button>
            </form>
        </div>
    </div>

    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditModal()">&times;</span>
            <h3>Edit Customer Details</h3>
            <form id="editForm" method="POST">
                <label class="trans-label">Company Name</label>
                <input type="text" name="companyName" id="editCompany" required class="input-style">

                <label class="trans-label">Contact Person</label>
                <input type="text" name="contactPerson" id="editContact" required class="input-style">

                <label class="trans-label">Email</label>
                <input type="email" name="email" id="editEmail" class="input-style">

                <div class="form-row">
                    <div style="flex:1">
                        <label class="trans-label">Full Phone (with Code)</label>
                        <input type="text" name="phone" id="editPhone" required class="input-style">
                    </div>
                    <div style="flex:1">
                        <label class="trans-label">Full WhatsApp (with Code)</label>
                        <input type="text" name="whatsappNumber" id="editWhatsapp" required class="input-style">
                    </div>
                </div>

                <label class="trans-label">Other Numbers</label>
                <input type="text" name="otherNumbers" id="editOther" class="input-style">

                <button type="submit" class="btn btn-yellow" style="width:100%; padding:10px; font-weight:bold;">Save
                    Changes</button>
            </form>
        </div>
    </div>

    <script>
        // Transaction Logic
        document.querySelectorAll('.transaction-btn').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const company = this.getAttribute('data-company');
                document.getElementById('transactionModal').style.display = "block";
                document.getElementById('transCompanyName').innerText = company;
                document.getElementById('transactionForm').action = `/customers/${id}/transaction?_method=PUT`;
            });
        });

        // CLEANED UP Reminder/Date Logic
            document.querySelectorAll('.reminder-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const company = this.getAttribute('data-company');

                    document.getElementById('actionModal').style.display = "block";
                    document.getElementById('modalCompanyName').innerText = company;
                    document.getElementById('updateDateForm').action = `/customers/${id}/update-reminder?_method=PUT`;
                });
            });

        // NEW: EDIT LOGIC
        document.querySelectorAll('.edit-btn').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');

                // Pre-fill inputs with existing data
                document.getElementById('editCompany').value = this.getAttribute('data-company');
                document.getElementById('editContact').value = this.getAttribute('data-contact');
                document.getElementById('editEmail').value = this.getAttribute('data-email');
                document.getElementById('editPhone').value = this.getAttribute('data-phone');
                document.getElementById('editWhatsapp').value = this.getAttribute('data-whatsapp');
                document.getElementById('editOther').value = this.getAttribute('data-other');

                document.getElementById('editModal').style.display = "block";
                document.getElementById('editForm').action = `/customers/${id}/edit?_method=PUT`;
            });
        });

        function closeTransactionModal() { document.getElementById('transactionModal').style.display = "none"; }
        function closeActionModal() { document.getElementById('actionModal').style.display = "none"; }
        function closeEditModal() { document.getElementById('editModal').style.display = "none"; }

        window.onclick = function (event) {
            if (event.target == document.getElementById('actionModal')) closeActionModal();
            if (event.target == document.getElementById('transactionModal')) closeTransactionModal();
            if (event.target == document.getElementById('editModal')) closeEditModal();
        }
    </script>
</body>

</html>
