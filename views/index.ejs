                <span class="close"
                    onclick="document.getElementById('settingsModal').style.display='none'">&times;</span>
                <h3 style="margin-top: 0;">⚙️ Company Profile</h3>
                <form action="/settings?_method=PUT" method="POST">
                    <input type="text" name="companyName" placeholder="Company Name"
                        value="<%= adminUser.companyName || '' %>" class="input-style">
                    <input type="text" name="contactNo" placeholder="Contact No"
                        value="<%= adminUser.contactNo || '' %>" class="input-style">
                    <button type="submit" class="btn-primary" style="width:100%;">💾 Save Profile</button>
