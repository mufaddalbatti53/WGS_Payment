            <% var totalPending=0; var actionRequiredCount=0; var b_u30=0; var b_30_60=0; var b_60_90=0; var b_90_120=0;
                var b_120_150=0; var b_150_180=0; var b_a180=0; var b_onAcc=0; var td2=new Date();
                td2.setHours(0,0,0,0); for(var i=0; i<customers.length; i++) { var c=customers[i]; var due=c.totalAmount
