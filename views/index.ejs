                <span id="toastMsg">Success!</span>
            </div>
    
            <script>
                var isMobile = window.innerWidth <= 850;
                var activeFilter = { bucket: 'all', actionOnly: false };
                var mobileHistory = [];

                // --- NAVIGATION LOGIC WITH MEMORY ---
                function switchTab(tabId) {
                    if (isMobile) { openMobileSection(tabId); return; }
                    localStorage.setItem('activeWgsTab', tabId);
                    document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
                    var nav = document.getElementById('nav-' + tabId); if (nav) nav.classList.add('active');
                    document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active'));
                    var view = document.getElementById('view' + tabId.charAt(0).toUpperCase() + tabId.slice(1)); if (view) view.classList.add('active');
                }

                function renderMobileSection(sectionId, fromSection) {
                    localStorage.setItem('activeWgsTab', sectionId);
                    var launcher = document.getElementById('homeLauncher');
                    if (launcher) launcher.style.display = 'none';
                    document.querySelectorAll('.section-view').forEach(el => el.style.display = 'none');
                    var view = document.getElementById('view' + sectionId.charAt(0).toUpperCase() + sectionId.slice(1));
                    if (view) view.style.display = 'block';

                    var backBtn = document.getElementById('backBtn');
                    if (backBtn) {
                        backBtn.style.display = 'block';
                        if (sectionId === 'aging') backBtn.innerHTML = '← Home  |  📊 Aging Buckets';
                        else if (sectionId === 'parties' && fromSection === 'aging') backBtn.innerHTML = '← Back to Aging Buckets';
                        else if (sectionId === 'parties') backBtn.innerHTML = '← Home  |  🏢 Parties';
                        else if (sectionId === 'data') backBtn.innerHTML = '← Home  |  🗄️ Data Management';
                        else backBtn.innerHTML = '← Back';
                    }
                    window.scrollTo(0, 0);
                }

                function showMobileHome() {
                    localStorage.removeItem('activeWgsTab');
                    var launcher = document.getElementById('homeLauncher');
                    if (launcher) launcher.style.display = 'block';
                    document.querySelectorAll('.section-view').forEach(el => el.style.display = 'none');
                    var backBtn = document.getElementById('backBtn');
                    if (backBtn) backBtn.style.display = 'none';
                    if (typeof clearFilter === 'function') clearFilter();
                    window.scrollTo(0, 0);
                }

                function openMobileSection(sectionId, fromSection) {
                    if (!isMobile) return;
                    try { history.pushState({ wgsSection: sectionId, wgsFrom: fromSection || null }, '', location.pathname); } catch (e) {}
                    renderMobileSection(sectionId, fromSection);
                }

                function mobileBack() { history.back(); }

                window.addEventListener('popstate', function (e) {
                    if (!isMobile) return;
                    var st = e.state;
                    if (st && st.wgsSection) renderMobileSection(st.wgsSection, st.wgsFrom);
                    else showMobileHome();
                });

                // --- MODAL TRIGGERS ---
                function openEditModal(id, comp, cont, ph, wa, em, tot, paid, oth) {
                    document.getElementById('editComp').value = comp; document.getElementById('editCont').value = cont;
                    document.getElementById('editPhone').value = ph; document.getElementById('editWa').value = wa;
                    document.getElementById('editEmail').value = em; document.getElementById('editTotal').value = tot;
                    document.getElementById('editPaid').value = paid; document.getElementById('editOther').value = oth || '';
                    document.getElementById('editForm').action = '/customers/' + id + '/edit?_method=PUT';
                    document.getElementById('editModal').style.display = 'block';
                }

                function openActionModal(id, cname) {
                    document.getElementById('actionModalCompanyName').innerText = cname;
                    document.getElementById('updateDateForm').action = '/customers/' + id + '/update-reminder?_method=PUT';
                    document.getElementById('actionModal').style.display = 'block';
                }

                // --- FILTERING LOGIC ---
                function clickBucket(bucketKey, label, count, amtStr) {
                    activeFilter.bucket = bucketKey;
                    activeFilter.actionOnly = false;
                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) {
                        document.getElementById('filterActiveText').innerHTML = '📅 ' + label + ' &nbsp;|&nbsp; <strong>' + count + ' parties</strong> &nbsp;|&nbsp; ' + amtStr;
                        hdr.style.display = 'flex';
                    }
                    if (isMobile) openMobileSection('parties', 'aging'); else switchTab('parties');
                    runFilters();
                }

                function filterActionRequired() {
                    activeFilter.actionOnly = true;
                    activeFilter.bucket = 'all';
                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) {
                        document.getElementById('filterActiveText').innerHTML = '⚠️ Action Required Parties';
                        hdr.style.display = 'flex';
                    }
                    if (isMobile) openMobileSection('parties', 'aging'); else switchTab('parties');
                    runFilters();
                }

                function clearFilter() {
                    activeFilter = { bucket: 'all', actionOnly: false };
                    document.getElementById('filterAging').value = 'all';
                    document.getElementById('filterMin').value = '';
                    document.getElementById('filterMax').value = '';
                    document.getElementById('searchInput').value = '';
                    var hdr = document.getElementById('filterActiveHeader');
                    if (hdr) hdr.style.display = 'none';
                    runFilters();
                }

                function runFilters() {
                    var searchTxt = document.getElementById('searchInput').value.toLowerCase();
                    var bucket = document.getElementById('filterAging').value || activeFilter.bucket;
                    var min = parseFloat(document.getElementById('filterMin').value) || 0;
                    var max = parseFloat(document.getElementById('filterMax').value) || Infinity;

                    document.querySelectorAll('.customer-row').forEach(row => {
                        var isVis = true;
                        if (searchTxt && row.textContent.toLowerCase().indexOf(searchTxt) === -1) isVis = false;
                        if (activeFilter.actionOnly && row.getAttribute('data-action') !== 'true') isVis = false;

                        var totalDue = parseFloat(row.getAttribute('data-due')) || 0;
                        var checkVal = totalDue;

                        if (bucket !== 'all') {
                            var bucketAmt = parseFloat(row.getAttribute('data-' + bucket)) || 0;
                            checkVal = bucketAmt;
                            if (bucketAmt <= 0) isVis = false;
                            row.querySelectorAll('.dynamic-due').forEach(el => el.innerText = 'Bucket Due: ₹' + bucketAmt);
                            row.querySelectorAll('.dynamic-due-m').forEach(el => el.innerText = 'Bucket Due: ₹' + bucketAmt);
                        } else {
                            row.querySelectorAll('.dynamic-due').forEach(el => el.innerText = 'Due: ₹' + totalDue);
                            row.querySelectorAll('.dynamic-due-m').forEach(el => el.innerText = 'Due: ₹' + totalDue);
                        }

                        if (checkVal < min || checkVal > max) isVis = false;
                        if (isVis) row.classList.remove('d-none'); else row.classList.add('d-none');
                    });
                }

                // --- BULK SELECTION ---
                function toggleSelectAll() {
                    var cb = document.getElementById('selectAll');
                    var isChecked = cb ? !cb.checked : true;
                    if (cb) cb.checked = isChecked;
                    document.querySelectorAll('.customer-checkbox').forEach(box => {
                        if (!box.closest('tr').classList.contains('d-none')) box.checked = isChecked;
                    });
                    updateBulk();
                }

                document.querySelectorAll('.customer-checkbox').forEach(box => box.addEventListener('change', updateBulk));

                function updateBulk() {
                    var count = document.querySelectorAll('.customer-checkbox:checked').length;
                    var bar = document.getElementById('bulkActionBar');
                    if (bar) {
                        if (count > 0) { bar.classList.add('visible'); document.getElementById('selectedCount').innerText = count + ' Selected'; }
                        else { bar.classList.remove('visible'); }
                    }
                }

                function confirmBulkDelete() {
                    var selected = document.querySelectorAll('.customer-checkbox:checked');
                    if (confirm("Delete " + selected.length + " parties?")) {
                        var inputs = document.getElementById('hiddenInputs');
                        inputs.innerHTML = '';
                        selected.forEach(box => {
                            var i = document.createElement('input'); i.type = 'hidden'; i.name = 'customerIds'; i.value = box.value; inputs.appendChild(i);
                        });
                        document.getElementById('bulkForm').submit();
                    }
                }

                // --- DUPLICATE CHECKER ---
                var _dupCheckTimer = null;
                function checkDuplicate() {
                    var nameVal = document.getElementById('addCompanyName') ? document.getElementById('addCompanyName').value.trim() : '';
                    var phoneVal = document.getElementById('addPhone') ? document.getElementById('addPhone').value.trim() : '';
                    if (!nameVal && !phoneVal) { document.getElementById('addDupAlert').classList.remove('show'); return; }
                    clearTimeout(_dupCheckTimer);
                    _dupCheckTimer = setTimeout(function () {
                        fetch('/customers/check-duplicate?name=' + encodeURIComponent(nameVal) + '&phone=' + encodeURIComponent(phoneVal))
                            .then(r => {
                                if (r.status === 401) {
                                    window.location.href = '/login?error=' + encodeURIComponent("Session expired. Please log in again.");
                                    return;
                                }
                                return r.json();
                            })
                            .then(data => {
                                if (!data) return;
                                var alert = document.getElementById('addDupAlert');
                                var msg = document.getElementById('addDupMsg');
                                if (data.isDuplicate) {
                                    msg.innerText = 'A party with this ' + (data.matchReason === 'name' ? 'name' : 'phone') + ' already exists: "' + data.matchedName + '".';
                                    alert.classList.add('show');
                                } else { alert.classList.remove('show'); }
                            }).catch(e => { });
                    }, 500);
                }
                var addNameInput = document.getElementById('addCompanyName');
                var addPhoneInput = document.getElementById('addPhone');
                if (addNameInput) addNameInput.addEventListener('input', checkDuplicate);
                if (addPhoneInput) addPhoneInput.addEventListener('input', checkDuplicate);

                // --- WHATSAPP / SMS / EMAIL LOGIC ---
                function sendMsg(element, type) {
                    var id = element.getAttribute('data-id');
                    var phone = element.getAttribute('data-phone');
                    var wa = element.getAttribute('data-wa');
                    var email = element.getAttribute('data-email');
                    var cname = decodeURIComponent(element.getAttribute('data-cname') || '');
                    var pname = decodeURIComponent(element.getAttribute('data-pname') || '');
                    var admin = decodeURIComponent(element.getAttribute('data-admin') || '');
                    var total = element.getAttribute('data-total');
                    var paidamount = element.getAttribute('data-paidamount');
                    var lastpaid = decodeURIComponent(element.getAttribute('data-lastpaid') || '');
                    var due = element.getAttribute('data-due');
                    var diff = parseInt(element.getAttribute('data-diff') || '0');

                    var bName = "<%= adminUser.bankName || '' %>";
                    var aName = "<%= adminUser.accountName || '' %>";
                    var aNo = "<%= adminUser.accountNumber || '' %>";
                    var ifsc = "<%= adminUser.ifscCode || '' %>";
                    var upi = "<%= adminUser.upiDetails || '' %>";

                    var m = [];
                    var cStr = cname; if (pname && pname.length > 0) cStr += " (" + pname + ")";
                    m.push("Hello, this is " + admin + ".");
                    m.push("\nThis is a payment reminder for " + cStr + ".");
                    m.push("\n📊 *Account Summary:*");
                    m.push("- Total Bill Amount: Rs " + total);
                    var pStr = "Rs " + paidamount;
                    if (parseInt(paidamount) > 0 && lastpaid) pStr += " (Last paid: " + lastpaid + ")";
                    m.push("- Total Amount Paid: " + pStr);
                    m.push("- Current Outstanding Due: *Rs " + due + "*\n");

                    if (diff > 0) m.push("_It is " + diff + " days past the set action date._\n");
                    m.push("Please arrange the payment for the pending amount at your earliest convenience.\n");

                    if (bName || aNo || upi) {
                        m.push("🏦 *Payment Details:*");
                        if (bName) m.push("Bank: " + bName);
                        if (aName) m.push("Name: " + aName);
                        if (aNo) m.push("A/C No: " + aNo);
                        if (ifsc) m.push("IFSC: " + ifsc);
                        if (upi) m.push("UPI: " + upi);
                        m.push("");
                    }
                    m.push("Thank you,\n" + admin);

                    var encoded = encodeURIComponent(m.join('\n'));
                    if (type === 'wa') window.open('https://wa.me/' + wa + '?text=' + encoded, '_blank');
                    if (type === 'sms') window.open('sms:+' + phone + '?body=' + encoded, '_self');
                    if (type === 'email') window.open('mailto:' + email + '?subject=Payment Reminder&body=' + encoded, '_self');

                    var c1 = element.closest('.action-buttons'); var c2 = element.closest('.m-circles');
                    if (c1) c1.style.display = 'none'; if (c2) c2.style.display = 'none';
                    var row = element.closest('tr'); if (row) row.querySelectorAll('.req-badge').forEach(n => n.style.display = 'none');

                    fetch('/customers/' + id + '/auto-snooze', { method: 'POST' }).catch(e => { });
                }

                // --- GOOGLE DRIVE INTEGRATION ---
                function triggerDriveBackup() {
                    alert("Backing up to Google Drive in the background...");
                    fetch('/drive-backup')
                        .then(response => {
                            if (response.status === 401) {
                                window.location.href = '/login?error=' + encodeURIComponent("Session expired. Please log in again.");
                                return;
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (!data) return;
                            if (data.redirect) { window.location.href = data.redirect; return; }
                            if (data.success) alert("✅ " + data.message);
                            else alert("❌ Backup failed. " + (data.message || "Did you Link your Google Drive first?"));
                        }).catch(e => alert("Error communicating with server."));
                }

                function triggerDriveRestore() {
                    if (confirm("⚠️ WARNING: This will overwrite your current parties with your latest cloud backup. Proceed?")) {
                        showToast("⏳ Downloading backup from Google Drive...");
                        fetch('/drive-restore', { method: 'POST' })
                            .then(response => {
                                if (response.status === 401) {
                                    window.location.href = '/login?error=' + encodeURIComponent("Session expired. Please log in again.");
                                    return;
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (!data) return;
                                if (data.redirect) { window.location.href = data.redirect; return; }
                                if (data.success) {
                                    alert("✅ " + data.message);
                                    window.location.reload();
                                } else {
                                    alert("❌ " + data.message);
                                }
                            }).catch(e => alert("Error communicating with server."));
                    }
                }

                function showLoadingBtn(form, btnId, loadingText) {
                    var btn = document.getElementById(btnId);
                    if (btn) { btn.innerHTML = loadingText; btn.style.opacity = '0.6'; btn.style.pointerEvents = 'none'; }
                    return true;
                }

                function showToast(msg) {
                    var t = document.getElementById('toast');
                    document.getElementById('toastMsg').innerText = msg;
                    t.style.display = 'flex';
                    setTimeout(() => { t.style.display = 'none'; }, 4000);
                }

                // --- PROFESSIONAL TALLY-STYLE PDF EXPORT ---
                function downloadPDF() {
                    showToast("⏳ Generating professional PDF...");
                    const element = document.createElement('div');
                    element.style.padding = "20px";
                    element.style.fontFamily = "Arial, sans-serif";

                    const profile = {
                        name: "<%= adminUser.companyName || 'Company Name' %>",
                        addr: "<%= adminUser.addressLine1 || '' %> <%= adminUser.addressLine2 || '' %>"
                    };

                    const date = new Date();
                    const startYear = date.getMonth() < 3 ? date.getFullYear() - 1 : date.getFullYear();
                    const dateRange = `1-Apr-${startYear} to 31-Mar-${startYear + 1}`;

                    let html = `
                <div style="text-align:center; margin-bottom: 20px;">
                    <h1 style="margin:0; font-size: 24px; color: #000;">${profile.name}</h1>
                    <p style="margin:5px 0; font-size: 14px; color: #333;">${profile.addr}</p>
                    <h2 style="margin:15px 0 5px 0; font-size: 18px; color: #000;">Sundry Debtors - Group Outstandings</h2>
                    <p style="margin:0; font-size: 13px; font-weight: bold; color: #000;">${dateRange}</p>
                </div>
                <table border="1" style="width:100%; border-collapse: collapse; font-size: 10px; text-align: right; border-color: #000;">
                    <thead>
                        <tr style="background:#f8fafc;">
                            <th rowspan="2" style="padding: 6px; text-align: left; border-color: #000;">Party Name</th>
                            <th rowspan="2" style="padding: 6px; text-align: left; border-color: #000;">Telephone No.</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">Pending Bills</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">(< 30 days)</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">30 to 60 days</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">60 to 90 days</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">90 to 120 days</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">120 to 180 days</th>
                            <th style="padding: 6px; text-align: right; border-color: #000;">(> 180 days)</th>
                        </tr>
                        <tr style="background:#f8fafc;">
                            <th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th><th style="padding: 4px; border-color: #000;">Debit</th>
                        </tr>
                    </thead>
                    <tbody>
                `;

                    (document.querySelectorAll('.customer-row:not(.d-none)') || []).forEach(row => {
                        let strongEl = row ? row.querySelector('strong') : null;
                        let partyNameText = strongEl ? (strongEl.innerText || '') : 'Party';
                        let phoneCell = (row && row.children && row.children.length > 2) ? row.children[2] : null;
                        let phoneText = "";
                        if (phoneCell && phoneCell.innerText) {
                            phoneText = phoneCell.innerText.replace('P:', '').replace('W:', ',').replace(/\n/g, '').trim();
                        }

                        let dueVal = row ? (row.getAttribute('data-due') || '0') : '0';
                        let u30Val = row ? (row.getAttribute('data-u30') || '0') : '0';
                        let d30_60Val = row ? (row.getAttribute('data-d30_60') || '0') : '0';
                        let d60_90Val = row ? (row.getAttribute('data-d60_90') || '0') : '0';
                        let d90_120Val = row ? (row.getAttribute('data-d90_120') || '0') : '0';
                        let d120_150Val = row ? (row.getAttribute('data-d120_150') || '0') : '0';
                        let a180Val = row ? (row.getAttribute('data-a180') || '0') : '0';

                        html += `
                    <tr>
                        <td style="padding: 6px; text-align: left; border-color: #000;">${partyNameText}</td>
                        <td style="padding: 6px; text-align: left; border-color: #000;">${phoneText}</td>
                        <td style="padding: 6px; border-color: #000;">${dueVal}</td>
                        <td style="padding: 6px; border-color: #000;">${u30Val}</td>
                        <td style="padding: 6px; border-color: #000;">${d30_60Val}</td>
                        <td style="padding: 6px; border-color: #000;">${d60_90Val}</td>
                        <td style="padding: 6px; border-color: #000;">${d90_120Val}</td>
                        <td style="padding: 6px; border-color: #000;">${d120_150Val}</td>
                        <td style="padding: 6px; border-color: #000;">${a180Val}</td>
                    </tr>
                    `;
                    });

                    html += `</tbody></table>`;
                    element.innerHTML = html;

                    const opt = {
                        margin: 0.5,
                        filename: `${profile.name}_Aging_Report.pdf`,
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2 },
                        jsPDF: { unit: 'in', format: 'letter', orientation: 'landscape' }
                    };

                    html2pdf().set(opt).from(element).save().then(() => {
                        showToast("✅ PDF Downloaded!");
                    });
                }

                // --- PAGE LOAD INITIALIZATION ---
                window.onload = function () {
                    var params = new URLSearchParams(window.location.search);

                    if (params.get('driveConnected') === 'true') {
                        alert("✅ Google Drive linked successfully! You can now click 'Backup Now'.");
                        window.history.replaceState({}, document.title, '/');
                    }

                    if (params.get('dup') === '1') {
                        var warn = document.getElementById('dupWarning');
                        if (warn) { document.getElementById('dupWarningText').innerText = '⚠️ Duplicate Blocked: "' + decodeURIComponent(params.get('dupname') || '') + '" already exists.'; warn.style.display = 'flex'; }
                        window.history.replaceState({}, document.title, '/');
                    }

                    if (params.get('msg')) {
                        showToast("✅ Action Completed Successfully!");
                        window.history.replaceState({}, document.title, '/');
                    }

                    var savedTab = localStorage.getItem('activeWgsTab') || 'aging';
                    if (!isMobile) {
                        switchTab(savedTab);
                    } else if (params.get('from') === 'login') {
                        window.history.replaceState({ wgsSection: null }, document.title, '/');
                        showMobileHome();
                    } else if (history.state && Object.prototype.hasOwnProperty.call(history.state, 'wgsSection')) {
                        // Returning via back/forward: restore exactly what this history entry showed
                        if (history.state.wgsSection) renderMobileSection(history.state.wgsSection, history.state.wgsFrom);
                        else showMobileHome();
                    } else if (savedTab && savedTab !== 'home' && document.getElementById('view' + savedTab.charAt(0).toUpperCase() + savedTab.slice(1))) {
                        // Fresh load: put Home underneath so Back goes to Home, never to another page
                        window.history.replaceState({ wgsSection: null }, document.title, location.pathname);
                        window.history.pushState({ wgsSection: savedTab, wgsFrom: null }, document.title, location.pathname);
                        renderMobileSection(savedTab);
                    } else {
                        window.history.replaceState({ wgsSection: null }, document.title, location.pathname);
                        showMobileHome();
                    }
                };
            </script>
            </body>
    
            </html>