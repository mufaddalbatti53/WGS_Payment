<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#27ae60">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <meta charset="UTF-8">
    <title>Staff Management</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .btn {
            padding: 10px 15px;
            cursor: pointer;
            border: none;
            border-radius: 4px;
            color: white;
            font-weight: bold;
        }

        .btn-back {
            background: #555;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
            padding: 8px 15px;
            border-radius: 4px;
            color: white;
        }

        .staff-card {
            background: #f9f9f9;
            padding: 15px;
            border: 1px solid #ddd;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 4px;
        }

        input {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* PASSWORD CONTAINER STYLE */
        .password-container {
            position: relative;
            display: inline-block;
        }

        /* The Eye Icon Style */
        .toggle-password {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 16px;
            color: #777;
            user-select: none;
        }
    </style>
</head>

<body>

    <a href="/" class="btn-back">← Back to Dashboard</a>

    <div class="container">
        <h1>Staff Management</h1>

        <div
            style="background: #e1f5fe; padding: 20px; border-radius: 4px; margin-bottom: 30px; border: 1px solid #b3e5fc;">
            <h3>Create New Staff</h3>

            <form action="/create-staff" method="POST"
                style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <input type="text" name="username" placeholder="Username" required style="flex: 1;">

                <div class="password-container" style="flex: 1;">
                    <input type="password" name="password" id="staffPassword" placeholder="Password" required
                        style="width: 100%; box-sizing: border-box;">
                    <span class="toggle-password" onclick="togglePassword()">👁️</span>
                </div>

                <button type="submit" class="btn" style="background:#0288d1;">Create Staff</button>
            </form>
        </div>

        <h3>Existing Staff Members</h3>
        <% if (staffMembers.length===0) { %>
            <p>No staff found.</p>
            <% } %>

                <% staffMembers.forEach(staff=> { %>
                    <div class="staff-card">
                        <span style="font-size: 1.2em;"><strong>
                                <%= staff.username %>
                            </strong></span>

                        <div style="display: flex; gap: 10px; align-items: center;">
                            <form action="/reset-staff-password" method="POST" style="display: flex; gap: 5px;">
                                <input type="hidden" name="staffId" value="<%= staff._id %>">
                                <input type="text" name="newPassword" placeholder="New Pass" required
                                    style="width: 100px;">
                                <button type="submit" class="btn"
                                    style="background: #f39c12; font-size: 12px;">Reset</button>
                            </form>

                            <form action="/staff/<%= staff._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn"
                                    style="background: #e74c3c; font-size: 12px;">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('staffPassword');
            const icon = document.querySelector('.toggle-password');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text'; // Show text
                icon.innerText = '🔒'; // Change to lock
            } else {
                passwordInput.type = 'password'; // Hide text
                icon.innerText = '👁️'; // Change to eye
            }
        }
    </script>

</body>

</html>