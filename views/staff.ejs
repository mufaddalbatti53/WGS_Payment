<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Manage Staff</title>
    <meta name="theme-color" content="#27ae60">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

       .container { 
            max-width: 800px; 
            margin: 0 auto; 
            background: white; 
            padding: 20px; 
            border-radius: 16px; /* Much rounder */
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08); /* Deep, soft floating shadow */
        }

        h1 {
            margin-top: 0;
        }

        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .btn-blue {
            background: #3498db;
        }

        .btn-red {
            background: #e74c3c;
        }

        .btn-green {
            background: #27ae60;
        }

        .input-style {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        /* Desktop Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #eee;
        }

        /* Mobile Card View */
        @media screen and (max-width: 768px) {

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            thead tr {
                display: none;
            }

            tr { 
                background: #fff; 
                border: 2px solid #3498db; 
                border-radius: 16px; /* Much rounder */
                margin-bottom: 20px; 
                padding: 15px; 
                position: relative; 
                /* Tinted blue shadow to make the staff card float */
                box-shadow: 0 8px 24px rgba(52, 152, 219, 0.15); 
            }
            td {
                border: none !important;
                padding: 5px 0 !important;
            }

            .desktop-only {
                display: none !important;
            }

            .mobile-only {
                display: block !important;
            }

            .staff-card-header {
                font-size: 18px;
                font-weight: bold;
                color: #333;
                margin-bottom: 10px;
                border-bottom: 1px solid #eee;
                padding-bottom: 5px;
            }

            .staff-actions {
                display: flex;
                gap: 10px;
                margin-top: 15px;
            }

            .staff-actions form {
                flex: 1;
                margin: 0;
            }

            .staff-actions button {
                width: 100%;
            }
        }

        @media screen and (min-width: 769px) {
            .mobile-only {
                display: none !important;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <a href="/" style="text-decoration: none; color: #3498db; font-weight: bold;">&larr; Back to Dashboard</a>
        <h1 style="margin-top: 15px;">👤 Manage Staff</h1>

        <div
            style="background: #f8f9fa; padding: 20px; border-radius: 16px; margin-bottom: 25px; box-shadow: 0 6px 15px rgba(0,0,0,0.05); border: 1px solid #eee;">
            <h3>Create New Staff Account</h3>
            <form action="/create-staff" method="POST">
                <input type="text" name="username" placeholder="Staff Username" required class="input-style">
                <input type="text" name="password" placeholder="Staff Password" required class="input-style">
                <button type="submit" class="btn btn-green" style="width: 100%;">Create Account</button>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Reset Password</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <% staffMembers.forEach(staff=> { %>
                    <tr>
                        <td class="desktop-only"><strong>
                                <%= staff.username %>
                            </strong></td>
                        <td class="desktop-only"><span
                                style="background: #3498db; color: white; padding: 3px 8px; border-radius: 4px; font-size: 12px;">
                                <%= staff.role.toUpperCase() %>
                            </span></td>
                        <td class="desktop-only">
                            <form action="/reset-staff-password" method="POST" style="display:flex; gap:5px;">
                                <input type="hidden" name="staffId" value="<%= staff._id %>">
                                <input type="text" name="newPassword" placeholder="New Password" required
                                    style="padding:5px; border:1px solid #ccc; border-radius:4px;">
                                <button type="submit" class="btn btn-blue" style="padding: 5px 10px;">Reset</button>
                            </form>
                        </td>
                        <td class="desktop-only">
                            <form action="/staff/<%= staff._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Delete this staff member permanently?');">
                                <button type="submit" class="btn btn-red" style="padding: 5px 10px;">Delete</button>
                            </form>
                        </td>

                        <td class="mobile-only">
                            <div class="staff-card-header">
                                👤 <%= staff.username %>
                                    <span
                                        style="float: right; background: #3498db; color: white; padding: 2px 6px; border-radius: 4px; font-size: 11px;">
                                        <%= staff.role.toUpperCase() %>
                                    </span>
                            </div>

                            <div style="margin-top: 10px;">
                                <form action="/reset-staff-password" method="POST" style="display: flex; gap: 5px;">
                                    <input type="hidden" name="staffId" value="<%= staff._id %>">
                                    <input type="text" name="newPassword" placeholder="Type new password..." required
                                        class="input-style" style="margin-bottom: 0; flex: 2;">
                                    <button type="submit" class="btn btn-blue" style="flex: 1;">Reset</button>
                                </form>
                            </div>

                            <div class="staff-actions">
                                <form action="/staff/<%= staff._id %>?_method=DELETE" method="POST"
                                    onsubmit="return confirm('Delete this staff member permanently?');">
                                    <button type="submit" class="btn btn-red">🗑️ Delete Account</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</body>

</html>