<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2c3e50">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" href="/images/WGS.png" type="image/png">
    <link rel="apple-touch-icon" href="/images/WGS.png">
    <meta charset="UTF-8">
    <title>Login Portal</title>
    <style>
        :root {
            --primary: #27ae60;
            --primary-dark: #219653;
            --secondary: #3498db;
            --bg-color: #f4f6f9;
            --text-dark: #2c3e50;
            --text-muted: #64748b;
            --shadow-soft: 0 12px 35px rgba(44, 62, 80, 0.08);
            --shadow-btn: 0 6px 15px rgba(39, 174, 96, 0.3);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .login-container {
            background: white;
            width: 100%;
            max-width: 380px;
            padding: 40px;
            border-radius: 24px;
            box-shadow: var(--shadow-soft);
            border: 1px solid rgba(44, 62, 80, 0.1);
            text-align: center;
        }

        h2 {
            margin-top: 0;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 26px;
            margin-bottom: 25px;
        }

        .tabs {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
            border-bottom: 2px solid #f1f5f9;
        }

        .tab {
            cursor: pointer;
            padding: 10px 0 12px 0;
            width: 50%;
            color: var(--text-muted);
            font-weight: bold;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        .tab.active {
            border-bottom: 3px solid var(--primary);
            color: var(--primary-dark);
            margin-bottom: -2px;
        }

        .form-box {
            display: none;
        }

        .form-box.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .input-group {
            margin: 15px 0;
            position: relative;
        }

        input {
            width: 100%;
            padding: 14px 15px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            font-size: 14px;
            background: #f8fafc;
            transition: all 0.3s ease;
            outline: none;
            color: var(--text-dark);
        }

        input:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.15);
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
            color: var(--text-muted);
            user-select: none;
        }

        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
            margin-top: 15px;
            box-shadow: var(--shadow-btn);
            transition: all 0.2s ease;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4);
        }

        .btn-customer {
            background: linear-gradient(135deg, var(--secondary), #2980b9);
            box-shadow: 0 6px 15px rgba(52, 152, 219, 0.3);
        }

        .btn-customer:hover {
            box-shadow: 0 8px 20px rgba(52, 152, 219, 0.4);
        }

        .alert {
            color: #ef4444;
            font-size: 13px;
            font-weight: bold;
            background: #fee2e2;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .link-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
        }

        .link {
            font-size: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

        .link:hover {
            color: var(--primary-dark);
        }

        .link-forgot {
            color: var(--secondary);
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h2>Welcome Back</h2>

        <div class="tabs">
            <div class="tab active" onclick="switchTab('staff', event)">Admin / Staff</div>
            <div class="tab" onclick="switchTab('customer', event)">Customer View</div>
        </div>

        <% if (error) { %>
            <div class="alert">⚠️ <%= error %>
            </div>
            <% } %>

                <div id="staff" class="form-box active">
                    <form action="/login" method="POST">
                        <input type="hidden" name="type" value="staff">
                        <div class="input-group"><input type="text" name="username" placeholder="Username" required>
                        </div>
                        <div class="input-group">
                            <input type="password" name="password" id="passwordInput" placeholder="Password" required>
                            <span class="toggle-password" onclick="togglePassword()">👁️</span>
                        </div>
                        <button type="submit">Sign In</button>
                        <div class="link-row">
                            <a href="/register" class="link">Request Admin Access</a>
                            <a href="/forgot-password" class="link link-forgot">Forgot Password?</a>
                        </div>
                    </form>
                </div>

                <div id="customer" class="form-box">
                    <form action="/login" method="POST">
                        <input type="hidden" name="type" value="customer">
                        <div class="input-group">
                            <input type="text" name="phone" placeholder="Enter Phone (e.g. 9198...)" required>
                        </div>
                        <button type="submit" class="btn-customer">Track My Payment</button>
                    </form>
                    <p style="font-size: 11px; color: var(--text-muted); margin-top: 15px; line-height: 1.5;">
                        *Please enter the exact phone number registered with your vendor, including the country code.
                    </p>
                </div>
    </div>

    <script>
        function switchTab(tabName, evt) {
            document.querySelectorAll('.form-box').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
            const targetForm = document.getElementById(tabName);
            if (targetForm) targetForm.classList.add('active');
            const targetBtn = (evt && evt.target) ? evt.target : document.querySelector(`.tab[onclick*="${tabName}"]`);
            if (targetBtn) targetBtn.classList.add('active');
        }

        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const icon = document.querySelector('.toggle-password');
            if (passwordInput.type === 'password') { passwordInput.type = 'text'; icon.innerText = '🔒'; }
            else { passwordInput.type = 'password'; icon.innerText = '👁️'; }
        }
    </script>
</body>

</html>