<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Activity Log</title>
    <meta name="theme-color" content="#f97316">
    <style>
        /* ========================================= */
        /* 🎨 GLOBAL & THEME (ORANGE BASE)           */
        /* ========================================= */
        :root {
            --primary: #f97316;
            /* Bright Orange */
            --primary-dark: #ea580c;
            /* Deep Orange */
            --primary-light: #fff7ed;
            /* Very Light Orange background */
            --bg-color: #fdfbf7;
            /* Warm Off-White for body */
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --card-bg: #ffffff;
            --shadow-soft: 0 10px 30px rgba(234, 88, 12, 0.06);
            --shadow-hover: 0 20px 40px rgba(234, 88, 12, 0.12);
            --shadow-btn: 0 6px 15px rgba(249, 115, 22, 0.3);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 20px;
            background: var(--bg-color);
            color: var(--text-dark);
            margin: 0;
        }

        .main-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            padding-bottom: 50px;
        }

        /* The completely reimagined floating card class */
        .floating-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 25px;
            box-shadow: var(--shadow-soft);
            margin-bottom: 25px;
            border: 1px solid rgba(249, 115, 22, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .back-link {
            display: inline-block;
            text-decoration: none;
            color: var(--primary-dark);
            font-weight: bold;
            margin-bottom: 15px;
            padding: 8px 15px;
            background: var(--primary-light);
            border-radius: 20px;
            transition: background 0.2s;
        }

        .back-link:hover {
            background: #ffedd5;
        }

        h1 {
            margin-top: 0;
            color: var(--text-dark);
            font-size: 28px;
            font-weight: 800;
        }

        /* ========================================= */
        /* 🟠 BUTTONS & INPUTS                       */
        /* ========================================= */
        .input-style {
            padding: 12px 15px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
            background: #f8fafc;
            transition: all 0.2s;
            outline: none;
        }

        .input-style:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
        }

        .btn-red {
            background: #ef4444;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-red:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }

        /* ========================================= */
        /* 📋 TABLE STYLING                          */
        /* ========================================= */
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 14px;
        }

        th {
            background: var(--primary-light);
            color: var(--primary-dark);
            font-weight: bold;
            padding: 15px 12px;
            text-align: left;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

        th:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        th:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        td {
            padding: 15px 12px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: top;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .action-text {
            font-weight: 800;
            color: var(--primary);
        }

        /* ========================================= */
        /* 📱 MOBILE VIEW ("UTH KE AANA" EFFECT)     */
        /* ========================================= */
        @media screen and (max-width: 768px) {

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            thead tr {
                display: none;
            }

            .floating-card {
                padding: 15px;
            }

            /* The Mobile "Floating" Log Card */
            tr {
                background: #ffffff;
                border-radius: 20px;
                margin-bottom: 20px;
                padding: 20px;
                border: 1px solid rgba(249, 115, 22, 0.1);
                box-shadow: 0 12px 35px rgba(234, 88, 12, 0.12);
                /* Massive Orange Shadow */
            }

            td {
                border: none !important;
                padding: 0 !important;
            }

            .desktop-only {
                display: none !important;
            }

            .mobile-only {
                display: block !important;
            }

            .log-header {
                display: flex;
                justify-content: space-between;
                margin-bottom: 12px;
                align-items: flex-start;
            }

            .log-action {
                font-size: 16px;
                font-weight: 800;
                color: var(--primary-dark);
            }

            .log-date {
                font-size: 12px;
                color: var(--text-muted);
                text-align: right;
                line-height: 1.4;
            }

            .log-user {
                margin-bottom: 12px;
                font-size: 14px;
                color: var(--text-dark);
                border-bottom: 1px dashed #e2e8f0;
                padding-bottom: 10px;
            }

            .log-details {
                font-size: 14px;
                color: var(--text-dark);
                background: #f8fafc;
                padding: 15px;
                border-radius: 12px;
                border: 1px solid #e2e8f0;
                line-height: 1.5;
            }

            #bulkFormContainer {
                flex-direction: column;
            }

            .btn-red {
                width: 100%;
            }
        }

        @media screen and (min-width: 769px) {
            .mobile-only {
                display: none !important;
            }
        }
    </style>
</head>

<body>
    <div class="main-wrapper">
        <a href="/" class="back-link">&larr; Back to Dashboard</a>
        <h1 style="margin-top: 10px; margin-bottom: 20px;">📜 Activity Log</h1>

        <div class="floating-card">
            <input type="text" id="activitySearch" class="input-style"
                placeholder="🔍 Search logs by user, action, or details..." style="font-size: 16px;">

            <% if (role==='admin' ) { %>
                <form action="/activity/delete-bulk" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete these logs permanently?');"
                    style="margin-top: 15px; padding-top: 20px; border-top: 1px dashed #e2e8f0;">
                    <strong
                        style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 10px; text-transform: uppercase;">🗑️
                        Bulk Clear Logs</strong>

                    <div id="bulkFormContainer" style="display: flex; gap: 10px; align-items: center;">
                        <select name="filterType" id="filterType" class="input-style"
                            style="flex: 1; min-width: 180px; margin-bottom: 0;" onchange="toggleCustomDates()">
                            <option value="older_than_30">Older than 30 Days</option>
                            <option value="last_30">Last 30 Days</option>
                            <option value="custom">Custom Date Range</option>
                            <option value="all">Delete ALL Logs</option>
                        </select>

                        <div id="customDateBoxes" style="display: none; flex: 2; gap: 10px; align-items: center;">
                            <input type="date" name="startDate" class="input-style" style="margin-bottom: 0;">
                            <span style="color: var(--text-muted); font-weight: bold;">to</span>
                            <input type="date" name="endDate" class="input-style" style="margin-bottom: 0;">
                        </div>

                        <button type="submit" class="btn-red">Clear Now</button>
                    </div>
                </form>
                <% } %>
        </div>

        <script>
            function toggleCustomDates() {
                const type = document.getElementById('filterType').value;
                document.getElementById('customDateBoxes').style.display = (type === 'custom') ? 'flex' : 'none';
            }

            document.getElementById('activitySearch').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    let text = row.innerText.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        </script>

        <div class="floating-card" style="padding: 0; overflow-x: auto;">
            <table style="margin-top: 0;">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <% activities.forEach(log=> { %>
                        <% const rawDate=log.createdAt || log.date || log.timestamp; const hasValidDate=rawDate ? true :
                            false; const validDate=hasValidDate ? new Date(rawDate) : null; %>
                            <tr>
                                <td class="desktop-only"
                                    style="white-space: nowrap; color: var(--text-muted); font-size: 13px;">
                                    <% if (hasValidDate) { %>
                                        <%= validDate.toLocaleDateString('en-IN') %><br>
                                            <span style="font-weight: bold; color: var(--text-dark);">
                                                <%= validDate.toLocaleTimeString('en-IN', { hour: '2-digit' ,
                                                    minute: '2-digit' }) %>
                                            </span>
                                            <% } else { %>
                                                <span style="color:#cbd5e1;">Unknown</span>
                                                <% } %>
                                </td>
                                <td class="desktop-only" style="font-weight: 600; color: var(--text-dark);">
                                    <%= log.username || 'Admin' %>
                                </td>
                                <td class="desktop-only action-text">
                                    <%= log.action %>
                                </td>
                                <td class="desktop-only" style="color: var(--text-muted); line-height: 1.4;">
                                    <%= log.details %>
                                </td>

                                <td class="mobile-only">
                                    <div class="log-header">
                                        <div class="log-action">
                                            <%= log.action %>
                                        </div>
                                        <div class="log-date">
                                            <% if (hasValidDate) { %>
                                                <%= validDate.toLocaleDateString('en-IN') %><br>
                                                    <strong style="color: var(--text-dark);">
                                                        <%= validDate.toLocaleTimeString('en-IN', { hour: '2-digit' ,
                                                            minute: '2-digit' }) %>
                                                    </strong>
                                                    <% } else { %>
                                                        <span style="color:#cbd5e1;">Date Unknown</span>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <div class="log-user">
                                        👤 <strong>
                                            <%= log.username || 'Admin' %>
                                        </strong>
                                    </div>
                                    <div class="log-details">
                                        <%= log.details %>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>

</html>