<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Activity Log</title>
    <meta name="theme-color" content="#9b59b6">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

        /* 1. The Floating Main Container */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 16px;
            /* Premium roundness */
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
            /* Deep floating shadow */
        }

        h1 {
            margin-top: 0;
            color: #333;
        }

        /* Desktop Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 14px;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #eee;
        }

        .action-text {
            font-weight: bold;
            color: #9b59b6;
        }

        /* ========================================= */
        /* 📱 MOBILE VIEW (Floating Purple Cards)    */
        /* ========================================= */
        @media screen and (max-width: 768px) {

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            thead tr {
                display: none;
            }

            /* The Uppish Card Design */
            tr {
                background: #fff;
                border: 2px solid #9b59b6;
                /* Purple theme */
                border-radius: 16px;
                margin-bottom: 15px;
                padding: 15px;
                position: relative;
                box-shadow: 0 8px 24px rgba(155, 89, 182, 0.15);
                /* Soft purple floating shadow */
            }

            td {
                border: none !important;
                padding: 0 !important;
            }

            .desktop-only {
                display: none !important;
            }

            .mobile-only {
                display: block !important;
            }

            /* Card Internal Layout */
            .log-header {
                display: flex;
                justify-content: space-between;
                margin-bottom: 8px;
                align-items: flex-start;
            }

            .log-action {
                font-size: 16px;
                font-weight: bold;
                color: #9b59b6;
            }

            .log-date {
                font-size: 12px;
                color: #777;
                text-align: right;
                line-height: 1.2;
            }

            .log-user {
                margin-bottom: 10px;
                font-size: 14px;
                color: #444;
                border-bottom: 1px solid #eee;
                padding-bottom: 8px;
            }

            .log-details {
                font-size: 14px;
                color: #222;
                background: #f9f9f9;
                padding: 12px;
                border-radius: 12px;
                border: 1px solid #eee;
                line-height: 1.4;
            }
        }

        /* Hide mobile on Desktop */
        @media screen and (min-width: 769px) {
            .mobile-only {
                display: none !important;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <a href="/" style="text-decoration: none; color: #3498db; font-weight: bold;">&larr; Back to Dashboard</a>
        <h1 style="margin-top: 15px;">📜 Activity Log</h1>

        <table>
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <% activities.forEach(log=> { %>
                    <tr>
                        <td class="desktop-only" style="white-space: nowrap; color: #555;">
                            <%= new Date(log.createdAt).toLocaleString('en-IN') %>
                        </td>
                        <td class="desktop-only">
                            <strong>
                                <%= log.username || 'Admin' %>
                            </strong>
                        </td>
                        <td class="desktop-only action-text">
                            <%= log.action %>
                        </td>
                        <td class="desktop-only">
                            <%= log.details %>
                        </td>

                        <td class="mobile-only">
                            <div class="log-header">
                                <div class="log-action">
                                    <%= log.action %>
                                </div>
                                <div class="log-date">
                                    <%= new Date(log.createdAt).toLocaleDateString('en-IN') %><br>
                                        <strong>
                                            <%= new Date(log.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit' ,
                                                minute: '2-digit' }) %>
                                        </strong>
                                </div>
                            </div>
                            <div class="log-user">
                                👤 <strong>
                                    <%= log.username || 'Admin' %>
                                </strong>
                            </div>
                            <div class="log-details">
                                <%= log.details %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</body>

</html>