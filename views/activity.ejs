<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Activity Log</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .btn-back {
            background: #555;
            color: white;
            padding: 8px 15px;
            text-decoration: none;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #eee;
        }

        tr:hover {
            background: #f9f9f9;
        }
        @media screen and (max-width: 768px) {
    table, thead, tbody, th, td, tr { display: block; }
    thead tr { display: none; } /* Hide the top header row */

    tr { background: #fff; border: 2px solid #ddd; border-radius: 10px; margin-bottom: 20px; padding: 15px; }

    /* The padding-left creates space for the label */
    td { border: none; border-bottom: 1px solid #eee; position: relative; padding-left: 35% !important; text-align: left !important; }

    /* Add labels on the left side of the mobile card */
    td::before { 
        content: attr(data-label); 
        position: absolute; left: 0; width: 30%; 
        text-align: left; font-weight: bold; color: #555; 
    }
}
    </style>
</head>

<body>

    <a href="/" class="btn-back">← Back to Dashboard</a>

    <div class="container">
        <h1>Activity Log</h1>
        <p>Showing last 50 actions performed by Admin and Staff.</p>

        <table>
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <% activities.forEach(act=> { %>
                    <tr>
                        <td data-label="Date:">
                            <%= act.date.toLocaleString() %>
                        </td>
                        <td data-label="User:"><strong>
                                <%= act.username %>
                            </strong></td>
                        <td data-label="Action:">
                            <%= act.action %>
                        </td>
                        <td data-label="Details:">
                            <%= act.details %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

</body>


</html>
