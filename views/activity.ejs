<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Activity Log</title>
    <meta name="theme-color" content="#9b59b6">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
            background: #f4f4f9;
        }

        /* 1. The Floating Main Container */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 16px;
            /* Premium roundness */
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
            /* Deep floating shadow */
        }

        h1 {
            margin-top: 0;
            color: #333;
        }

        /* Desktop Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 14px;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #eee;
        }

        .action-text {
            font-weight: bold;
            color: #9b59b6;
        }

        /* ========================================= */
        /* 📱 MOBILE VIEW (Floating Purple Cards)    */
        /* ========================================= */
        @media screen and (max-width: 768px) {

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            thead tr {
                display: none;
            }

            /* The Uppish Card Design */
            tr {
                background: #fff;
                border: 2px solid #9b59b6;
                /* Purple theme */
                border-radius: 16px;
                margin-bottom: 15px;
                padding: 15px;
                position: relative;
                box-shadow: 0 8px 24px rgba(155, 89, 182, 0.15);
                /* Soft purple floating shadow */
            }

            td {
                border: none !important;
                padding: 0 !important;
            }

            .desktop-only {
                display: none !important;
            }

            .mobile-only {
                display: block !important;
            }

            /* Card Internal Layout */
            .log-header {
                display: flex;
                justify-content: space-between;
                margin-bottom: 8px;
                align-items: flex-start;
            }

            .log-action {
                font-size: 16px;
                font-weight: bold;
                color: #9b59b6;
            }

            .log-date {
                font-size: 12px;
                color: #777;
                text-align: right;
                line-height: 1.2;
            }

            .log-user {
                margin-bottom: 10px;
                font-size: 14px;
                color: #444;
                border-bottom: 1px solid #eee;
                padding-bottom: 8px;
            }

            .log-details {
                font-size: 14px;
                color: #222;
                background: #f9f9f9;
                padding: 12px;
                border-radius: 12px;
                border: 1px solid #eee;
                line-height: 1.4;
            }
        }

        /* Hide mobile on Desktop */
        @media screen and (min-width: 769px) {
            .mobile-only {
                display: none !important;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <a href="/" style="text-decoration: none; color: #3498db; font-weight: bold;">&larr; Back to Dashboard</a>
        <h1 style="margin-top: 15px;">📜 Activity Log</h1>

        <div
            style="background: white; padding: 20px; border-radius: 16px; box-shadow: 0 8px 24px rgba(155, 89, 182, 0.1); margin-bottom: 20px; border: 1px solid #eee;">
        
            <input type="text" id="activitySearch" class="input-style"
                placeholder="🔍 Search logs by user, action, or details..." style="font-size: 16px; padding: 12px;">
        
            <% if (role==='admin' ) { %>
                <form action="/activity/delete-bulk" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete these logs permanently?');"
                    style="margin-top: 10px; padding-top: 15px; border-top: 1px solid #eee;">
                    <strong style="font-size: 14px; color: #555; display: block; margin-bottom: 10px;">🗑️ Bulk Clear
                        Logs</strong>
        
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <select name="filterType" id="filterType" class="input-style"
                            style="flex: 1; min-width: 150px; margin-bottom: 0;" onchange="toggleCustomDates()">
                            <option value="older_than_30">Older than 30 Days</option>
                            <option value="last_30">Last 30 Days</option>
                            <option value="custom">Custom Date Range</option>
                            <option value="all">Delete ALL Logs</option>
                        </select>
        
                        <div id="customDateBoxes" style="display: none; flex: 2; gap: 10px; min-width: 250px;">
                            <input type="date" name="startDate" class="input-style" style="margin-bottom: 0;">
                            <span style="align-self: center;">to</span>
                            <input type="date" name="endDate" class="input-style" style="margin-bottom: 0;">
                        </div>
        
                        <button type="submit" class="btn btn-red" style="padding: 10px 20px;">Clear Now</button>
                    </div>
                </form>
                <% } %>
        </div>
        
        <script>
            // Show/Hide Custom Date Boxes
            function toggleCustomDates() {
                const type = document.getElementById('filterType').value;
                document.getElementById('customDateBoxes').style.display = (type === 'custom') ? 'flex' : 'none';
            }

            // Real-Time Search for Activity
            document.getElementById('activitySearch').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    let text = row.innerText.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        </script>

        <table>
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <% activities.forEach(log=> { %>
                    <% // THE FIX: Smart Date Finder // This checks all the common names you might have used in your database const
                        rawDate=log.createdAt || log.date || log.timestamp; const hasValidDate=rawDate ? true : false; const
                        validDate=hasValidDate ? new Date(rawDate) : null; %>
                        <tr>
                            <td class="desktop-only" style="white-space: nowrap; color: #555;">
                                <% if (hasValidDate) { %>
                                    <%= validDate.toLocaleString('en-IN') %>
                                        <% } else { %>
                                            <span style="color:#999;">Date Unknown</span>
                                            <% } %>
                            </td>
                            <td class="desktop-only">
                                <strong>
                                    <%= log.username || 'Admin' %>
                                </strong>
                            </td>
                            <td class="desktop-only action-text">
                                <%= log.action %>
                            </td>
                            <td class="desktop-only">
                                <%= log.details %>
                            </td>
            
                            <td class="mobile-only">
                                <div class="log-header">
                                    <div class="log-action">
                                        <%= log.action %>
                                    </div>
                                    <div class="log-date">
                                        <% if (hasValidDate) { %>
                                            <%= validDate.toLocaleDateString('en-IN') %><br>
                                                <strong>
                                                    <%= validDate.toLocaleTimeString('en-IN', { hour: '2-digit' , minute: '2-digit'
                                                        }) %>
                                                </strong>
                                                <% } else { %>
                                                    <span style="color:#999;">Date Unknown</span>
                                                    <% } %>
                                    </div>
                                </div>
                                <div class="log-user">
                                    👤 <strong>
                                        <%= log.username || 'Admin' %>
                                    </strong>
                                </div>
                                <div class="log-details">
                                    <%= log.details %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
            </tbody>
        </table>
    </div>
</body>

</html>