# Copy this file to .env on the Hostinger VPS. Never commit the real .env file.
NODE_ENV=production
PORT=3000

# Required application secrets
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/paymentApp?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-value

# Google Drive backup integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://payment.webgraphicsstudio.in/auth/google/callback
