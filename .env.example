NODE_ENV=production
PUBLIC_APP_ORIGIN=https://your-production-domain.example.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=generate-a-long-random-value
CRON_SECRET=generate-a-separate-long-random-value

# Optional first-time bootstrap only. Do not reuse these values elsewhere.
SUPERADMIN_USERNAME=choose-a-unique-username
SUPERADMIN_PASSWORD=choose-a-strong-password

# Required only when connecting Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example.com/auth/google/callback

# Optional manual utilities; never use shared passwords for all users.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_SECURITY_ANSWER=
RESET_USERNAME=
RESET_PASSWORD=