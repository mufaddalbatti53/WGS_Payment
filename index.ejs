<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>WGS Payment Manager</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1a1f2e">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f0f2f8;
            --surface: #ffffff;
            --surface2: #f8f9fc;
            --border: rgba(30,40,80,0.08);
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-glow: rgba(37,99,235,0.18);
            --accent: #7c3aed;
            --accent-glow: rgba(124,58,237,0.15);
            --success: #059669;
            --success-bg: #ecfdf5;
            --warning: #d97706;
            --warning-bg: #fffbeb;
            --danger: #dc2626;
            --danger-bg: #fef2f2;
            --text: #0f172a;
            --text-2: #475569;
            --text-3: #94a3b8;
            --shadow-sm: 0 2px 8px rgba(15,23,42,0.06);
            --shadow-md: 0 8px 24px rgba(15,23,42,0.10);
            --shadow-lg: 0 20px 48px rgba(15,23,42,0.14);
            --radius: 18px;
            --radius-sm: 12px;
            --radius-xs: 8px;
        }

        /* Dark mode */
        body.dark {
            --bg: #0d1117;
            --surface: #161b27;
            --surface2: #1c2333;
            --border: rgba(255,255,255,0.07);
            --text: #e2e8f0;
            --text-2: #94a3b8;
            --text-3: #475569;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.4);
            --shadow-lg: 0 20px 48px rgba(0,0,0,0.5);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* ===== LAYOUT ===== */
        .app-shell {
            max-width: 1360px;
            margin: 0 auto;
            padding: 20px 16px 100px;
        }

        /* ===== TOP BAR ===== */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 20px;
            background: var(--surface);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
            border: 1px solid var(--border);
        }
        .top-bar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand-logo {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; color: white; font-weight: 800;
        }
        .brand-name {
            font-weight: 800; font-size: 15px; color: var(--text);
            letter-spacing: -0.3px;
        }
        .brand-role {
            font-size: 11px; color: var(--text-3); font-weight: 500;
            letter-spacing: 0.5px; text-transform: uppercase;
        }
        .top-bar-actions {
            display: flex; align-items: center; gap: 8px;
        }
        .icon-btn {
            width: 36px; height: 36px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--surface2);
            color: var(--text-2);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 16px;
            transition: all 0.18s;
            text-decoration: none;
        }
        .icon-btn:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .logout-btn {
            background: var(--danger-bg); color: var(--danger);
            border-color: rgba(220,38,38,0.15);
            font-size: 12px; font-weight: 700;
            padding: 0 12px; width: auto;
            letter-spacing: 0.3px;
        }
        .logout-btn:hover { background: var(--danger); color: white; border-color: var(--danger); }

        /* ===== DUPLICATE WARNING ===== */
        .dup-warning {
            background: var(--warning-bg); border: 1.5px solid #fcd34d;
            border-radius: var(--radius-sm); padding: 14px 18px;
            margin-bottom: 16px;
            display: flex; align-items: center; gap: 12px;
            font-weight: 600; color: #92400e; font-size: 14px;
            animation: slideDown 0.3s ease;
        }
        @keyframes slideDown { from { opacity:0; transform: translateY(-8px); } to { opacity:1; transform:translateY(0); } }

        /* ===== MOBILE LAUNCHER ===== */
        .launcher { display: none; }
        @media (max-width: 768px) {
            .launcher { display: block; }
        }
        @media (min-width: 769px) {
            .launcher { display: none !important; }
            .back-btn { display: none !important; }
        }

        .launcher-hero {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #7c3aed 100%);
            border-radius: var(--radius);
            padding: 24px 22px 22px;
            margin-bottom: 18px;
            color: white;
            position: relative;
            overflow: hidden;
        }
        .launcher-hero::before {
            content: '';
            position: absolute; top: -30px; right: -30px;
            width: 130px; height: 130px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
        }
        .launcher-hero::after {
            content: '';
            position: absolute; bottom: -20px; left: 30px;
            width: 80px; height: 80px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }
        .hero-greeting { font-size: 13px; opacity: 0.8; font-weight: 500; margin-bottom: 4px; }
        .hero-company { font-size: 22px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 2px; }
        .hero-sub { font-size: 12px; opacity: 0.7; }
        .hero-stats {
            display: flex; gap: 12px; margin-top: 18px;
        }
        .hero-stat {
            flex: 1;
            background: rgba(255,255,255,0.12);
            border-radius: 12px;
            padding: 10px 12px;
            backdrop-filter: blur(10px);
        }
        .hero-stat-val { font-size: 18px; font-weight: 800; display: block; }
        .hero-stat-lbl { font-size: 10px; opacity: 0.75; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }

        .launcher-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 12px;
        }
        .launcher-tile {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 20px 16px;
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 10px;
            cursor: pointer;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1);
            text-decoration: none; color: var(--text);
            position: relative; overflow: hidden;
        }
        .launcher-tile:active { transform: scale(0.96); }
        .launcher-tile:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
        .tile-icon {
            width: 46px; height: 46px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .tile-title { font-size: 15px; font-weight: 700; }
        .tile-desc { font-size: 11px; color: var(--text-3); font-weight: 500; }
        .tile-badge {
            position: absolute; top: 12px; right: 12px;
            background: var(--danger); color: white;
            font-size: 10px; font-weight: 800;
            border-radius: 20px; padding: 2px 7px;
        }

        /* ===== BACK BUTTON ===== */
        .back-btn {
            display: none;
            align-items: center; gap: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--primary);
            font-weight: 700; font-size: 13px;
            border-radius: var(--radius-sm);
            padding: 10px 16px;
            margin-bottom: 16px;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        /* ===== CARDS ===== */
        .card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 22px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            margin-bottom: 18px;
        }
        .card-title {
            font-size: 15px; font-weight: 800;
            color: var(--text);
            margin-bottom: 16px;
            display: flex; align-items: center; gap: 8px;
        }

        /* ===== STATS ===== */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 18px;
        }
        .stat-card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 18px 16px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            position: relative; overflow: hidden;
        }
        .stat-card::after {
            content: '';
            position: absolute; bottom: 0; left: 0; right: 0;
            height: 3px;
        }
        .stat-card.s-blue::after { background: linear-gradient(90deg, var(--primary), var(--accent)); }
        .stat-card.s-red::after { background: linear-gradient(90deg, #f59e0b, var(--danger)); }
        .stat-card.s-action::after { background: linear-gradient(90deg, var(--primary), var(--success)); }
        .stat-label { font-size: 11px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
        .stat-value { font-size: 26px; font-weight: 800; color: var(--text); line-height: 1; }
        .stat-card.s-red .stat-value { color: var(--danger); }
        .stat-card.s-action { cursor: pointer; transition: all 0.2s; }
        .stat-card.s-action:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
        .stat-sub { font-size: 11px; color: var(--primary); font-weight: 600; margin-top: 6px; background: var(--primary-glow); padding: 3px 8px; border-radius: 20px; display: inline-block; }

        /* ===== AGING BUCKETS ===== */
        .aging-row {
            margin-bottom: 13px;
            padding: 8px 10px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.18s;
        }
        .aging-row:hover { background: var(--surface2); transform: translateX(3px); }
        .aging-row.active-bucket { background: var(--primary-glow); border-left: 3px solid var(--primary); padding-left: 14px; }
        .aging-labels {
            display: flex; justify-content: space-between;
            font-size: 12px; font-weight: 700;
            color: var(--text-2); margin-bottom: 6px;
        }
        .aging-labels.danger { color: var(--danger); }
        .bucket-count {
            display: inline-block;
            background: var(--surface2); color: var(--primary);
            font-size: 10px; font-weight: 700;
            border-radius: 20px; padding: 1px 7px; margin-left: 6px;
        }
        .bucket-count.red { background: var(--danger-bg); color: var(--danger); }
        .bar-bg { background: var(--surface2); height: 6px; border-radius: 6px; overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 6px; transition: width 1s cubic-bezier(0.4,0,0.2,1); }
        .bar-fill.green { background: linear-gradient(90deg, #34d399, var(--success)); }
        .bar-fill.orange { background: linear-gradient(90deg, #fbbf24, #d97706); }
        .bar-fill.red { background: linear-gradient(90deg, #f87171, var(--danger)); }

        /* ===== ACTIVE FILTER HEADER ===== */
        #filterActiveHeader {
            display: none;
            background: var(--primary-glow);
            border: 1px solid rgba(37,99,235,0.2);
            border-radius: var(--radius-sm);
            padding: 10px 16px; margin-bottom: 12px;
            font-size: 13px; font-weight: 700; color: var(--primary);
            align-items: center; gap: 10px;
        }
        #filterActiveHeader.show { display: flex; }

        /* ===== DATA CONTROLS ===== */
        .data-controls {
            display: flex; flex-wrap: wrap; gap: 10px;
            align-items: center; margin-bottom: 16px;
        }
        .admin-tabs {
            display: flex; gap: 8px; flex-wrap: wrap;
        }
        .tab-btn {
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text-2);
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-size: 13px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            transition: all 0.18s;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .tab-btn:hover { background: var(--primary); color: white; border-color: var(--primary); }
        .tab-btn.danger:hover { background: var(--danger); border-color: var(--danger); color: white; }

        /* ===== TOOLBAR ===== */
        .toolbar {
            display: flex; gap: 10px; align-items: center;
            flex-wrap: wrap; margin-bottom: 14px;
        }
        .search-input {
            flex: 1; min-width: 180px;
            padding: 10px 16px;
            border: 1.5px solid var(--border);
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            background: var(--surface);
            color: var(--text);
            outline: none;
            transition: all 0.2s;
            box-shadow: var(--shadow-sm);
        }
        .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-glow); }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white; border: none;
            padding: 10px 18px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px var(--primary-glow);
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px var(--primary-glow); }
        .btn-outline {
            background: transparent;
            border: 1.5px solid var(--border);
            color: var(--text-2);
            padding: 10px 14px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            cursor: pointer; transition: all 0.18s;
            white-space: nowrap;
        }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary); }

        /* ===== FILTER PANEL ===== */
        .filter-panel {
            display: none;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 18px;
            margin-bottom: 14px;
        }
        .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
        .filter-label { font-size: 11px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 5px; }
        .filter-select, .filter-input {
            width: 100%; padding: 9px 12px;
            border: 1.5px solid var(--border); border-radius: var(--radius-xs);
            font-family: 'DM Sans', sans-serif; font-size: 13px;
            background: var(--surface); color: var(--text); outline: none;
            transition: border-color 0.18s;
        }
        .filter-select:focus, .filter-input:focus { border-color: var(--primary); }

        /* ===== TABLE ===== */
        .table-card { background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm); overflow: hidden; }
        table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
        thead th {
            background: var(--surface2); color: var(--text-3);
            font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;
            padding: 13px 14px; text-align: left;
        }
        thead th:first-child { border-radius: 0; }
        tbody td { padding: 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover td { background: var(--surface2); }
        .party-name { font-size: 14px; font-weight: 700; color: var(--text); }
        .party-sub { font-size: 12px; color: var(--text-3); margin-top: 2px; }
        .contact-link { color: var(--primary); font-weight: 600; text-decoration: none; font-size: 12px; }
        .contact-link:hover { text-decoration: underline; }
        .due-badge {
            display: inline-block;
            background: var(--danger-bg); color: var(--danger);
            font-weight: 800; font-size: 13px;
            padding: 3px 8px; border-radius: 6px;
        }
        .paid-badge {
            display: inline-block;
            background: var(--success-bg); color: var(--success);
            font-weight: 700; font-size: 12px;
            padding: 3px 8px; border-radius: 6px;
        }
        .action-req {
            background: var(--danger-bg); color: var(--danger);
            font-size: 10px; font-weight: 800;
            padding: 2px 7px; border-radius: 5px;
            display: inline-block; margin-top: 4px;
        }
        .btn-table {
            background: var(--surface2); border: 1px solid var(--border);
            color: var(--text-2); padding: 6px 10px;
            border-radius: var(--radius-xs); font-size: 11px; font-weight: 700;
            cursor: pointer; transition: all 0.18s;
            width: 100%; margin-bottom: 4px; display: block; text-align: center;
            font-family: 'DM Sans', sans-serif;
        }
        .btn-table:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-glow); }
        .btn-table-red:hover { border-color: var(--danger); color: var(--danger); background: var(--danger-bg); }
        .msg-btns { display: flex; gap: 6px; margin-bottom: 8px; }
        .msg-circle {
            width: 28px; height: 28px; border-radius: 50%;
            border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 13px;
            background: var(--surface2); transition: all 0.18s;
            text-decoration: none;
        }
        .msg-circle:hover { transform: scale(1.1); }
        .msg-circle.wa { background: #dcfce7; border-color: #bbf7d0; }

        /* ===== MOBILE CARDS ===== */
        @media (max-width: 768px) {
            table, thead, tbody, th, td, tr { display: block !important; width: 100% !important; }
            thead { display: none !important; }
            td.desktop-only { display: none !important; }
            td.mobile-only { display: block !important; }
            tr.customer-row {
                background: var(--surface) !important;
                border-radius: var(--radius) !important;
                margin-bottom: 14px !important;
                padding: 18px !important;
                border: 1px solid var(--border) !important;
                box-shadow: var(--shadow-sm) !important;
                display: flex !important; flex-direction: column !important;
            }
            td { border: none !important; padding: 0 !important; }
            .m-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 14px; }
            .m-name { flex: 1; line-height: 1.4; }
            .m-name strong { font-size: 16px; font-weight: 800; color: var(--text); display: block; }
            .m-name span { font-size: 12px; color: var(--text-3); }
            .m-fin { text-align: right; }
            .m-fin-top { font-size: 11px; color: var(--text-3); display: block; }
            .m-fin-paid { font-size: 12px; color: var(--success); display: block; font-weight: 700; }
            .m-fin-due { color: var(--danger); font-weight: 900; font-size: 15px; display: block; margin-top: 3px; }
            .m-circles { display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 14px; }
            .m-circle {
                width: 40px; height: 40px; border-radius: 50%;
                background: var(--surface2); border: 1px solid var(--border);
                display: flex; align-items: center; justify-content: center;
                font-size: 16px; cursor: pointer; text-decoration: none;
                transition: transform 0.2s;
            }
            .m-circle:active { transform: scale(0.9); }
            .m-circle.wa { background: #dcfce7; border-color: #bbf7d0; }
            .m-tools { display: flex; gap: 8px; }
            .m-tool-btn {
                background: var(--surface2); border: 1px solid var(--border);
                border-radius: 10px; padding: 10px; flex: 1;
                text-align: center; font-size: 16px; cursor: pointer;
                transition: all 0.18s; color: var(--text);
            }
            .m-tool-btn:active { background: var(--primary-glow); border-color: var(--primary); }

            .stats-row { grid-template-columns: 1fr 1fr; }
            .stats-row .stat-card:last-child { grid-column: 1 / -1; }

            .admin-tabs { flex-wrap: wrap; }
            .toolbar { gap: 8px; }
        }
        @media (min-width: 769px) {
            .mobile-only { display: none !important; }
        }

        /* ===== BULK BAR ===== */
        .bulk-bar {
            position: fixed; bottom: -100px; left: 50%; transform: translateX(-50%);
            background: var(--text); color: white;
            padding: 14px 22px; border-radius: 50px;
            display: flex; align-items: center; gap: 14px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            transition: bottom 0.4s cubic-bezier(0.175,0.885,0.32,1.275);
            z-index: 900; width: max-content; max-width: 92%;
        }
        .bulk-bar.visible { bottom: 24px; }
        .bulk-delete-btn {
            background: var(--danger); color: white; border: none;
            padding: 9px 18px; border-radius: 25px; font-weight: 700; cursor: pointer;
            font-family: 'DM Sans', sans-serif; font-size: 13px;
            box-shadow: 0 4px 12px rgba(220,38,38,0.4);
            transition: all 0.18s;
        }
        .bulk-delete-btn:hover { background: #b91c1c; }

        /* ===== MODALS ===== */
        .modal {
            display: none; position: fixed; z-index: 1000;
            left: 0; top: 0; width: 100%; height: 100%;
            background: rgba(10,15,30,0.65); backdrop-filter: blur(6px);
        }
        .modal-content {
            background: var(--surface);
            margin: 6vh auto; padding: 28px;
            border-radius: 24px;
            width: 92%; max-width: 460px;
            max-height: 88vh; overflow-y: auto;
            box-shadow: var(--shadow-lg);
            position: relative;
            border: 1px solid var(--border);
        }
        .modal-content.wide { max-width: 680px; }
        .modal-close {
            position: absolute; top: 18px; right: 18px;
            width: 30px; height: 30px; border-radius: 8px;
            background: var(--surface2); border: none; cursor: pointer;
            color: var(--text-3); font-size: 18px;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.18s;
        }
        .modal-close:hover { background: var(--danger-bg); color: var(--danger); }
        .modal-title { font-size: 17px; font-weight: 800; margin-bottom: 4px; color: var(--text); }
        .modal-sub { font-size: 12px; color: var(--text-3); margin-bottom: 20px; }

        /* Input styles */
        .inp-label { font-size: 11px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 5px; margin-top: 12px; }
        .inp {
            width: 100%; padding: 11px 14px;
            border: 1.5px solid var(--border); border-radius: var(--radius-xs);
            font-family: 'DM Sans', sans-serif; font-size: 14px;
            background: var(--surface2); color: var(--text); outline: none;
            transition: all 0.2s; margin-bottom: 2px;
        }
        .inp:focus { border-color: var(--primary); background: var(--surface); box-shadow: 0 0 0 3px var(--primary-glow); }
        .inp-row { display: flex; gap: 10px; }
        .inp-row > div { flex: 1; }
        .btn-full {
            width: 100%; padding: 13px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white; border: none; border-radius: var(--radius-xs);
            font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 800;
            cursor: pointer; margin-top: 16px;
            box-shadow: 0 4px 14px var(--primary-glow); transition: all 0.2s;
        }
        .btn-full:hover { transform: translateY(-2px); box-shadow: 0 8px 20px var(--primary-glow); }
        .btn-full.danger-btn { background: linear-gradient(135deg, var(--danger), #b91c1c); box-shadow: 0 4px 14px rgba(220,38,38,0.3); }
        .btn-full.success-btn { background: linear-gradient(135deg, var(--success), #047857); box-shadow: 0 4px 14px rgba(5,150,105,0.3); }

        .trans-box {
            border-radius: var(--radius-xs); padding: 14px; margin-bottom: 10px; border: 1px solid;
        }
        .trans-box.purchase { background: #fff0f6; border-color: #fce7f3; }
        .trans-box.payment { background: var(--success-bg); border-color: #a7f3d0; }
        .trans-box label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: block; }
        .trans-box.purchase label { color: #be185d; }
        .trans-box.payment label { color: var(--success); }

        .dup-alert {
            background: var(--danger-bg); border: 1px solid #fca5a5;
            border-radius: var(--radius-xs); padding: 10px 14px;
            font-size: 12px; color: var(--danger); font-weight: 600;
            margin-bottom: 10px; display: none;
        }
        .dup-alert.show { display: block; }

        .checkbox-custom { width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary); }

        /* ===== SETTINGS MODAL ===== */
        .settings-tabs {
            display: flex; gap: 4px; flex-wrap: wrap;
            background: var(--surface2); border-radius: var(--radius-xs);
            padding: 4px; margin-bottom: 20px;
        }
        .stab {
            flex: 1; padding: 8px 6px; text-align: center;
            border-radius: 8px; font-size: 11px; font-weight: 700;
            cursor: pointer; color: var(--text-3); transition: all 0.18s;
            white-space: nowrap;
        }
        .stab.active { background: var(--surface); color: var(--primary); box-shadow: var(--shadow-sm); }
        .stab-panel { display: none; }
        .stab-panel.active { display: block; }

        .setting-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 0; border-bottom: 1px solid var(--border);
        }
        .setting-row:last-child { border-bottom: none; }
        .setting-info h4 { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
        .setting-info p { font-size: 11px; color: var(--text-3); }
        .toggle-switch {
            width: 42px; height: 24px; background: var(--border);
            border-radius: 12px; position: relative; cursor: pointer;
            transition: background 0.2s; border: none; flex-shrink: 0;
        }
        .toggle-switch.on { background: var(--primary); }
        .toggle-switch::after {
            content: ''; position: absolute;
            width: 18px; height: 18px; background: white; border-radius: 50%;
            top: 3px; left: 3px; transition: left 0.2s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }
        .toggle-switch.on::after { left: 21px; }

        .backup-btn {
            width: 100%; padding: 12px;
            border-radius: var(--radius-xs); font-size: 13px; font-weight: 700;
            cursor: pointer; margin-bottom: 10px; border: 1.5px solid var(--border);
            background: var(--surface2); color: var(--text);
            font-family: 'DM Sans', sans-serif; transition: all 0.18s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .backup-btn:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-glow); }
        .backup-btn.restore { border-color: rgba(5,150,105,0.3); color: var(--success); }
        .backup-btn.restore:hover { background: var(--success-bg); border-color: var(--success); }
        .backup-btn.danger { border-color: rgba(220,38,38,0.2); color: var(--danger); }
        .backup-btn.danger:hover { background: var(--danger-bg); border-color: var(--danger); }

        .license-box {
            background: var(--surface2); border-radius: var(--radius-xs);
            padding: 16px; font-family: 'DM Mono', monospace;
            font-size: 12px; color: var(--text-2);
            border: 1px solid var(--border); line-height: 1.6;
        }
        .license-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--success-bg); color: var(--success);
            padding: 5px 12px; border-radius: 20px;
            font-size: 12px; font-weight: 700;
            border: 1px solid rgba(5,150,105,0.2);
            margin-bottom: 12px;
        }

        /* ===== IMPORT / EXPORT ===== */
        .import-zone {
            border: 2px dashed var(--border); border-radius: var(--radius-sm);
            padding: 20px; text-align: center;
            background: var(--surface2); transition: all 0.18s;
        }
        .import-zone:hover { border-color: var(--primary); background: var(--primary-glow); }

        /* ===== IMPORT/EXPORT SECTION CARD ===== */
        .section-divider {
            border-top: 1px solid var(--border);
            margin: 16px 0;
        }

        /* ===== BACKUP STATUS ===== */
        .backup-info {
            background: var(--surface2); border-radius: var(--radius-xs);
            padding: 12px 14px; font-size: 12px; color: var(--text-3);
            border: 1px solid var(--border); margin-bottom: 10px;
            display: flex; align-items: center; gap: 8px;
        }
        .backup-info .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex-shrink: 0; }
        .backup-info .dot.none { background: var(--text-3); }

        tr.customer-row.d-none { display: none !important; }

        /* ===== DESKTOP ADMIN BAR ===== */
        .admin-bar-desktop {
            display: none;
        }
        @media (min-width: 769px) {
            .admin-bar-desktop {
                display: flex; gap: 10px; flex-wrap: wrap;
                align-items: center; margin-bottom: 16px;
            }
        }
    </style>
</head>
<body>
<div class="app-shell">

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="top-bar-brand">
            <div class="brand-logo">W</div>
            <div>
                <div class="brand-name">WGS Payment</div>
                <div class="brand-role"><%= role %></div>
            </div>
        </div>
        <div class="top-bar-actions">
            <% if (role === 'admin') { %>
            <button class="icon-btn" onclick="openSettingsModal()" title="Settings">⚙️</button>
            <% } %>
            <a href="/logout" class="icon-btn logout-btn">Logout</a>
        </div>
    </div>

    <!-- DUPLICATE WARNING -->
    <div id="dupWarning" class="dup-warning" style="display:none;">
        ⚠️ <span id="dupWarningText"></span>
        <button onclick="document.getElementById('dupWarning').style.display='none'" style="margin-left:auto; background:none; border:none; cursor:pointer; font-size:18px; color:#92400e;">×</button>
    </div>

    <% if (role !== 'customer') { %>

    <!-- ===== MOBILE LAUNCHER ===== -->
    <div class="launcher" id="homeLauncher">
        <div class="launcher-hero">
            <div class="hero-greeting">Welcome back 👋</div>
            <div class="hero-company"><%= adminUser.companyName || 'WGS Payment Manager' %></div>
            <div class="hero-sub"><%= role.charAt(0).toUpperCase() + role.slice(1) %> Account</div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-val"><%= stats.totalParties %></span>
                    <span class="hero-stat-lbl">Parties</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-val" style="font-size:14px;"><%= stats.totalPendingFmt %></span>
                    <span class="hero-stat-lbl">Pending</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-val"><%= stats.actionRequiredCount %></span>
                    <span class="hero-stat-lbl">Actions</span>
                </div>
            </div>
        </div>

        <div class="launcher-grid">
            <a class="launcher-tile" onclick="showSection('dashboard'); return false;" href="#">
                <div class="tile-icon" style="background:#dbeafe;">📊</div>
                <div class="tile-title">Dashboard</div>
                <div class="tile-desc">KPIs & Aging</div>
            </a>
            <a class="launcher-tile" onclick="showSection('parties'); return false;" href="#">
                <div class="tile-icon" style="background:#dcfce7;">🏢</div>
                <div class="tile-title">Parties</div>
                <div class="tile-desc">Search & Manage</div>
                <% if (stats.actionRequiredCount > 0) { %>
                <span class="tile-badge"><%= stats.actionRequiredCount %></span>
                <% } %>
            </a>
            <% if (role === 'admin') { %>
            <a class="launcher-tile" href="/staff">
                <div class="tile-icon" style="background:#fce7f3;">👤</div>
                <div class="tile-title">Staff</div>
                <div class="tile-desc">Manage Team</div>
            </a>
            <a class="launcher-tile" href="/activity">
                <div class="tile-icon" style="background:#fef3c7;">📜</div>
                <div class="tile-title">Activity</div>
                <div class="tile-desc">Audit Log</div>
            </a>
            <a class="launcher-tile" href="/export">
                <div class="tile-icon" style="background:#e0f2fe;">📥</div>
                <div class="tile-title">Export</div>
                <div class="tile-desc">Excel Report</div>
            </a>
            <a class="launcher-tile" onclick="openSettingsModal(); return false;" href="#">
                <div class="tile-icon" style="background:#f3e8ff;">⚙️</div>
                <div class="tile-title">Settings</div>
                <div class="tile-desc">Profile & Backup</div>
            </a>
            <% } else { %>
            <a class="launcher-tile" href="/activity">
                <div class="tile-icon" style="background:#fef3c7;">📜</div>
                <div class="tile-title">Activity</div>
                <div class="tile-desc">Audit Log</div>
            </a>
            <% } %>
        </div>
    </div>

    <!-- BACK BUTTON (mobile) -->
    <button class="back-btn" id="backToLauncher" onclick="showLauncher()">← Home</button>
    <% } %>

    <!-- ===== MAIN DASHBOARD ===== -->
    <div id="mainDashboard">

        <!-- Desktop Admin Tabs -->
        <% if (role === 'admin') { %>
        <div class="admin-bar-desktop">
            <a href="/staff" class="tab-btn">👤 Staff</a>
            <a href="/activity" class="tab-btn">📜 Activity</a>
            <a href="/export" class="tab-btn">📥 Export Excel</a>
            <button onclick="downloadPDF()" class="tab-btn danger">📄 PDF Report</button>
            <button onclick="openSettingsModal()" class="tab-btn">⚙️ Settings</button>
        </div>
        <% } %>

        <!-- Stats -->
        <% if (role !== 'customer') { %>
        <div id="viewDashboard">
            <div class="stats-row">
                <div class="stat-card s-blue">
                    <div class="stat-label">Total Parties</div>
                    <div class="stat-value"><%= stats.totalParties %></div>
                </div>
                <div class="stat-card s-red">
                    <div class="stat-label">Total Pending</div>
                    <div class="stat-value" style="font-size:18px;"><%= stats.totalPendingFmt %></div>
                </div>
                <div class="stat-card s-action" onclick="showSection('parties'); runAllFilters('action')">
                    <div class="stat-label">Action Required</div>
                    <div class="stat-value" style="color:var(--primary);"><%= stats.actionRequiredCount %></div>
                    <div class="stat-sub">Filter →</div>
                </div>
            </div>

            <!-- Aging Buckets -->
            <div class="card">
                <div class="card-title">📅 Aging Buckets <span style="font-size:11px;font-weight:500;color:var(--text-3);">Click to filter</span></div>

                <div class="aging-row aging-clickable" onclick="filterByBucket('u30','&lt; 30 Days',<%= stats.buckets.u30.cnt %>,'<%= stats.buckets.u30.fmt %>')">
                    <div class="aging-labels"><span>&lt; 30 DAYS <span class="bucket-count"><%= stats.buckets.u30.cnt %></span></span><span><%= stats.buckets.u30.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill green" style="width:<%= stats.buckets.u30.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('d30_60','30-60 Days',<%= stats.buckets.d30_60.cnt %>,'<%= stats.buckets.d30_60.fmt %>')">
                    <div class="aging-labels"><span>30-60 DAYS <span class="bucket-count"><%= stats.buckets.d30_60.cnt %></span></span><span><%= stats.buckets.d30_60.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill green" style="width:<%= stats.buckets.d30_60.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('d60_90','60-90 Days',<%= stats.buckets.d60_90.cnt %>,'<%= stats.buckets.d60_90.fmt %>')">
                    <div class="aging-labels"><span>60-90 DAYS <span class="bucket-count"><%= stats.buckets.d60_90.cnt %></span></span><span><%= stats.buckets.d60_90.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill orange" style="width:<%= stats.buckets.d60_90.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('d90_120','90-120 Days',<%= stats.buckets.d90_120.cnt %>,'<%= stats.buckets.d90_120.fmt %>')">
                    <div class="aging-labels danger"><span>90-120 DAYS <span class="bucket-count red"><%= stats.buckets.d90_120.cnt %></span></span><span><%= stats.buckets.d90_120.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill red" style="width:<%= stats.buckets.d90_120.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('d120_150','120-150 Days',<%= stats.buckets.d120_150.cnt %>,'<%= stats.buckets.d120_150.fmt %>')">
                    <div class="aging-labels danger"><span>120-150 DAYS <span class="bucket-count red"><%= stats.buckets.d120_150.cnt %></span></span><span><%= stats.buckets.d120_150.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill red" style="width:<%= stats.buckets.d120_150.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('d150_180','150-180 Days',<%= stats.buckets.d150_180.cnt %>,'<%= stats.buckets.d150_180.fmt %>')">
                    <div class="aging-labels danger"><span>150-180 DAYS <span class="bucket-count red"><%= stats.buckets.d150_180.cnt %></span></span><span><%= stats.buckets.d150_180.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill red" style="width:<%= stats.buckets.d150_180.pct %>%;"></div></div>
                </div>
                <div class="aging-row aging-clickable" onclick="filterByBucket('a180','&gt; 180 Days',<%= stats.buckets.a180.cnt %>,'<%= stats.buckets.a180.fmt %>')">
                    <div class="aging-labels danger"><span>&gt; 180 DAYS <span class="bucket-count red"><%= stats.buckets.a180.cnt %></span></span><span><%= stats.buckets.a180.fmt %></span></div>
                    <div class="bar-bg"><div class="bar-fill red" style="width:<%= stats.buckets.a180.pct %>%;"></div></div>
                </div>
                <div class="aging-row" style="margin-bottom:0;padding-top:12px;border-top:1px dashed var(--border);">
                    <div class="aging-labels"><span>ON ACCOUNT <span class="bucket-count"><%= stats.buckets.onAcc.cnt %></span></span><span><%= stats.buckets.onAcc.fmt %></span></div>
                </div>
            </div>
        </div><!-- /viewDashboard -->

        <!-- PARTIES -->
        <div id="viewParties">
            <!-- Import (admin only) -->
            <% if (role === 'admin') { %>
            <div class="card">
                <div class="card-title">📤 Import Tally/Busy Excel</div>
                <form action="/import" method="POST" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                    <div class="import-zone" style="flex:1;min-width:200px;">
                        <input type="file" name="excelFile" accept=".csv,.xlsx,.xls" required style="width:100%;font-size:13px;">
                        <div style="font-size:11px;color:var(--text-3);margin-top:6px;">Supports Tally & Busy exports</div>
                    </div>
                    <button type="submit" class="btn-primary">📤 Import</button>
                </form>
            </div>
            <% } %>

            <!-- Toolbar -->
            <div class="toolbar">
                <button id="toggleFilterBtn" class="btn-outline" onclick="toggleFilterPanel()">⚙️ Filters</button>
                <input type="text" id="searchInput" class="search-input" placeholder="🔍 Search parties...">
                <% if (role === 'admin') { %>
                <button id="selectAllBtn" class="btn-outline" onclick="toggleSelectAll()">☑️ Select</button>
                <% } %>
                <button onclick="openAddModal()" class="btn-primary">➕ Add Party</button>
            </div>

            <div id="filterPanel" class="filter-panel">
                <div class="filter-grid">
                    <div>
                        <span class="filter-label">Aging Bucket</span>
                        <select id="filterAging" class="filter-select">
                            <option value="all">All</option>
                            <option value="u30">&lt; 30 Days</option>
                            <option value="d30_60">30-60 Days</option>
                            <option value="d60_90">60-90 Days</option>
                            <option value="d90_120">90-120 Days</option>
                            <option value="d120_150">120-150 Days</option>
                            <option value="d150_180">150-180 Days</option>
                            <option value="a180">&gt; 180 Days</option>
                        </select>
                    </div>
                    <div>
                        <span class="filter-label">Amount Type</span>
                        <select id="filterAmtType" class="filter-select">
                            <option value="due">Total Due</option>
                            <option value="total">Total Bill</option>
                        </select>
                    </div>
                    <div>
                        <span class="filter-label">Min ₹</span>
                        <input type="number" id="filterMin" class="filter-input" placeholder="0">
                    </div>
                    <div>
                        <span class="filter-label">Max ₹</span>
                        <input type="number" id="filterMax" class="filter-input" placeholder="Any">
                    </div>
                </div>
                <div style="margin-top:12px;display:flex;justify-content:flex-end;gap:10px;">
                    <button onclick="clearFilters()" class="btn-outline" style="padding:8px 14px;">Clear</button>
                    <button onclick="runAllFilters('standard')" class="btn-primary" style="padding:8px 16px;">Apply</button>
                </div>
            </div>

            <div id="filterActiveHeader">
                <span id="filterActiveText"></span>
                <button onclick="clearAgingFilter()" style="margin-left:auto;background:var(--primary);color:white;border:none;border-radius:6px;padding:3px 10px;cursor:pointer;font-size:11px;font-weight:700;">✕ Clear</button>
            </div>

            <!-- Table -->
            <div class="table-card">
                <table id="mainTable">
                    <thead>
                        <tr>
                            <% if (role === 'admin') { %><th style="width:40px;text-align:center;"><input type="checkbox" id="selectAll" class="checkbox-custom"></th><% } %>
                            <th>Party / Company</th>
                            <th>Contact</th>
                            <th>Financials</th>
                            <% if (role !== 'customer') { %>
                            <th>Next Action</th>
                            <th style="text-align:right;padding-right:18px;">Manage</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(var j=0; j<customers.length; j++) {
                            var customer=customers[j];
                            var due=customer.totalAmount - customer.paidAmount;
                            var isDueForReminder=false, diffDays=0, nextDateString="--";
                            if (customer.nextActionDate) {
                                var nd=new Date(customer.nextActionDate); var td=new Date();
                                nd.setHours(0,0,0,0); td.setHours(0,0,0,0);
                                nextDateString=nd.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
                                if (td>=nd) { isDueForReminder=true; diffDays=Math.floor((td-nd)/(1000*60*60*24)); }
                            } else { isDueForReminder=true; }
                            var lpDate=customer.lastPaymentDate ? new Date(customer.lastPaymentDate).toLocaleDateString('en-IN') : "";
                            var rawCname=customer.companyName||"Party";
                            var rawPname=customer.contactPerson||"";
                            var rawAname=adminUser.companyName||"Our Company";
                            var ag=customer.aging||{};
                            var ag_u30=ag.under30||0, ag_d30=ag.days30to60||0, ag_d60=ag.days60to90||0;
                            var ag_d90=ag.days90to120||0, ag_d120=ag.days120to150||0, ag_d150=ag.days150to180||0, ag_a180=ag.above180||0;
                        %>
                        <tr class="customer-row"
                            data-action-req="<%= (due>0&&isDueForReminder)?'true':'false' %>"
                            data-total="<%= customer.totalAmount %>" data-due="<%= due %>"
                            data-u30="<%= ag_u30 %>" data-d30_60="<%= ag_d30 %>" data-d60_90="<%= ag_d60 %>"
                            data-d90_120="<%= ag_d90 %>" data-d120_150="<%= ag_d120 %>"
                            data-d150_180="<%= ag_d150 %>" data-a180="<%= ag_a180 %>">

                            <% if (role==='admin') { %>
                            <td class="desktop-only" style="text-align:center;">
                                <input type="checkbox" class="customer-checkbox checkbox-custom" value="<%= customer._id %>">
                            </td>
                            <% } %>

                            <td class="desktop-only">
                                <div class="party-name"><%= customer.companyName||'Unknown' %></div>
                                <div class="party-sub"><%= customer.contactPerson||'' %></div>
                            </td>

                            <td class="desktop-only" style="font-size:12px;line-height:1.8;">
                                <a href="tel:+<%= customer.phone %>" class="contact-link">📞 +<%= customer.phone %></a><br>
                                <% if (customer.whatsappNumber) { %><a href="https://wa.me/<%= customer.whatsappNumber %>" target="_blank" class="contact-link" style="color:var(--success);">💬 WA</a><% } %>
                            </td>

                            <td class="desktop-only">
                                <div style="font-size:11px;color:var(--text-3);">Total ₹<%= customer.totalAmount %></div>
                                <div style="font-size:11px;color:var(--success);font-weight:700;">Paid ₹<%= customer.paidAmount %></div>
                                <% if (due>0) { %><div class="due-badge dynamic-due">Due ₹<%= due %></div>
                                <% } else { %><span class="paid-badge">Fully Paid ✓</span><% } %>
                            </td>

                            <% if (role!=='customer') { %>
                            <td class="desktop-only">
                                <% if (due>0) { %>
                                <div style="font-size:12px;font-weight:600;"><%= nextDateString %></div>
                                <% if (isDueForReminder) { %><span class="action-req">⚠️ Action</span><% } %>
                                <% } else { %><span style="color:var(--text-3);">--</span><% } %>
                            </td>

                            <td class="desktop-only" style="text-align:right;padding-right:18px;">
                                <% if (due>0&&isDueForReminder) { %>
                                <div class="msg-btns" style="justify-content:flex-end;">
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'wa')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="msg-circle wa"><img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" width="14" height="14"></a>
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'sms')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="msg-circle">💬</a>
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'email')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="msg-circle">📧</a>
                                </div>
                                <% } %>
                                <% if (role==='admin'||role==='staff') { %>
                                <button class="btn-table transaction-btn" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>">💳 Update Balance</button>
                                <% if (due>0) { %><button class="btn-table reminder-btn" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>">📅 Set Action Date</button><% } %>
                                <% } %>
                                <% if (role==='admin') { %>
                                <div style="display:flex;gap:4px;">
                                    <button class="btn-table edit-btn" style="flex:1;" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>" data-contact="<%= customer.contactPerson %>" data-email="<%= customer.email %>" data-phone="<%= customer.phone %>" data-whatsapp="<%= customer.whatsappNumber %>" data-other="<%= customer.otherNumbers %>" data-total="<%= customer.totalAmount %>" data-paid="<%= customer.paidAmount %>">✏️ Edit</button>
                                    <form action="/customers/<%= customer._id %>?_method=DELETE" method="POST" style="margin:0;" onsubmit="return confirm('Delete this party?');">
                                        <button type="submit" class="btn-table btn-table-red" title="Delete">🗑️</button>
                                    </form>
                                </div>
                                <% } %>
                            </td>
                            <% } %>

                            <!-- MOBILE CARD -->
                            <td class="mobile-only">
                                <div class="m-top">
                                    <div class="m-name">
                                        <% if (role==='admin') { %><input type="checkbox" class="customer-checkbox checkbox-custom" value="<%= customer._id %>" style="margin-right:8px;margin-top:3px;"><% } %>
                                        <div>
                                            <strong><%= customer.companyName||'Unknown Party' %></strong>
                                            <span><%= customer.contactPerson||'' %></span><br>
                                            <a href="tel:+<%= customer.phone %>" style="color:var(--primary);text-decoration:none;font-weight:700;font-size:13px;margin-top:5px;display:inline-block;">📞 +<%= customer.phone %></a>
                                        </div>
                                    </div>
                                    <div class="m-fin">
                                        <span class="m-fin-top">Total ₹<%= customer.totalAmount %></span>
                                        <span class="m-fin-paid">Paid ₹<%= customer.paidAmount %></span>
                                        <% if (due>0) { %><span class="m-fin-due dynamic-due-m">Due ₹<%= due %></span>
                                        <% } else { %><div style="color:var(--success);font-weight:700;margin-top:3px;">Paid ✓</div><% } %>
                                    </div>
                                </div>

                                <% if (role!=='customer') { %>
                                <% if (due>0) { %>
                                <div style="font-size:12px;color:var(--text-3);padding-bottom:13px;margin-bottom:13px;border-bottom:1px solid var(--border);">
                                    📅 <strong style="color:var(--text);"><%= nextDateString %></strong>
                                    <% if (isDueForReminder) { %><span style="float:right;background:var(--danger);color:white;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;">Action</span><% } %>
                                </div>
                                <% } %>

                                <% if (due>0&&isDueForReminder) { %>
                                <div class="m-circles">
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'wa')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="m-circle wa"><img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WA" width="20" height="20"></a>
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'sms')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="m-circle">💬</a>
                                    <a href="javascript:void(0)" onclick="sendMsg(this,'email')" data-id="<%= customer._id %>" data-phone="<%= customer.phone %>" data-wa="<%= customer.whatsappNumber %>" data-email="<%= customer.email %>" data-cname="<%= encodeURIComponent(rawCname) %>" data-pname="<%= encodeURIComponent(rawPname) %>" data-total="<%= customer.totalAmount %>" data-paidamount="<%= customer.paidAmount %>" data-lastpaid="<%= encodeURIComponent(lpDate) %>" data-due="<%= due %>" data-diff="<%= diffDays %>" data-admin="<%= encodeURIComponent(rawAname) %>" class="m-circle">📧</a>
                                </div>
                                <% } %>

                                <div class="m-tools">
                                    <% if (role==='admin'||role==='staff') { %>
                                    <button class="m-tool-btn transaction-btn" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>" title="Update Balance">💳</button>
                                    <% if (due>0) { %><button class="m-tool-btn reminder-btn" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>" title="Set Date">📅</button><% } %>
                                    <% } %>
                                    <% if (role==='admin') { %>
                                    <button class="m-tool-btn edit-btn" data-id="<%= customer._id %>" data-company="<%= customer.companyName %>" data-contact="<%= customer.contactPerson %>" data-email="<%= customer.email %>" data-phone="<%= customer.phone %>" data-whatsapp="<%= customer.whatsappNumber %>" data-other="<%= customer.otherNumbers %>" data-total="<%= customer.totalAmount %>" data-paid="<%= customer.paidAmount %>" title="Edit">✏️</button>
                                    <form action="/customers/<%= customer._id %>?_method=DELETE" method="POST" style="margin:0;" onsubmit="return confirm('Delete this party?');">
                                        <button type="submit" class="m-tool-btn" style="color:var(--danger);" title="Delete">🗑️</button>
                                    </form>
                                    <% } %>
                                </div>
                                <% } %>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div><!-- /viewParties -->
        <% } %>
    </div><!-- /mainDashboard -->

    <!-- ===== BULK BAR ===== -->
    <% if (role==='admin') { %>
    <div id="bulkActionBar" class="bulk-bar">
        <span id="selectedCount" style="font-weight:800;font-size:14px;">0 Selected</span>
        <form id="bulkForm" action="/customers/bulk" method="POST" style="margin:0;">
            <input type="hidden" name="action" value="delete">
            <div id="hiddenInputs"></div>
            <button type="button" onclick="confirmBulkDelete()" class="bulk-delete-btn">🗑️ Delete All</button>
        </form>
    </div>
    <% } %>

    <!-- ===== MODALS ===== -->

    <!-- ADD PARTY -->
    <div id="addModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeAddModal()">✕</button>
            <div class="modal-title">➕ Add New Party</div>
            <div class="modal-sub">All fields optional except name and phone.</div>
            <div id="addDupAlert" class="dup-alert">⚠️ <span id="addDupMsg"></span></div>
            <form action="/customers" method="POST" id="addPartyForm">
                <label class="inp-label">Party Name *</label>
                <input type="text" name="companyName" id="addCompanyName" class="inp" autocomplete="off">
                <label class="inp-label">Contact Person</label>
                <input type="text" name="contactPerson" class="inp">
                <label class="inp-label">Email</label>
                <input type="email" name="email" class="inp">
                <label class="inp-label">Total Due (₹) *</label>
                <input type="number" name="totalAmount" required class="inp">
                <label class="inp-label">Primary Phone *</label>
                <div style="display:flex;gap:8px;margin-bottom:2px;">
                    <select name="countryCode" class="inp" style="width:80px;flex-shrink:0;">
                        <option value="91">+91</option><option value="1">+1</option><option value="971">+971</option>
                    </select>
                    <input type="text" name="localPhone" id="addLocalPhone" required class="inp" style="flex:1;" autocomplete="off">
                </div>
                <label class="inp-label">WhatsApp (with country code)</label>
                <input type="text" name="whatsappNumber" required class="inp">
                <label class="inp-label">Other Numbers</label>
                <input type="text" name="otherNumbers" placeholder="Comma separated" class="inp">
                <button type="submit" class="btn-full">Save Party</button>
            </form>
        </div>
    </div>

    <!-- TRANSACTION -->
    <div id="transactionModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeTransactionModal()">✕</button>
            <div class="modal-title">💳 Update Balance</div>
            <div id="transCompanyName" style="font-weight:700;color:var(--primary);margin-bottom:18px;font-size:14px;"></div>
            <form id="transactionForm" method="POST">
                <div class="trans-box purchase">
                    <label>➕ New Purchase (Increases Debt)</label>
                    <input type="number" name="newPurchase" placeholder="Amount (₹)" class="inp" style="margin-bottom:0;">
                </div>
                <div class="trans-box payment">
                    <label>➖ Payment Received (Reduces Debt)</label>
                    <input type="number" name="payment" placeholder="Amount (₹)" class="inp" style="margin-bottom:0;">
                </div>
                <button type="submit" class="btn-full">Save Transaction</button>
            </form>
        </div>
    </div>

    <!-- REMINDER/DATE -->
    <div id="actionModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeActionModal()">✕</button>
            <div class="modal-title">📅 Set Action Date</div>
            <div id="modalCompanyName" style="font-weight:700;color:var(--primary);margin-bottom:18px;font-size:14px;"></div>
            <form id="updateDateForm" method="POST">
                <label class="inp-label">Next Reminder Date</label>
                <input type="date" name="nextDate" required class="inp">
                <button type="submit" class="btn-full">Save Date</button>
            </form>
        </div>
    </div>

    <!-- EDIT PARTY -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeEditModal()">✕</button>
            <div class="modal-title">✏️ Edit Party</div>
            <form id="editForm" method="POST">
                <label class="inp-label">Party Name</label>
                <input type="text" name="companyName" id="editCompany" class="inp">
                <label class="inp-label">Contact Person</label>
                <input type="text" name="contactPerson" id="editContact" class="inp">
                <label class="inp-label">Email</label>
                <input type="email" name="email" id="editEmail" class="inp">
                <div class="inp-row">
                    <div><label class="inp-label">Phone</label><input type="text" name="phone" id="editPhone" required class="inp"></div>
                    <div><label class="inp-label">WhatsApp</label><input type="text" name="whatsappNumber" id="editWhatsapp" required class="inp"></div>
                </div>
                <label class="inp-label">Other Numbers</label>
                <input type="text" name="otherNumbers" id="editOther" class="inp">
                <div class="section-divider"></div>
                <div class="inp-row">
                    <div><label class="inp-label" style="color:var(--danger);">Total Bill (₹)</label><input type="number" name="totalAmount" id="editTotal" required class="inp"></div>
                    <div><label class="inp-label" style="color:var(--success);">Total Paid (₹)</label><input type="number" name="paidAmount" id="editPaid" required class="inp"></div>
                </div>
                <button type="submit" class="btn-full">Save Changes</button>
            </form>
        </div>
    </div>

    <!-- SETTINGS MODAL -->
    <div id="settingsModal" class="modal">
        <div class="modal-content wide">
            <button class="modal-close" onclick="closeSettingsModal()">✕</button>
            <div class="modal-title">⚙️ Settings</div>
            <div class="modal-sub">Manage your account, security, backups, and preferences</div>

            <div class="settings-tabs">
                <div class="stab active" onclick="switchTab('profile')">🏢 Profile</div>
                <div class="stab" onclick="switchTab('security')">🔒 Security</div>
                <div class="stab" onclick="switchTab('backup')">💾 Backup</div>
                <div class="stab" onclick="switchTab('appearance')">🎨 Display</div>
                <div class="stab" onclick="switchTab('license')">📋 License</div>
            </div>

            <!-- PROFILE TAB -->
            <div class="stab-panel active" id="tab-profile">
                <form action="/settings?_method=PUT" method="POST">
                    <label class="inp-label">Company Name</label>
                    <input type="text" name="companyName" value="<%= adminUser.companyName||'' %>" class="inp">
                    <label class="inp-label">Address Line 1</label>
                    <input type="text" name="addressLine1" value="<%= adminUser.addressLine1||'' %>" class="inp">
                    <label class="inp-label">Address Line 2</label>
                    <input type="text" name="addressLine2" value="<%= adminUser.addressLine2||'' %>" class="inp">
                    <label class="inp-label">Address Line 3</label>
                    <input type="text" name="addressLine3" value="<%= adminUser.addressLine3||'' %>" class="inp">
                    <div class="inp-row">
                        <div><label class="inp-label">DL No.</label><input type="text" name="dlNo" value="<%= adminUser.dlNo||'' %>" class="inp"></div>
                        <div><label class="inp-label">MSME No.</label><input type="text" name="msmeNo" value="<%= adminUser.msmeNo||'' %>" class="inp"></div>
                    </div>
                    <div class="inp-row">
                        <div><label class="inp-label">Contact No.</label><input type="text" name="contactNo" value="<%= adminUser.contactNo||'' %>" class="inp"></div>
                        <div><label class="inp-label">Email</label><input type="email" name="companyEmail" value="<%= adminUser.companyEmail||'' %>" class="inp"></div>
                    </div>
                    <div style="background:var(--surface2);border-radius:var(--radius-xs);padding:16px;margin-top:12px;border:1px solid var(--border);">
                        <div style="font-size:12px;font-weight:800;color:var(--primary);margin-bottom:10px;">🏦 Bank & UPI Details</div>
                        <label class="inp-label">Bank Name</label>
                        <input type="text" name="bankName" value="<%= adminUser.bankName||'' %>" class="inp">
                        <label class="inp-label">Account Name</label>
                        <input type="text" name="accountName" value="<%= adminUser.accountName||'' %>" class="inp">
                        <div class="inp-row">
                            <div><label class="inp-label">Account No.</label><input type="text" name="accountNumber" value="<%= adminUser.accountNumber||'' %>" class="inp"></div>
                            <div><label class="inp-label">IFSC</label><input type="text" name="ifscCode" value="<%= adminUser.ifscCode||'' %>" class="inp"></div>
                        </div>
                        <label class="inp-label">UPI ID / Number</label>
                        <input type="text" name="upiDetails" value="<%= adminUser.upiDetails||'' %>" class="inp" style="margin-bottom:0;">
                    </div>
                    <button type="submit" class="btn-full">💾 Save Profile & Bank Info</button>
                </form>
            </div>

            <!-- SECURITY TAB -->
            <div class="stab-panel" id="tab-security">
                <div class="setting-row">
                    <div class="setting-info"><h4>Session Timeout</h4><p>Auto logout after inactivity</p></div>
                    <select class="filter-select" style="width:auto;" id="sessionTimeout">
                        <option value="30">30 min</option>
                        <option value="60">1 hour</option>
                        <option value="120">2 hours</option>
                        <option value="0">Never</option>
                    </select>
                </div>
                <div class="setting-row">
                    <div class="setting-info"><h4>Login Notifications</h4><p>Get activity alerts on login</p></div>
                    <button class="toggle-switch" id="loginNotifToggle" onclick="toggleSetting('loginNotifToggle')"></button>
                </div>
                <div class="setting-row">
                    <div class="setting-info"><h4>Staff Permission Level</h4><p>What staff can do</p></div>
                    <select class="filter-select" style="width:auto;">
                        <option>View & Edit</option>
                        <option>View Only</option>
                    </select>
                </div>
                <div class="section-divider"></div>
                <form action="/change-password" method="POST" id="changePwdForm">
                    <div style="font-size:13px;font-weight:800;margin-bottom:12px;color:var(--text);">🔑 Change Admin Password</div>
                    <label class="inp-label">Current Password</label>
                    <input type="password" name="currentPassword" class="inp" required>
                    <label class="inp-label">New Password</label>
                    <input type="password" name="newPassword" class="inp" required minlength="6">
                    <label class="inp-label">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="inp" required>
                    <button type="submit" class="btn-full">🔐 Change Password</button>
                </form>
                <div id="pwdMsg" style="margin-top:10px;font-size:13px;font-weight:600;display:none;"></div>
            </div>

            <!-- BACKUP TAB -->
            <div class="stab-panel" id="tab-backup">
                <div class="backup-info">
                    <div class="dot" id="backupDot"></div>
                    <div>
                        <strong>Last Backup:</strong> <span id="lastBackupTime">Never</span><br>
                        <span style="font-size:11px;">Backups include all parties, staff, activity logs & company profile</span>
                    </div>
                </div>

                <button class="backup-btn" onclick="triggerBackup()">
                    📦 Download Full Backup (JSON)
                </button>
                <button class="backup-btn" onclick="triggerBackupExcel()">
                    📊 Download Backup as Excel
                </button>

                <div class="section-divider"></div>
                <div style="font-size:12px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">Restore from Backup</div>

                <form action="/restore-backup" method="POST" enctype="multipart/form-data" onsubmit="return confirm('⚠️ This will REPLACE all current data with the backup file. Are you sure?');">
                    <div class="import-zone">
                        <input type="file" name="backupFile" accept=".json" required style="width:100%;font-size:13px;">
                        <div style="font-size:11px;color:var(--text-3);margin-top:6px;">Only .json backup files made by this app</div>
                    </div>
                    <button type="submit" class="backup-btn restore" style="margin-top:10px;">
                        ♻️ Restore Backup
                    </button>
                </form>

                <div class="section-divider"></div>
                <div style="font-size:12px;font-weight:700;color:var(--danger);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">⚠️ Danger Zone</div>
                <form action="/clear-all-data" method="POST" onsubmit="return confirm('☠️ FINAL WARNING: This will permanently delete ALL parties, activity logs. This cannot be undone. Continue?');">
                    <button type="submit" class="backup-btn danger">
                        🗑️ Clear All Party Data
                    </button>
                </form>
            </div>

            <!-- APPEARANCE TAB -->
            <div class="stab-panel" id="tab-appearance">
                <div class="setting-row">
                    <div class="setting-info"><h4>Dark Mode</h4><p>Switch to dark theme</p></div>
                    <button class="toggle-switch" id="darkModeToggle" onclick="toggleDarkMode()"></button>
                </div>
                <div class="setting-row">
                    <div class="setting-info"><h4>Compact View</h4><p>Tighter spacing in party list</p></div>
                    <button class="toggle-switch" id="compactToggle" onclick="toggleSetting('compactToggle')"></button>
                </div>
                <div class="setting-row">
                    <div class="setting-info"><h4>Currency Symbol</h4><p>Display preference</p></div>
                    <select class="filter-select" style="width:auto;" id="currencyPref">
                        <option value="₹">₹ (INR)</option>
                        <option value="$">$ (USD)</option>
                        <option value="AED">AED</option>
                    </select>
                </div>
                <div class="setting-row">
                    <div class="setting-info"><h4>Date Format</h4><p>How dates are displayed</p></div>
                    <select class="filter-select" style="width:auto;">
                        <option>DD/MM/YYYY</option>
                        <option>MM/DD/YYYY</option>
                        <option>DD-Mon-YYYY</option>
                    </select>
                </div>
                <div style="margin-top:16px;">
                    <button class="btn-full success-btn" type="button" onclick="savePreferences()">Save Display Preferences</button>
                </div>
            </div>

