// ===== BULK SELECT =====
var checkboxes = document.querySelectorAll('.customer-checkbox');
var bulkBar = document.getElementById('bulkActionBar');
var countText = document.getElementById('selectedCount');
var hiddenInputs = document.getElementById('hiddenInputs');

function updateBulkBar() {
    var count = 0;
    checkboxes.forEach(function(cb){ if(cb.checked) count++; });
    if (count > 0) { bulkBar.classList.add('visible'); countText.innerText = count + ' Selected'; }
    else bulkBar.classList.remove('visible');
}

var headerCb = document.getElementById('selectAll');
if (headerCb) headerCb.addEventListener('change', function(){
    document.querySelectorAll('tbody tr:not([style*="display: none"]) .customer-checkbox').forEach(function(cb){ cb.checked = headerCb.checked; });
    updateBulkBar();
});
checkboxes.forEach(function(cb){ cb.addEventListener('change', updateBulkBar); });

var _selectAllState = false;
function toggleSelectAll() {
    _selectAllState = !_selectAllState;
    document.querySelectorAll('tbody tr:not(.d-none) .customer-checkbox').forEach(function(cb){ cb.checked = _selectAllState; });
    var btn = document.getElementById('selectAllBtn');
    if (btn) btn.innerText = _selectAllState ? '☐ Deselect' : '☑️ Select';
    if (headerCb) headerCb.checked = _selectAllState;
    updateBulkBar();
}

function confirmBulkDelete() {
    var selected = [];
    checkboxes.forEach(function(cb){ if(cb.checked) selected.push(cb.value); });
    if (selected.length === 0) return;
    if (!confirm('⚠️ Delete ' + selected.length + ' parties permanently? This cannot be undone.')) return;

    // Use fetch + JSON to avoid form parameterLimit issues with large selections
    var btn = document.querySelector('.bulk-delete-btn');
    if (btn) { btn.textContent = '⏳ Deleting...'; btn.disabled = true; }

    fetch('/customers/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', customerIds: selected })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.success) {
            window.location.reload();
        } else {
            alert('Delete failed: ' + (d.error || 'Unknown error'));
            if (btn) { btn.textContent = '🗑️ Delete All'; btn.disabled = false; }
        }
    })
    .catch(function(err) {
        alert('Network error during delete. Please try again.');
        if (btn) { btn.textContent = '🗑️ Delete All'; btn.disabled = false; }
    });
}

// ===== MOBILE LAUNCHER =====
var homeLauncher = document.getElementById('homeLauncher');
var mainDashboard = document.getElementById('mainDashboard');
var backBtn = document.getElementById('backToLauncher');
var viewDashboard = document.getElementById('viewDashboard');
var viewParties = document.getElementById('viewParties');
var isMobile = window.innerWidth < 769;

function showSection(section) {
    if (!isMobile) {
        if (viewDashboard) viewDashboard.style.display='';
        if (viewParties) viewParties.style.display='';
        if (mainDashboard) mainDashboard.style.display='block';
        return;
    }
    if (homeLauncher) homeLauncher.style.display='none';
    if (mainDashboard) mainDashboard.style.display='block';
    if (backBtn) { backBtn.style.display='flex'; backBtn.textContent = section==='dashboard' ? '← Home | 📊 Dashboard' : '← Home | 🏢 Parties'; }
    if (viewDashboard) viewDashboard.style.display = section==='dashboard' ? 'block' : 'none';
    if (viewParties) viewParties.style.display = section==='parties' ? 'block' : 'none';
}

function showLauncher() {
    if (!isMobile) return;
    if (homeLauncher) homeLauncher.style.display='block';
    if (mainDashboard) mainDashboard.style.display='none';
    if (backBtn) backBtn.style.display='none';
}

// ===== INIT =====
(function(){
    var params = new URLSearchParams(window.location.search);
    var isDup = params.get('dup') === '1';
    var dupName = params.get('dupname') || '';
    var userRole = '<%= role %>';

    if (userRole !== 'customer') {
        if (isMobile && !isDup) {
            showLauncher();
        } else {
            if (viewDashboard) viewDashboard.style.display='block';
            if (viewParties) viewParties.style.display='block';
            if (mainDashboard) mainDashboard.style.display='block';
        }
    }

    if (isDup) {
        var warn = document.getElementById('dupWarning');
        var warnText = document.getElementById('dupWarningText');
        if (warn) {
            warnText.innerText = 'Duplicate Blocked: Party "' + decodeURIComponent(dupName) + '" already exists.';
            warn.style.display = 'flex';
        }
        if (window.history.replaceState) window.history.replaceState({}, document.title, '/');
    }
})();

// ===== PDF EXPORT =====
function downloadPDF() {
    var el = document.createElement('div');
    var d = new Date().toLocaleDateString('en-IN');
    el.innerHTML = '<h1 style="text-align:center;color:#0f172a;">Financial Report — ' + d + '</h1>' +
        (document.querySelector('.card') ? document.querySelector('.card').outerHTML : '') +
        (document.querySelector('table') ? document.querySelector('table').outerHTML : '');
    el.querySelectorAll('.btn-table, .m-tools, form, .m-circles, .msg-btns, input[type="checkbox"]').forEach(function(n){ n.style.display='none'; });
    html2pdf().set({margin:0.5, filename:'WGS_Report_'+d+'.pdf', html2canvas:{scale:2}, jsPDF:{unit:'in',format:'letter',orientation:'landscape'}}).from(el).save();
}

// ===== REAL-TIME DUPLICATE CHECK =====
var _dupTimer = null;
function checkDuplicate() {
    var nameVal = (document.getElementById('addCompanyName')||{value:''}).value.trim();
    var phoneVal = (document.getElementById('addLocalPhone')||{value:''}).value.trim();
    if (!nameVal && !phoneVal) { document.getElementById('addDupAlert').classList.remove('show'); return; }
    clearTimeout(_dupTimer);
    _dupTimer = setTimeout(function(){
        fetch('/customers/check-duplicate?name='+encodeURIComponent(nameVal)+'&phone='+encodeURIComponent(phoneVal))
            .then(function(r){ return r.json(); })
            .then(function(d){
                var a = document.getElementById('addDupAlert');
                var m = document.getElementById('addDupMsg');
                if (d.isDuplicate) { m.innerText = 'Party with this '+(d.matchReason==='name'?'name':'phone')+' exists: "'+d.matchedName+'"'; a.classList.add('show'); }
                else a.classList.remove('show');
            }).catch(function(){});
    }, 500);
}
var ani = document.getElementById('addCompanyName');
var api = document.getElementById('addLocalPhone');
if (ani) ani.addEventListener('input', checkDuplicate);
if (api) api.addEventListener('input', checkDuplicate);
</script>
