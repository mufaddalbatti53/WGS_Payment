<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
// ===== DARK MODE =====
(function(){
    var dark = localStorage.getItem('wgs-dark') === '1';
    if (dark) { document.body.classList.add('dark'); }
})();

function toggleDarkMode() {
    document.body.classList.toggle('dark');
    var isDark = document.body.classList.contains('dark');
    localStorage.setItem('wgs-dark', isDark ? '1' : '0');
    var btn = document.getElementById('darkModeToggle');
    if (btn) btn.classList.toggle('on', isDark);
}

function toggleSetting(id) {
    var el = document.getElementById(id);
    if (el) el.classList.toggle('on');
}

function savePreferences() {
    alert('Display preferences saved!');
}

// ===== SETTINGS MODAL =====
function openSettingsModal() {
    window.history.pushState({modal:true}, '', '#settings');
    document.getElementById('settingsModal').style.display = 'block';
    // Sync dark mode toggle
    var dark = document.body.classList.contains('dark');
    var dm = document.getElementById('darkModeToggle');
    if (dm) dm.classList.toggle('on', dark);
    // Load backup info
    loadBackupInfo();
}
function closeSettingsModal() {
    if (window.location.hash) window.history.back(); else closeAllModals();
}

function switchTab(tab) {
    document.querySelectorAll('.stab').forEach(function(t){ t.classList.remove('active'); });
    document.querySelectorAll('.stab-panel').forEach(function(p){ p.classList.remove('active'); });
    var panels = ['profile','security','backup','appearance','license'];
    var idx = panels.indexOf(tab);
    document.querySelectorAll('.stab')[idx].classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
}

// ===== BACKUP & RESTORE =====
function loadBackupInfo() {
    var ts = localStorage.getItem('wgs-last-backup');
    var dot = document.getElementById('backupDot');
    var lbt = document.getElementById('lastBackupTime');
    if (ts) {
        var d = new Date(parseInt(ts));
        if (lbt) lbt.textContent = d.toLocaleString('en-IN');
        if (dot) dot.classList.remove('none');
    } else {
        if (lbt) lbt.textContent = 'Never';
        if (dot) dot.classList.add('none');
    }
}

function triggerBackup() {
    var btn = event.target;
    btn.textContent = '⏳ Preparing backup...';
    btn.disabled = true;
    fetch('/backup-data')
        .then(function(r){ return r.json(); })
        .then(function(data) {
            var blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'WGS_Backup_' + new Date().toISOString().slice(0,10) + '.json';
            a.click();
            URL.revokeObjectURL(url);
            localStorage.setItem('wgs-last-backup', Date.now().toString());
            loadBackupInfo();
            btn.textContent = '✅ Backup Downloaded!';
            setTimeout(function(){ btn.textContent = '📦 Download Full Backup (JSON)'; btn.disabled = false; }, 2500);
        })
        .catch(function(e){
            alert('Backup failed. Please try again.');
            btn.textContent = '📦 Download Full Backup (JSON)';
            btn.disabled = false;
        });
}

function triggerBackupExcel() {
    window.location.href = '/backup-data-excel';
}

// ===== PASSWORD CHANGE =====
document.addEventListener('DOMContentLoaded', function() {
    var pwdForm = document.getElementById('changePwdForm');
    if (pwdForm) {
        pwdForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(this);
            var newPwd = formData.get('newPassword');
            var confirmPwd = formData.get('confirmPassword');
            var msg = document.getElementById('pwdMsg');
            if (newPwd !== confirmPwd) {
                msg.textContent = '❌ Passwords do not match!';
                msg.style.color = 'var(--danger)';
                msg.style.display = 'block';
                return;
            }
            fetch('/change-password', {
                method:'POST',
                headers:{'Content-Type':'application/x-www-form-urlencoded'},
                body: new URLSearchParams({
                    currentPassword: formData.get('currentPassword'),
                    newPassword: newPwd
                })
            }).then(function(r){ return r.json(); })
            .then(function(d){
                msg.style.display = 'block';
                if (d.success) {
                    msg.textContent = '✅ Password changed successfully!';
                    msg.style.color = 'var(--success)';
                    pwdForm.reset();
                } else {
                    msg.textContent = '❌ ' + (d.error || 'Failed');
                    msg.style.color = 'var(--danger)';
                }
            });
        });
    }
});

// ===== FILTER & SEARCH =====
var actionFilterActive = false;
var _activeBucketKey = null;

function toggleFilterPanel() {
    var p = document.getElementById('filterPanel');
    if (p) p.style.display = (p.style.display === 'none' || !p.style.display) ? 'block' : 'none';
}

function clearFilters() {
    document.getElementById('filterAging').value = 'all';
    document.getElementById('filterAmtType').value = 'due';
    document.getElementById('filterMin').value = '';
    document.getElementById('filterMax').value = '';
    document.getElementById('searchInput').value = '';
    clearAgingFilter();
}

function filterByBucket(bucketKey, label, count, amtStr) {
    showSection('parties');
    setTimeout(function(){ var h = document.getElementById('filterActiveHeader'); if (h) h.scrollIntoView({behavior:'smooth',block:'start'}); }, 60);
    document.querySelectorAll('.aging-clickable.active-bucket').forEach(function(r){ r.classList.remove('active-bucket'); });
    var map = {u30:0, d30_60:1, d60_90:2, d90_120:3, d120_150:4, d150_180:5, a180:6};
    var rows = document.querySelectorAll('.aging-clickable');
    if (map[bucketKey] !== undefined && rows[map[bucketKey]]) rows[map[bucketKey]].classList.add('active-bucket');
    _activeBucketKey = bucketKey;
    var fa = document.getElementById('filterAging');
    if (fa) fa.value = bucketKey;
    var hdr = document.getElementById('filterActiveHeader');
    var hdrTxt = document.getElementById('filterActiveText');
    if (hdr && hdrTxt) {
        hdrTxt.innerHTML = '📅 ' + label + ' &nbsp;|&nbsp; <strong>' + count + ' parties</strong> &nbsp;|&nbsp; ' + amtStr;
        hdr.classList.add('show');
    }
    runAllFilters('standard');
}

function clearAgingFilter() {
    _activeBucketKey = null;
    document.querySelectorAll('.aging-clickable.active-bucket').forEach(function(r){ r.classList.remove('active-bucket'); });
    var fa = document.getElementById('filterAging');
    if (fa) fa.value = 'all';
    var hdr = document.getElementById('filterActiveHeader');
    if (hdr) hdr.classList.remove('show');
    runAllFilters('standard');
}

function runAllFilters(source) {
    var searchText = (document.getElementById('searchInput')||{value:''}).value.toLowerCase().trim();
    var agingVal = (document.getElementById('filterAging')||{value:'all'}).value;
    var amtType = (document.getElementById('filterAmtType')||{value:'due'}).value;
    var minAmt = parseFloat((document.getElementById('filterMin')||{value:''}).value) || 0;
    var maxAmt = parseFloat((document.getElementById('filterMax')||{value:''}).value) || Infinity;

    document.querySelectorAll('.customer-row').forEach(function(row) {
        var isVisible = true;
        if (searchText && row.textContent.toLowerCase().indexOf(searchText) === -1) isVisible = false;
        var rawDue = parseFloat(row.getAttribute('data-due')) || 0;
        var rawTotal = parseFloat(row.getAttribute('data-total')) || 0;
        var valToCheck = amtType === 'due' ? rawDue : rawTotal;
        if (valToCheck < minAmt || valToCheck > maxAmt) isVisible = false;
        if (agingVal !== 'all') {
            var bucketAmt = parseFloat(row.getAttribute('data-' + agingVal)) || 0;
            if (bucketAmt <= 0) isVisible = false;
            else {
                row.querySelectorAll('.dynamic-due').forEach(function(el){ el.innerText = 'Bucket ₹' + bucketAmt; });
                row.querySelectorAll('.dynamic-due-m').forEach(function(el){ el.innerText = 'Bucket ₹' + bucketAmt; });
            }
        } else {
            row.querySelectorAll('.dynamic-due').forEach(function(el){ el.innerText = 'Due ₹' + rawDue; });
            row.querySelectorAll('.dynamic-due-m').forEach(function(el){ el.innerText = 'Due ₹' + rawDue; });
        }
        if (actionFilterActive && row.getAttribute('data-action-req') !== 'true') isVisible = false;
        row.classList.toggle('d-none', !isVisible);
    });
}

var sb = document.getElementById('searchInput');
if (sb) sb.addEventListener('keyup', function(){ runAllFilters('search'); });

// ===== MESSAGING =====
function sendMsg(element, type) {
    var id=element.getAttribute('data-id'), phone=element.getAttribute('data-phone');
    var wa=element.getAttribute('data-wa'), email=element.getAttribute('data-email');
    var cname=decodeURIComponent(element.getAttribute('data-cname')||'');
    var pname=decodeURIComponent(element.getAttribute('data-pname')||'');
    var admin=decodeURIComponent(element.getAttribute('data-admin')||'');
    var total=element.getAttribute('data-total'), paidamount=element.getAttribute('data-paidamount');
    var lastpaid=decodeURIComponent(element.getAttribute('data-lastpaid')||'');
    var due=element.getAttribute('data-due'), diff=parseInt(element.getAttribute('data-diff')||'0');
    var bName=decodeURIComponent("<%- encodeURIComponent(adminUser.bankName||'') %>");
    var aName=decodeURIComponent("<%- encodeURIComponent(adminUser.accountName||'') %>");
    var aNo=decodeURIComponent("<%- encodeURIComponent(adminUser.accountNumber||'') %>");
    var ifsc=decodeURIComponent("<%- encodeURIComponent(adminUser.ifscCode||'') %>");
    var upi=decodeURIComponent("<%- encodeURIComponent(adminUser.upiDetails||'') %>");
    var cStr = cname + (pname ? ' (' + pname + ')' : '');
    var m = ['Hello, this is ' + admin + '.', '', 'Gentle payment reminder for ' + cStr + '.', '', '*Account Summary:*',
        '- Total Bill: Rs ' + total, '- Paid: Rs ' + paidamount + (lastpaid ? ' (Last: ' + lastpaid + ')' : ''),
        '- Outstanding: *Rs ' + due + '*', ''];
    if (diff>0) m.push('_' + diff + ' days past action date._', '');
    m.push('Please arrange payment at earliest convenience.', '');
    if (bName||aNo||upi) { m.push('*Payment Details:*'); if(bName)m.push('Bank: '+bName); if(aName)m.push('Name: '+aName); if(aNo)m.push('A/C: '+aNo); if(ifsc)m.push('IFSC: '+ifsc); if(upi)m.push('UPI: '+upi); m.push(''); }
    m.push('Thank you,', admin);
    var encoded = encodeURIComponent(m.join('\n'));
    if (type==='wa') window.open('https://wa.me/'+wa+'?text='+encoded, '_blank');
    if (type==='sms') window.open('sms:+'+phone+'?body='+encoded, '_self');
    if (type==='email') window.open('mailto:'+email+'?subject=Payment Reminder&body='+encoded, '_self');
    var row = element.closest('tr');
    if (row) { row.querySelectorAll('.msg-btns, .m-circles').forEach(function(el){ el.style.display='none'; }); row.querySelectorAll('.action-req').forEach(function(el){ el.style.display='none'; }); }
    fetch('/customers/' + id + '/auto-snooze', {method:'POST'}).catch(function(){});
}

